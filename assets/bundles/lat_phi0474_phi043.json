kind":"entity"},{"term":"Epicurei derident","score":0.3,"count":1,"kind":"orig"},{"term":"Epicurejci","score":0.3,"count":1,"kind":"word"},{"term":"Gangen","score":0.3,"count":1,"kind":"orig"},{"term":"Ganges","score":0.3,"count":1,"kind":"entity"},{"term":"Gracchi","score":0.3,"count":1,"kind":"entity"},{"term":"rozum","score":0.3,"count":2,"kind":"word"},{"term":"spravedlnost","score":0.3,"count":2,"kind":"word"}]},"c0009":{"terms":[{"term":"Fanni","score":1.0,"count":1,"kind":"orig"},{"term":"Herculi","score":1.0,"count":1,"kind":"entity"},{"term":"causa difficilis laudare puerum","score":1.0,"count":1,"kind":"orig"},{"term":"cogeret","score":1.0,"count":1,"kind":"orig"},{"term":"ctnost","score":1.0,"count":1,"kind":"word"},{"term":"důstojnost","score":1.0,"count":1,"kind":"word"},{"term":"epulis et conviviis","score":1.0,"count":1,"kind":"orig"},{"term":"hostina","score":1.0,"count":1,"kind":"word"},{"term":"hostiny","score":1.0,"count":1,"kind":"word"},{"term":"kritika povrchnosti","score":1.0,"count":1,"kind":"word"},{"term":"leniter atque placide fides","score":1.0,"count":1,"kind":"orig"},{"term":"morální povinnost","score":1.0,"count":1,"kind":"word"},{"term":"povrchní uznání","score":1.0,"count":1,"kind":"word"},{"term":"pravá čest","score":1.0,"count":1,"kind":"word"},{"term":"přirozená povinnost","score":1.0,"count":1,"kind":"word"},{"term":"verum decus","score":1.0,"count":1,"kind":"orig"},{"term":"vnitřní hodnota","score":1.0,"count":1,"kind":"word"},{"term":"Africane","score":0.81,"count":1,"kind":"orig"},{"term":"natura","score":0.69,"count":1,"kind":"orig"},{"term":"příroda","score":0.6,"count":1,"kind":"word"}]}}},"summaries":{"c0001":{"cs":"V knize první Ciceronova díla O státě autor argumentuje, že pravá ctnost musí být nejen známa, ale i prakticky uplatňována ve prospěch obce, neboť lidé jsou od přírody vybaveni skloností bránit společné dobro, která převládá nad rozkoší a pohodlím. Dále kritizuje, že pouhé mluvení o ctnosti bez činu je nedostatečné, a zdůrazňuje, že zákony a mravy státu jsou základem spravedlnosti a občanské povinnosti."},"c0002":{"cs":"V fragmentu první knihy O státě Cicero argumentuje, že vlast je starší a významnější než biologický rodič, proto jí náleží větší vděčnost. Kritizuje Kartágo za nedostatek moudrosti a disciplíny navzdory jejímu bohatství a zdůrazňuje, že pravá ctnost a vědění pocházejí ze znalosti starých zvyků a rétoriky, nikoli jen z teoretických disputací bez skutkového základu."},"c0003":{"cs":"Scipio popisuje Romula jako moudrého zakladatele Říma, který po svém vychování pastevci a prokázání síly získal důvěru sousedů, dobyl Longu Albou a zabil krále Amulia. Poté, inspirován úspěchem, začal uvažovat o trvalé republice a pečlivě vybíral místo pro město – odmítl pobřežní lokality kvůli zranitelnosti před námořními útoky a morálnímu úpadku. Vybral pahorky mezi Esquilínem a Quirinalem, opevnil město příkopem a valy, zajistil zdroj vody a zdravé prostředí, založil Řím, pojmenoval jej po sobě a podnikl kroky k jeho posílení, včetně násilného příchodu sabinských žen, což vedlo ke konfliktu se Sabiny a následnému mírovému ujednání s jejich králem T. Tatiem. Po válce uzavřel mír prostřednictvím unesených sabinských žen, které prosily o smír, a po smrti Tatia konsolidoval moc pomocí rady "},"c0004":{"cs":"Cicero v třetí knize O státě zkoumá, zda je lepší následovat moudrost (sapientia) vedoucí k bohatství a moci, nebo spravedlnost (iustitia) přikazující ctít cizí věci a jednat pro dobro lidského rodu. Zdůrazňuje, že skutečná republika není jen většinová vláda ani tyranie, ale musí být založena na spravedlnosti, právu a mravní autoritě, kde právo je věčné a neměnné, a kde ctnost je motivována vnitřní dobrotou, nikoli strachem z trestu."},"c0005":{"cs":"Fragment pojednává o vnitřní nestabilitě lidské povahy, která se projevuje buď nadměrnou radostí, nebo bolestí, a o nejistotě jednání v rizikových situacích. Dále kritizuje Féniky za zavedení chamtivosti, přepychu a nekonečných tužeb do Řecka a srovnává Sardanapalla s jeho pověstí jako zkorumpovaného vládce, jehož skutečná zkaženost převyšuje jeho jméno."},"c0006":{"cs":"Cicero zdůrazňuje rozum jako nadřazený tělu, duši jako schopnou předvídat a pamatovat, a stát jako organizmus, jehož zdraví závisí na správné výchově, zákonech a mravní disciplíně, zejména prostřednictvím pudornosti a skromnosti, kritizuje řecké praktiky jako morálně zkažené a chválí římský řád inspirovaný Platónem a Lycurgem jako ideál společného dobra a ctnosti."},"c0007":{"cs":"Cicero zdůrazňuje, že římská republika mohla existovat jen díky starým mravům a význačným mužům, kteří je udržovali, zatímco současná generace tyto tradice zanedbává a vede k úpadku státu. Ideální uspořádání je inspirováno Numovou érou spravedlnosti a státní kontroly nad půdou, kde soudní moc patří králům a soukromí nezasahují do veřejných věcí."},"c0008":{"cs":"V knize 6 Cicerova O státě se Scipion Afričan zjevuje ve snu a předává vizi nebeské sféry, kde duše spravedlivých přebývají věčně. Rozvádí kosmologii sedmi planet a nebeské harmonie, zdůrazňuje nesmrtelnost duše jako sebe-pohybujícího principu a odmítá pozemskou slávu jako pomíjivou. Pravá ctnost vede duši k návratu k božskému ohni, zatímco pozemské touhy ji uvězňují v koloběhu smrti."},"c0009":{"cs":"Fragmenty z Ciceronova díla O státě se zabývají přirozenou povinností člověka jednat podle přírody a ctnosti, kritizují povrchní uznání získané prostřednictvím hostin a výstavy, a zdůrazňují, že pravá čest vychází z vnitřní ctnosti a důstojnosti, nikoli z vnějšího lesku nebo společenské prezentace."}}}