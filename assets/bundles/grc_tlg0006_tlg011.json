erm":"zármutek","score":0.3,"count":1,"kind":"word"},{"term":"řecký tábor","score":0.3,"count":1,"kind":"word"},{"term":"ΌΣ","score":0.3,"count":1,"kind":"orig"},{"term":"Κρόνιε","score":0.3,"count":1,"kind":"orig"},{"term":"Πρίαμε","score":0.3,"count":1,"kind":"orig"},{"term":"Πριάμος","score":0.3,"count":1,"kind":"entity"},{"term":"Πριάμου","score":0.3,"count":1,"kind":"orig"},{"term":"Τρώων","score":0.3,"count":1,"kind":"orig"},{"term":"Φρυγίων","score":0.3,"count":1,"kind":"orig"}]}}},"summaries":{"c0001":{"cs":"Poseidon přichází z Egejského moře a líčí zničení Tróje: božskou roli při stavbě opevnění, lstivý řecký kůň, plenění města, osud obyvatel (včetně smrti Polyxeny, osudu Kassandry a zajetí Heleny), oplakávání Hekuby a božské opuštění zničeného města. Následuje dialog s Athénou o pomstě Řekům."},"c0002":{"cs":"Chór trojských žen, vedený Hekabou, lamentuje nad zánikem Tróje, ztrátou vlasti, dětí a manželů, popisuje fyzickou a duševní bolest způsobenou osudem a božskou nevěstí, zatímco předpovídá svůj odchod do otroctví u řeckých vítězů."},"c0003":{"cs":"Talthybios přináší zprávy o osudu trojských žen po pádu Tróje: Kassandra se stala manželkou Agamemnona, Polyxena je určena k oběti na Achillově hrobě, Andromacha připadla Neoptolemovi, ostatní ženy byly rozděleny mezi řecké vítězné vůdce jako otrokyně. Hekaba zoufale reaguje na ztrátu svobody a rodiny."},"c0004":{"cs":"Chór nejprve vzývá Múzu, aby zazpívala lament nad padlou Trójou, popisuje odchod řeckých válečníků po vítězství a vzpomíná na dřívější radostné obřady v městě. Následně líčí válečný chaos, míchání řeckých a frýgijských prvků, ženský zármutek a pohřební rituály, přičemž zdůrazňuje střídání radosti a zármutku, božskou přítomnost a ztrátu města. Nakonec se zaměřuje na ženské rituály kolem péče o oděvy a zbroj, zatímco Ares vstupuje do boje a Palladinina díla jsou zničena, což vede k smutku frýgijského lidu a ztrátě jejich mládí."},"c0005":{"cs":"V epizodě 5 Trójank se Hekuba a Andromacha setkávají v hlubokém zármutku nad ztrátou svých mužů, dětí a domova po pádu Tróje. Jejich dialog je plný lamentací nad smrtí Hektora, Astyanaka a dalších příbuzných, zatímco sbor reflektuje nad smyslem pláče a božskou svévolí. Zaznívají témata ztráty, mateřské bolesti, pomsty a marné naděje na návrat."},"c0006":{"cs":"Chorální zpěv nejprve vzdává hold řeckému hrdinovi Telamónovi, který pomohl dobýt Tróji, poté lamentuje nad zničením města a osudem jeho obyvatel, včetně Priama a jeho rodiny, a nakonec vzývá boha lásky Érose jako zdroj naděje a božské přízně pro Trójanů i přes jejich porážku."},"c0007":{"cs":"Menelaos, vítěz řeckých vojsk po pádu Tróje, žádá trest smrti pro Helenu, kterou považuje za viníka války kvůli jejímu útěku s Paridem. Helena se brání, tvrdí, že její krása byla předmětem božského soudu mezi Athénou, Hérou a Afroditou, a že Afrodita jí slíbila Parida, což vedlo k jejímu činu. Odmítá nést plnou vinu, jelikož jednala pod vlivem bohů. Hekuba a sbor komentují její osud a moralitu jejího jednání."},"c0008":{"cs":"Chór vyjadřuje hluboký zármutek nad zbořením Tróje, zejména nad osudem trojských žen, které jsou odváděny do řeckého otroctví. Zeus a ostatní bohové jsou obviňováni z nečinnosti či spoluviny na této katastrofě. Text kombinuje náboženské vzývání s osobním zoufalstvím a odkazuje na ztrátu domova, česti a rodinných svazků."},"c0009":{"cs":"Hekuba, matka padlého trojského hrdiny Hektora, lamentuje nad jeho mrtvolou, kterou Řekové odmítají pohřbít ze strachu, i když Troja již padla. Vyjadřuje bolest nad marností jeho smrti, vzpomíná na jeho život a kritizuje řeckou vítězství jako hanebné a bez spravedlnosti."}}}