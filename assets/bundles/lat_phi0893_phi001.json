":"Caesar","score":0.42,"count":3,"kind":"entity"},{"term":"Iuppiter","score":0.42,"count":3,"kind":"entity"},{"term":"přátelství","score":0.42,"count":3,"kind":"word"},{"term":"příroda","score":0.42,"count":3,"kind":"word"},{"term":"smrt","score":0.42,"count":3,"kind":"word"},{"term":"Apollón","score":0.4,"count":2,"kind":"entity"},{"term":"Carthago","score":0.4,"count":2,"kind":"entity"},{"term":"Daidalos","score":0.4,"count":2,"kind":"entity"},{"term":"Horatius","score":0.4,"count":2,"kind":"entity"},{"term":"Phoebe","score":0.4,"count":2,"kind":"orig"},{"term":"Phoebus","score":0.4,"count":2,"kind":"entity"},{"term":"mládí","score":0.4,"count":2,"kind":"word"},{"term":"poezie","score":0.4,"count":2,"kind":"word"},{"term":"Hannibal","score":0.33,"count":2,"kind":"entity"},{"term":"Veneris","score":0.33,"count":2,"kind":"entity"},{"term":"mytologie","score":0.33,"count":2,"kind":"word"},{"term":"oběť","score":0.33,"count":2,"kind":"word"},{"term":"spravedlnost","score":0.33,"count":2,"kind":"word"},{"term":"Tibur","score":0.3,"count":2,"kind":"entity"}]}}},"summaries":{"c0001":{"cs":"Óda začíná adresou patronovi Maecenasovi, kontrastuje venkovský život se slávou válečníků a obchodníků, poté vyjadřuje touhu básníka po věčné slávě prostřednictvím lyriky a spojení s múzami, zejména když je zařazen mezi lyriky, kdy slibuje, že zasáhne hvězdy svým vrcholným hlasem."},"c0002":{"cs":"Horace v knize 2 svých Ód kombinuje válečné motivy (triumfy Metella, Pollia, války s Jugurtou) s mytologickými obrazy (Juno, Fortuna, múzy) a filozofickými úvahami o osudu, smrti a pomíjivosti lidské slávy. Zdůrazňuje potřebu vyrovnanosti mysli v štěstí i neštěstí, kritizuje chamtivost a marnost lidských snah uniknout osudu, zatímco vyzývá k umírněnosti, věrnosti v přátelství a úctě k bohům a přírodě. Prostřednictvím kontrastů mezi bohatstvím a chudobou, mládím a stářím, válkou a klidem nastoluje ideum aurea mediocritas – zlaté střední cesty jako cesty k trvalému štěstí."},"c0003":{"cs":"Kniha 3 Horaciových Ód je bohatá na témata: kosmologie a bohové, hrdinský epos a válka, osud a prozřetelnost, smrt a nesmrtelnost, rituál a modlitba, etika a ctnost, spravedlnost a právo, politika a společnost, rodina, láska a přátelství, utrpení a osvobození, meditace, vědomí a duše, poznání a pravda, logika a metafyzika, příroda a řeč, výchova a majetek, tělo a lékařství, dějiny a proroctví, moudrost a aforismy, tragédie a komedie, cesty a národy. Text střídá veřejné a osobní reflexe, mytologické aluze, výzvy k ctnosti a kritiku morálního úpadku."},"c0004":{"cs":"Kniha 4 ód Horatia zahrnuje modlitby k Venuši o ukončení milostných trápení, ódy na božskou inspiraci básníka srovnávanou s Pindarem, oslavy císaře Augusta a jeho triumfu, reflexe nad pomíjivostí mládí a krásy, oraz oslavu básnické nesmrtelnosti prostřednictvím múz a božského daru, vše v kontextu římské náboženské, politické a kulturní obrody."}}}