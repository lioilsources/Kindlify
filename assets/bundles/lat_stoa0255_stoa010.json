score":0.3,"count":5,"kind":"orig"},{"term":"duševní klid","score":0.3,"count":4,"kind":"word"},{"term":"duševní zdraví","score":0.3,"count":3,"kind":"word"},{"term":"etika","score":0.3,"count":5,"kind":"word"},{"term":"filozofie","score":0.3,"count":3,"kind":"word"},{"term":"iniuria","score":0.3,"count":4,"kind":"orig"},{"term":"iniuriam","score":0.3,"count":3,"kind":"orig"},{"term":"iracundiam","score":0.3,"count":3,"kind":"orig"},{"term":"irascor","score":0.3,"count":3,"kind":"orig"},{"term":"irá","score":0.3,"count":4,"kind":"word"},{"term":"kontrola emocí","score":0.3,"count":3,"kind":"word"},{"term":"krutost","score":0.3,"count":5,"kind":"word"},{"term":"král","score":0.3,"count":3,"kind":"word"},{"term":"lidská slabost","score":0.3,"count":3,"kind":"word"},{"term":"moc","score":0.3,"count":3,"kind":"word"},{"term":"moralita","score":0.3,"count":4,"kind":"word"},{"term":"nepřiměřenost","score":0.3,"count":4,"kind":"word"},{"term":"nepřátelství","score":0.3,"count":3,"kind":"word"},{"term":"odolnost","score":0.3,"count":3,"kind":"word"},{"term":"pomsta","score":0.3,"count":4,"kind":"word"},{"term":"přátelství","score":0.3,"count":5,"kind":"word"},{"term":"regem","score":0.3,"count":5,"kind":"orig"},{"term":"rozum","score":0.3,"count":4,"kind":"word"},{"term":"smrt","score":0.3,"count":4,"kind":"word"},{"term":"spravedlnost","score":0.3,"count":7,"kind":"word"},{"term":"tempus","score":0.3,"count":4,"kind":"orig"},{"term":"trest","score":0.3,"count":4,"kind":"word"},{"term":"trpělivost","score":0.3,"count":5,"kind":"word"},{"term":"vláda","score":0.3,"count":8,"kind":"word"},{"term":"vzdělanost","score":0.3,"count":3,"kind":"word"},{"term":"vztahy","score":0.3,"count":3,"kind":"word"},{"term":"vědomí","score":0.3,"count":3,"kind":"word"},{"term":"zloba","score":0.3,"count":4,"kind":"word"},{"term":"útlak","score":0.3,"count":6,"kind":"word"}]}}},"summaries":{"root":{"cs":"De Ira je filozofická práce Luciuse Annaea Senecy, která se zabývá povahou a důsledky hněvu jako emoce proti přírodě a rozumu. Dílo má tři knihy: první kritizuje hněv jako zdroj násilí, ztráty rozumu a ničení společnosti; druhá rozlišuje mezi pohnutím duše a vůlí k hněvu, zdůrazňuje, že moudrý člověk se nerozčiluje; třetí analyzuje hněv jako šířící se sílu, která ničí řád a navrhuje metody jeho překonání. Knihovna má překlad do češtiny."},"c0001":{"cs":"Kniha I De Ira od Senecy se zabývá hlubokou analýzou hněvu jako duševní poruchy, která způsobuje ztrátu rozumu, násilí a morální rozpad. Autor popisuje fyzické projevy hněvu – zčervenání očí, třes rukou, zatínání zubů, zvýšený dech – a srovnává je s agresivním chováním zvířat, aby ukázal, že hněv je nezakrývatelný a výrazně viditelný. Hněv je kritizován jako ničivá síla, která způsobila války, vraždy, zničení měst a občanské konflikty. Seneca argumentuje, že hněv není přirozený ani užitečný, protože nevyžaduje rozum, ale spíše ho znehodnocuje. Naopak rozum je považován za jediný správný nástroj pro spravedlnost, trestání a řízení, který je mírný, přiměřený a zaměřený na nápravu, nikoli pomstu. Příběh o Cn. Pise ukazuje, jak hněv vede k nespravedlivosti a nevinným trestům. Konečně Seneca zdůrazňuje, že skutečná velikost duše spočívá v klidu, ctnosti a sebeovládání, nikoli v násilí nebo hrozivých výrazech."},"c0002":{"cs":"Kniha druhá díla 'De Ira' se zaměřuje na hlubší analýzu původu a povahy hněvu, který Seneca rozlišuje od náhodných pohnutek těla a mysli. Hněv není pouhým reflexem na urážku, ale výsledkem vůle a soudného souhlasu duše s tím, co ji zneklidňuje. První pohnutí je nevědomé, ale skutečný hněv vzniká až při vědomém přijetí urážky a rozhodnutí o pomstě. Seneca argumentuje, že moudrý člověk se nerozčiluje, protože rozumí, že nikdo se nenarodí moudrým, ale stává se tak, a že všichni lidé jsou zranitelní. Hněv je proto nespravedlivý a ničivý, ztrácí ctnost a vede k násilí, zatímco klid a milosrdenství jsou vyšší ctnosti. Autor ukazuje, jak hněv zničí rodinné vztahy, společnost i vlastní osobu, a vyzývá k ovládání hněvu prostřednictvím rozumu, trpělivosti a vzdělání."},"c0003":{"cs":"Kniha 3 De Ira se zaměřuje na hlubokou analýzu hněvu jako jednoho z nejnebezpečnějších lidských emocí, která může zničit nejen jednotlivce, ale i celé společnosti. Seneca zdůrazňuje, že hněv není jen osobní reakcí, ale může se rozšířit na celé národy, způsobovat války, zničení domů a zrušení zákona. Ukazuje, jak hněv ničí řád, ztrátu sebeovládání a vede k násilí, i když se zdá být silným nástrojem ctnosti. Vysvětluje, že hněv je horší než závislost na bohatství, protože se těší na utrpení jiných. Navrhuje systematický přístup k jeho ovládání: od předcházení a sebeznalosti, přes odložení reakce až po účinné metody uklidnění, jako je změna vnějších projevů, odstup od napětí a výběr vhodného společenského prostředí. Závěrem upozorňuje, že klid a sebeovládání jsou skutečným projevem síly a že i v nejhorších podmínkách existuje cesta k osvobození – přes smrt, která je vlastně svobodou."}}}