{"term":"πόλιν","score":0.3,"count":4,"kind":"orig"},{"term":"πόλις","score":0.3,"count":7,"kind":"entity"},{"term":"συσσίτια","score":0.3,"count":3,"kind":"orig"},{"term":"φύσεως","score":0.3,"count":3,"kind":"orig"},{"term":"ψυχή","score":0.3,"count":3,"kind":"orig"},{"term":"ἀρετή","score":0.3,"count":6,"kind":"orig"},{"term":"ἀρετῆς","score":0.3,"count":4,"kind":"orig"},{"term":"ἄρχειν","score":0.3,"count":4,"kind":"orig"}]},"c0008":{"terms":[{"term":"ethos","score":1.0,"count":1,"kind":"word"},{"term":"harmonie","score":1.0,"count":7,"kind":"word"},{"term":"hudba","score":1.0,"count":16,"kind":"entity"},{"term":"katharsis","score":1.0,"count":1,"kind":"word"},{"term":"stát","score":1.0,"count":1,"kind":"word"},{"term":"svobodné umění","score":1.0,"count":1,"kind":"word"},{"term":"výchova","score":1.0,"count":17,"kind":"word"},{"term":"ústava","score":1.0,"count":1,"kind":"word"},{"term":"Aristotelés","score":0.3,"count":9,"kind":"entity"},{"term":"Lakedaimonští","score":0.3,"count":2,"kind":"entity"},{"term":"Politika","score":0.3,"count":10,"kind":"entity"},{"term":"aulos","score":0.3,"count":2,"kind":"word"},{"term":"charakter","score":0.3,"count":4,"kind":"word"},{"term":"ctnost","score":0.3,"count":5,"kind":"word"},{"term":"duše","score":0.3,"count":7,"kind":"entity"},{"term":"dórský mód","score":0.3,"count":2,"kind":"entity"},{"term":"gymnastika","score":0.3,"count":3,"kind":"entity"},{"term":"hudební výchova","score":0.3,"count":2,"kind":"word"},{"term":"mladí","score":0.3,"count":2,"kind":"word"},{"term":"mravy","score":0.3,"count":5,"kind":"word"},{"term":"odpočinek","score":0.3,"count":3,"kind":"word"},{"term":"očista","score":0.3,"count":2,"kind":"word"},{"term":"potěšení","score":0.3,"count":3,"kind":"word"},{"term":"rytmus","score":0.3,"count":4,"kind":"word"},{"term":"vzdělávání","score":0.3,"count":8,"kind":"word"},{"term":"věk","score":0.3,"count":3,"kind":"word"},{"term":"zábava","score":0.3,"count":2,"kind":"word"},{"term":"Θράσιππος","score":0.3,"count":2,"kind":"entity"},{"term":"Λάκωνες","score":0.3,"count":2,"kind":"orig"},{"term":"αὐλός","score":0.3,"count":3,"kind":"orig"},{"term":"βαναύσους","score":0.3,"count":2,"kind":"orig"},{"term":"γυμναστικὴν","score":0.3,"count":2,"kind":"orig"},{"term":"γυμναστικῇ","score":0.3,"count":2,"kind":"orig"},{"term":"διάνοια","score":0.3,"count":2,"kind":"orig"},{"term":"δυνατὸν","score":0.3,"count":2,"kind":"orig"},{"term":"καθάρσεως","score":0.3,"count":2,"kind":"orig"},{"term":"μουσική","score":0.3,"count":4,"kind":"entity"},{"term":"μουσικὴν","score":0.3,"count":3,"kind":"orig"},{"term":"μουσικῆς","score":0.3,"count":3,"kind":"orig"},{"term":"παιδεία","score":0.3,"count":4,"kind":"orig"},{"term":"παιδείαν","score":0.3,"count":5,"kind":"orig"},{"term":"ἀγριωτάτοις","score":0.3,"count":2,"kind":"orig"},{"term":"ἀνδρείαν","score":0.3,"count":3,"kind":"orig"},{"term":"ἁρμονίαις","score":0.3,"count":3,"kind":"orig"},{"term":"ἁρμονίαν","score":0.3,"count":2,"kind":"orig"},{"term":"ἁρμονιῶν","score":0.3,"count":2,"kind":"orig"},{"term":"ἠθικοῖς","score":0.3,"count":2,"kind":"orig"},{"term":"ἡδονή","score":0.3,"count":2,"kind":"orig"},{"term":"ἡμερωτέροις","score":0.3,"count":2,"kind":"orig"},{"term":"ἦθος","score":0.3,"count":2,"kind":"orig"}]}}},"summaries":{"c0001":{"cs":"Aristoteles zkoumá původ politické obce (polis) jako nejvyšší formu společenství, která vzniká přirozeným vývojem z rodiny přes vesnici. Stát existuje pro dosažení dobrého života (eudaimonie) a člověk je přirozeně politické zvíře — mimo stát je buď zvíře nebo bůh. Rozlišuje despotickou vládu nad otroky od politické vlády nad svobodnými a připravuje analýzu hospodářství jako základu státu."},"c0002":{"cs":"Aristoteles zkoumá, zda by bylo lepší sdílet ženy, děti a majetek jako v Platónově státě, či je ponechat soukromé. Argumentuje proti úplné společnosti kvůli zániku přirozených vztahů a péče. Navrhuje kompromis: soukromé vlastnictví s společným užíváním prostřednictvím ctnosti. Kritizuje Spartu za nerovnost a špatnou správu a propaguje smíšenou ústavu (politu) jako ideální mezi demokracií a oligarchií."},"c0003":{"cs":"Aristoteles zkoumá, kdo je skutečným občanem (πολίτης), zdůrazňuje, že občanství závisí na účasti na soudní a zákonodárné moci, nikoli na bydlišti nebo původu. Rozebírá vztah mezi ústavou (πολιτεία) a identitou města (πόλις), kritizuje stranické pojetí spravedlnosti v demokracii a oligarchii a zkoumá, zda je lepší vláda jedné výjimečné osoby nebo mnoha občanů, přičemž zdůrazňuje nutnost praktické moudrosti (phronesis) při aplikaci zákonů."},"c0004":{"cs":"Aristoteles rozlišuje správné a nesprávné formy vlády, kritizuje čisté demokracie a oligarchie jako nestabilní a vyzdvihuje 'politeia' – smíšenou ústavu oligarchie a demokracie – jako nejstabilnější díky vyvážení bohatství, svobody a ctnosti prostřednictvím střední třídy, která zabraňuje extrémům a občanskému konfliktu."},"c0005":{"cs":"Aristoteles zkoumá příčiny změn v oligarchií, demokracií, tyranii a aristokracii, přičemž zdůrazňuje, že nestalost vzniká z vnitřních sporů, nerovnosti majetku a cti, nedůvěry mezi vládnoucími, vlivu demagogů, geografických a sociálních změn oraz drobných podnětů, které se kumulují. Kritizuje jednostranná vysvětlení (např. Sókratés) a zdůrazňuje potřebu vyváženosti, spravedlnosti a výchovy pro stabilitu."},"c0006":{"cs":"Aristoteles zkoumá, jak kombinace různých forem vlády ovlivňuje stabilitu polis, rozlišuje typy demokracie podle sociálního složení lidu a zdůrazňuje výhodu georgického (zemědělského) lidu pro stabilní demokracii. Dále popisuje úřední funkce ve městech – od správy staveb a financí po trestní úřad – a jejich rozdělení podle velikosti obce a typu vlády, přičemž zdůrazňuje nadřazenost lidu nebo jeho zástupců jako nejvyšší autority."},"c0007":{"cs":"Aristoteles zkoumá thymus (θυμός) jako sílu duše zdroj statečnosti a přátelství, která však bez rozumu a ctnosti vede k agresi. Zdůrazňuje, že ideální stát (πόλις) je sebevystačná komunita určená k dobrému životu (εὐδαιμονία), vyžadující dělbu práce (zemědělci, řemeslníci, válečníci, bohatí, kněží, soudci) a organizovaný jako organický celek, kde cílem je nejlepší život skrze ctnost a rozum, nikoli majetek či sílu."},"c0008":{"cs":"Aristoteles tvrdí, že výchova mládeže je nejdůležitější úlohou zákonodárce, protože charakter státu je utvářen výchovou a musí odpovídat ústavě státu. Výchova musí být jednotná a společná, neboť každý občan je částí celku. Dále rozvíjí obsah výchovy: odmítá nevolná (banauská) umění jako nevhodná pro svobodné, zatímco užitečné umění (písmo, kresba) a zejména hudbu považuje za důležité pro formování etosu prostřednictvím rytmu a harmonie, které napodobují ctnosti. Hudba má trojí účel: výchovu, očistu (katharsis) a rekreaci, přičemž různé harmonie (dórická, frýgická, lydická) působí na duši různě a musí být vybírány podle věku a mravního rozvoje."}}}