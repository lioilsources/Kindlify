rm":"Sokrates","score":1.0,"count":2,"kind":"entity"},{"term":"Zákony Athén","score":1.0,"count":2,"kind":"entity"},{"term":"duše","score":1.0,"count":1,"kind":"word"},{"term":"spravedlnost","score":1.0,"count":2,"kind":"word"},{"term":"výchova synů","score":1.0,"count":1,"kind":"word"},{"term":"zákony","score":1.0,"count":1,"kind":"word"},{"term":"útěk","score":1.0,"count":2,"kind":"word"},{"term":"dohody","score":0.5,"count":1,"kind":"word"},{"term":"péče","score":0.5,"count":1,"kind":"word"},{"term":"Θετταλίαν","score":0.5,"count":1,"kind":"orig"},{"term":"δικαιοσύνης","score":0.5,"count":1,"kind":"orig"},{"term":"εὖ ἴσθι ὅτι ἐγὼ δοκῶ ἀκούειν","score":0.5,"count":1,"kind":"orig"},{"term":"θρέψεις","score":0.5,"count":1,"kind":"orig"},{"term":"λόγοι","score":0.5,"count":1,"kind":"orig"},{"term":"παίδων","score":0.5,"count":1,"kind":"orig"},{"term":"παιδεύσεις","score":0.5,"count":1,"kind":"orig"},{"term":"τε καὶ ἀντικακουργήσας","score":0.5,"count":1,"kind":"orig"},{"term":"Ἅιδου","score":0.5,"count":1,"kind":"orig"},{"term":"ἐπιτήδειοι","score":0.5,"count":1,"kind":"orig"},{"term":"ἡμεῖς τέ σοι χαλεπανοῦμεν ζῶντι","score":0.5,"count":1,"kind":"orig"},{"term":"ὦ φίλε ἑταῖρε Κρίτων","score":0.5,"count":1,"kind":"orig"},{"term":"Tesalie","score":0.41,"count":1,"kind":"entity"},{"term":"přátelé","score":0.41,"count":1,"kind":"word"},{"term":"synové","score":0.41,"count":1,"kind":"word"},{"term":"ἀρετῆς","score":0.41,"count":1,"kind":"orig"},{"term":"výchova","score":0.36,"count":1,"kind":"word"},{"term":"vězení","score":0.36,"count":1,"kind":"word"}]}}},"summaries":{"c0001":{"cs":"Kritón vysvětluje, že přišel brzy, aby neprobudil Sókratése, kterého obdivuje za jeho klidný spánek i ve vězení. Přináší znepokojivou zprávu, že loď z Délos, jejíž příjezd tradičně předchází popravě, má dorazit ještě tentýž den, což by znamenalo Sókratovu smrt následujícího dne. Sókratés však vyjadřuje pochybnosti o přesnosti této informace a důvěřuje božské vůli."},"c0002":{"cs":"Sókratés vysvětluje Kritónovi, že jeho sen o ženě v bílém, která ho zve do Fthíidy na třetí den, znamená, že má zemřít až druhý den, nikoli hned. Kritón ho přesto prosí, aby uprchl, protože jeho smrt by byla osobní ztrátou a poškodila jeho pověst mezi těmi, kteří nevědí, že Sókratés odmítl útěk ze zásady."},"c0003":{"cs":"Kritón Sókratovi naléhavě nabízí finanční pomoc a síť přátel v Tesalii, aby mohl uprchnout ze vězení, a zároveň ho kritizuje, že jeho setrvání a přijetí trestu smrti je nespravedlivé vůči sobě samému, poškozuje jeho syny tím, že je opouští bez výchovy, a připomíná činy nepřátel, kteří by ho rádi zničili."},"c0004":{"cs":"Sókratés odmítá Kritónův nátěl na útěk z vězení, zdůrazňuje nutnost řídit se rozumem a zákony, a zkoumá, zda je správné rozlišovat mezi hodnotnými a bezcennými názory lidí, přičemž zdůrazňuje, že jediné, co má smysl poslouchat, je ten nejlepší logický argument."},"c0005":{"cs":"Sokrates a Kritón diskutují o tom, že hodnota názorů se neměří jejich počtem, ale autoritou mluvčího – jako je lékař nebo trenér, jehož soud má větší váhu než mínění davu. Poslouchání nesprávného mínění poškozuje duši stejně jako špatné cvičení tělo, a život s zkorumpovaným tělem či duší není hodný života, protože nespravedlnost pak vládne a spravedlnost je potlačena."},"c0006":{"cs":"Sokrates odmítá, aby názor většiny určoval morální jednání, a tvrdí, že je důležitější žít dobře a spravedlivě než jen žít. Kritón souhlasí, že spravedlnost zůstává neměnná, a Sokrates uzavírá, že je třeba zkoumat, zda útěk z vězení je spravedlivý čin, bez ohledu na následky jako smrt či utrpení."},"c0007":{"cs":"Sokrates přesvědčivě argumentuje, že nikdy není správné jednat nespravedlivě ani odpovídat zlem na zlo, bez ohledu na okolnosti nebo názory většiny, a zdůrazňuje, že takové jednání je vždy špatné a škodlivé."},"c0008":{"cs":"Sokrates se ptá Kritóna, zda by útěk z vězení znamenal porušení zákonů a zničení právního řádu města, či zda mají poslouchat zákony i při nespravedlivém odsouzení. Kritón nedokáže odpovědět, takže Sokrates pokračuje v dialektickém zkoumání následků neposlušnosti zákonům."},"c0009":{"cs":"Sokrates argumentuje, že zákony a vlast mají nadřazený postavení před jednotlivcem, podobně jako rodiče před dítětem, a proto je občan povinen je poslouchat i v případě nespravedlivého rozsudku, války nebo soudního řízení, protože utékáním nebo odporem by porušil svůj závazek vůči tomu, kdo ho vychoval a vzdělal."},"c0010":{"cs":"Sókratés odpovídá Kritónovi, že i když měl možnost uprchnout z vězení, zvolil zůstání a podrobení se rozsudku smrti, protože porušení svých dlouhodobých závazků vůči Aténám by bylo nespravedlivé a rozvratné pro zákony státu, kterým se po celý život svobodně podroboval."},"c0011":{"cs":"Sókratés Kritónovi vyčítá, že by útěk z vězení poškodil nejen zákony Atén, ale i jeho vlastní pověst a bezpečí přátel. Upozorňuje, že by byl považován za zkorumpovaného mladíky, a že útěk do Tessalie by ho učinil předmětem posměchu. Namísto toho zdůrazňuje hodnotu spravedlnosti, zákona a ctnosti jako vyššího dobra než pouhé přežití."},"c0012":{"cs":"Sokrates zvažuje, zda by bylo vhodné uprchnout do Tesalie a nechat své syny vychovávat cizinci, ale nakonec odmítá útěk, protože by to znamenalo porušení zákonů a dohod se státem, což by poškodilo jeho duši, přátele, vlast i vztah k zákonům podsvětí, které by ho nepřijaly přátelsky."}}}