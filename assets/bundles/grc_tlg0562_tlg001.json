rm":"φύσις","score":0.79,"count":5,"kind":"orig"},{"term":"jednota","score":0.73,"count":2,"kind":"word"},{"term":"πρόνοια","score":0.73,"count":2,"kind":"orig"},{"term":"νοῦς","score":0.68,"count":3,"kind":"orig"},{"term":"společné dobro","score":0.63,"count":2,"kind":"word"},{"term":"σωφροσύνη","score":0.63,"count":2,"kind":"entity"},{"term":"mysl","score":0.56,"count":2,"kind":"word"},{"term":"ἀλήθεια","score":0.56,"count":2,"kind":"orig"},{"term":"přijetí osudu","score":0.5,"count":2,"kind":"word"},{"term":"smrt","score":0.5,"count":3,"kind":"word"},{"term":"διάνοια","score":0.5,"count":2,"kind":"orig"},{"term":"duše","score":0.47,"count":3,"kind":"word"},{"term":"Hélios","score":0.44,"count":1,"kind":"entity"},{"term":"Marek Aurelius","score":0.44,"count":1,"kind":"entity"},{"term":"Substance","score":0.44,"count":1,"kind":"entity"},{"term":"božská podstata","score":0.44,"count":1,"kind":"word"},{"term":"filozofický výcvik","score":0.44,"count":1,"kind":"word"},{"term":"hēgemikon","score":0.44,"count":1,"kind":"entity"},{"term":"lhostejnost k osudu","score":0.44,"count":1,"kind":"word"},{"term":"lidská jednota","score":0.44,"count":1,"kind":"word"},{"term":"lidská sebecena","score":0.44,"count":1,"kind":"word"},{"term":"místo ve světě","score":0.44,"count":1,"kind":"word"},{"term":"pancratiast","score":0.44,"count":1,"kind":"word"},{"term":"pokora","score":0.44,"count":1,"kind":"word"},{"term":"prozřetelnost","score":0.44,"count":1,"kind":"word"},{"term":"předsudky","score":0.44,"count":1,"kind":"word"},{"term":"příroda jako soudce","score":0.44,"count":1,"kind":"word"},{"term":"přítomný okamžik","score":0.44,"count":1,"kind":"word"},{"term":"rovnost před zákonem","score":0.44,"count":1,"kind":"word"},{"term":"rozum a příroda","score":0.44,"count":1,"kind":"word"},{"term":"smrt a odměna","score":0.44,"count":1,"kind":"word"},{"term":"spravedlnost božská","score":0.44,"count":1,"kind":"word"},{"term":"systém života","score":0.44,"count":1,"kind":"word"},{"term":"vládnoucí část duše","score":0.44,"count":1,"kind":"word"},{"term":"vnitřní postoj","score":0.44,"count":1,"kind":"word"},{"term":"vnitřní světlo","score":0.44,"count":1,"kind":"word"},{"term":"účelnost","score":0.44,"count":1,"kind":"word"}]}}},"summaries":{"c0001":{"cs":"V první knize svých 'Hovorů k sobě' Marcus Aurelius děkuje svým předkům a učitelům za vlastnosti, které zdědil: mírnost, úctu, skromnost, vzdělání, odolnost vůči pověrám, sebekázeň, upřímnost, lásku k rodině a věrnost přátelům. Zdůrazňuje vnitřní ctnost nad vnějšími úspěchy."},"c0002":{"cs":"Marcus Aurelius vybízí k rannímu sebepoznání: lidé jednají špatně kvůli nevědomosti, ale my musíme rozpoznat dobro a zlo podle jejich podstaty. Zdůrazňuje jednotu lidské přirozenosti (tělo, duch, rozum) a nutnost vládnout nad vášněmi. Člověk je částí kosmického řádu, kde vše slouží celku, a musí přijmout své místo v něm s pokorou, spravedlností a vnitřní svobodou."},"c0003":{"cs":"Marcus Aurelius vyzývá k neustálému sebereflexi a kultivaci mysli, protože i když tělesné funkce přetrvávají, rozumová schopnost sebekázně a úsudku se věkem oslabuje. Je třeba spěchat s vnitřní prací, dokud je to možné, než dojde k úpadku duševních sil. Zdůrazňuje také hodnotu přirozeného souladu s přírodou, nevyhnutelnost smrti i u největších postav a potřebu soustředit se na vlastní činy, nikoli na cizí záležitosti. Pravá ctnost spočívá v souladu s rozumem a společnou přirozeností lidstva, nikoli v názorech většiny nebo vnějších hodnotách jako sláva či bohatství."},"c0004":{"cs":"Vnitřní panovník duše, v souladu s přírodou, snadno přetváří vnější události ve svůj prospěch, podobně jako oheň přeměňuje vše, co na něj padne, v své palivo. Pravý odpočinek a obnova se nacházejí ve stažení se do vlastní duše, která je nejklidnějším a nejúčinnějším útočištěm, kde lze nalézt euforii a kosmický řád."},"c0005":{"cs":"Kapitola vybízí k sebereflexi nad tím, proč člověk váhá vstát a jednat podle své přirozenosti, když je stvořen k činnosti a službě druhým. Zdůrazňuje soustředění se na přirozené a rozumné jednání, odmítání rušivých vlivů a vnějších soudů, a zároveň vnitřní klid a soulad s vlastní přirozeností i společenským řádem jako cestu k moudrosti a sebeúctě."},"c0006":{"cs":"Marcus Aurelius učí, že vesmír je uspořádán rozumným logosem, který nezpůsobuje zlo. Člověk by měl jednat podle své přirozenosti, nezávisle na vnějších podmínkách, kultivovat vnitřní svobodu, sebekázeň a sociální ctnost, přičemž vše pomíjí a pouze přítomný čin má význam. Filosofie je útočištěm, kde lze nalézt klid a sílu."},"c0007":{"cs":"Kapitola Knihy 7 Hovorů k sobě od Marcela Aurelia zdůrazňuje kosmologickou jednotu: jeden svět, jeden bůh, jedna substance, jeden zákon a společný logos všech rozumných bytostí. Zdůrazňuje pomíjivost hmoty, nutnost žít podle rozumu a přírody, vnitřní svobodu mysli vůči vnějším událostem a důležitost sebekázně, spravedlnosti a souladu s univerzálním řádem jako cestu k ctnosti a klidu duše."},"c0008":{"cs":"Kapitola zdůrazňuje, že filosofie není o vnějších známkách moudrosti, ale o vnitřním souladu činu s přirozeností člověka. Člověk má jednat podle zásad dobra a zla, které tvoří základ ctností: spravedlnosti, rozumnosti, statečnosti a svobody. Každý čin má být podroben sebereflexi: zda je v souladu s rozumem, sociálností a božským řádem, a zda po něm nezůstává lítost. Vše se děje podle přirozeného toku světa – změny jsou přirozené, není třeba se jich bát. Rozum má sílu přetvářet překážky v příležitost a udržovat vnitřní klid nezávislý na vnějších událostech."},"c0009":{"cs":"Marcus Aurelius tvrdí, že ten, kdo jedná nespravedlivě nebo lže, se dopouští nevěry (asebeia), protože tím porušuje přirozený zákon, podle kterého mají rozumné bytosti jednat vzájemně prospěšně podle své hodnoty. Takové jednání je boj proti sobě samému a vede ke ztrátě schopnosti rozlišovat pravdu od lži kvůli zanedbání darů přírody."},"c0010":{"cs":"Duše je vyzvána, aby dosáhla stavu vnitřní čistoty, nezávislosti na vnějších věcech a spokojenosti s přítomným okamžikem, důvěřujíc v božskou prozřetelnost, která vše zařizuje pro dobro a spravedlnost celku. Zdůrazňuje soulad s přirozeností a přijetí osudu jako součást univerzálního řádu."},"c0011":{"cs":"Kapitola zkoumá povahu racionální duše: její schopnost sebepoznání, sebetvoření a dosahování cíle bez ohledu na přerušení, její kosmický pohled včetně věčné recurrence, a etické základy jako láska k bližním, pravda, skromnost a spravedlnost. Dále se zabývá přípravou na smrt, hodnotou společně prospěšného jednání a kritikou povrchních zábav bez ctnosti."},"c0012":{"cs":"Kapitola vyzývá k opuštění lpění na minulosti a obav z budoucnosti, k soustředění se pouze na přítomný okamžik a jednání podle svatosti (přijetí daru přírody) a spravedlnosti (mluvit pravdu, jednat podle zákona a hodnoty bez předsudků). Zdůrazňuje oddělení rozumové podstaty od těla, duše a vnějších myšlenek jako cestu k vnitřní svobodě a životu v souladu s daimonem. Reflektuje nad pomíjivostí života, jednotou bytí, rolí rozumu a nutností žít podle přírody a společného dobra, přičemž smrt není zlý, pokud slouží celku."}}}