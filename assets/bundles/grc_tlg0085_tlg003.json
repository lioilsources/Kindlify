word"},{"term":"rouhání","score":0.3,"count":1,"kind":"word"},{"term":"trápení","score":0.3,"count":1,"kind":"word"},{"term":"tvrdohlavost","score":0.3,"count":1,"kind":"word"},{"term":"vina","score":0.3,"count":1,"kind":"word"},{"term":"vzpoura","score":0.3,"count":1,"kind":"word"},{"term":"Ζεὺς","score":0.3,"count":3,"kind":"orig"},{"term":"Κρόνου","score":0.3,"count":1,"kind":"orig"},{"term":"Ποσειδῶνος","score":0.3,"count":1,"kind":"orig"},{"term":"Τάρταρον","score":0.3,"count":1,"kind":"orig"},{"term":"αὐθαδία","score":0.3,"count":1,"kind":"orig"},{"term":"αὐθαδίαν","score":0.3,"count":1,"kind":"orig"},{"term":"βροντῆς","score":0.3,"count":1,"kind":"orig"},{"term":"δαφοινὸς αἰετός","score":0.3,"count":1,"kind":"orig"},{"term":"δεσμὰ λυμαντήρια","score":0.3,"count":1,"kind":"orig"},{"term":"εὐβουλίας","score":0.3,"count":1,"kind":"orig"},{"term":"θεούς","score":0.3,"count":1,"kind":"orig"},{"term":"θεοὺς","score":0.3,"count":1,"kind":"orig"},{"term":"κεραυνοῦ","score":0.3,"count":1,"kind":"orig"}]}}},"summaries":{"c0001":{"cs":"Héfaistos je přinucen Zeovým příkazem přikovat Prométhea ke skále v pusté zemi za to, že ukradl oheň bohům a daroval jej lidem. Přestože Héfaistos cítí soucit kvůli svému vztahu k Prométheovi, Kratos ho nutí k poslušnosti. Prométheus později lamentuje nad svým utrpením a vyjadřuje odpor proti božské tyranii."},"c0002":{"cs":"Chór popisuje Prométheovo trápení na skále, kde je spoután řetězy a trápí ho bolest a osamělost, zatímco vyjadřuje strach z jeho osudu a ptá se, který boh by takové utrpení snášel bez Zeusovy vůle. Prométheus naopak odmítá podvolit se Zeusovi, trvá na své svobodě vůle a věří, že spravedlnost nakonec zvítězí, i když nyní trpí pod Zeusovou vládou nových zákonů."},"c0003":{"cs":"Prométheus odpovídá na dotazy sboru a vysvětluje, že se pokusil poradit Titánům moudrostí místo síly během jejich boje s Zeem, ale neuspěl. Po Zeově vítězství byl potrestán, zatímco lidem nedal rozum, až on sám jim dal naději a oheň. Okeanos nabízí soucit a pomoc, ale Prométheus jej odmítá s tím, že jeho osud je nezvratný a že trpí spravedlivě za prospěch lidstva."},"c0004":{"cs":"Chór lamentuje nad utrpením Prométhea, který je trestán Zeusem za dar ohně lidstvu, zatímco popisuje bolest a nářek přírody i vzdálených národů – Kolchidy, Skythů, Arabů a Kavkazu – které sdílejí jeho žal, včetně sténání hor, řek a podsvětí."},"c0005":{"cs":"Prométheus líčí, jak lidé před jeho pomocí žili bez znalosti řemesel, času, zemědělství či umění, slepě a bez rozumu. Daroval jim písmo, čísla, chov zvířat, práci s kovy, lékařské umění včetně diagnostiky snů a znamení, umění výkladu znamení z ptáků a vnitřností, a nakonec oheň a všechna umění, která jsou základem lidské kultury, přestože tím vyvolal hněv bohů."},"c0006":{"cs":"Chorus ve své ódě vzdává hold Prométheovi za jeho statečný vzdor proti Zeusovi, uznává jeho moudrost a trpný osud, zároveň reflektuje na jeho přínos lidstvu skrze symbolické činy jako je dar ohně a manželství s Hesionou, což poukazuje na propojení božského a lidského světa."},"c0007":{"cs":"Io lamentuje své trápení, ptá se na svou zemi, rodinu a příčinu svého trápení, zatímco je pronásledována gadfly poslanou Hérou jako trest za její spojení s Zeem. Bloudí po zemi, zmatená a vyčerpaná, hledající úlevu a pochopení svého osudu."},"c0008":{"cs":"Io, proměněná v krávu a pronásledovaná oštěpem (gadfly) kvůli žárlivosti Héry na její vztah s Zeem, vyčerpáně popisuje své putování a bolesti. Obrátí se na přikovaného Prométhea s otázkou, kdo je zodpovědný za její osud, a žádá jej, aby jí prozradil, jaké léky nebo prostředky by mohly zmírnit její utrpení, či zda existuje nějaká naděje na osvobození."},"c0009":{"cs":"V této epizodě Prométheus klidně a věcně odpovídá na otázky trpící Íó (dcéra Inacha), která se ptá na své utrpení a touhu po smrti. Prométheus jí vysvětluje, že její trest ještě neskončil, ale že bude osvobozena až poté, co porodí syna, který ho vyvede z pout. Nabízí jí útěchu, popisuje její budoucí pouť přes nebezpečná území a říká, že její osud bude věčně připomínán. Zároveň odmítá prozradit vše hned, aby ji nezatížil přílišným poznáním."},"c0010":{"cs":"Chorál nejprve vyzdvihuje moudrost toho, kdo jako první unese břemeno poznání a promluví o tom, že sebeobětování je největší ctnost, nadřazená bohatství či šlechtickému původu. Následně vyjadřuje strach před zásahy bohyně Héry a osudu určeného Moirai, obávaje se ztráty panenství a nuceného sňatku s nebeským božstvem. Nakonec touží po klidném, nevinném manželství bez válečného konfliktu a božské intriky, přiznávaje svou neschopnost odolat či pochopit Zeusovu moudrost, před níž se chce skrýt."},"c0011":{"cs":"Prométheus předpovídá pád Zeuse, tvrdí, že zná způsob, jak tomu zabránit, a odmítá se podrobit božské vůli. V dialogu s Herméem vyjadřuje pohrdání božskou mocí, svou nevinnost v krádeži ohně a ochotu trpět za své činy, zatímco Hermés ho varuje před nadcházejícím trestem a vyzývá k rozumu."}}}