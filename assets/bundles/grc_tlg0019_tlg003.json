":"word"},{"term":"služebnictvo","score":0.68,"count":1,"kind":"word"},{"term":"ΕΡΜΗ͂Σ","score":0.68,"count":1,"kind":"entity"},{"term":"Νεθέλαι","score":0.68,"count":1,"kind":"orig"},{"term":"Σωκράτη","score":0.68,"count":1,"kind":"orig"},{"term":"Χαιρεφῶντα","score":0.68,"count":1,"kind":"orig"},{"term":"η μοι μὴ προδῷ τὰς ἐλπίδας","score":0.68,"count":1,"kind":"orig"},{"term":"καὶ τῆς σελήνης ἐσκοπεῖσθε τὴν ἕδραν","score":0.68,"count":1,"kind":"orig"},{"term":"μάλιστα δʼ εἰδὼς τοὺς θεοὺς ὡς ἠδίκουν","score":0.68,"count":1,"kind":"orig"},{"term":"οἰκία","score":0.68,"count":1,"kind":"orig"},{"term":"παρανοία","score":0.68,"count":1,"kind":"orig"},{"term":"πολλῶν οὕνεκα","score":0.68,"count":1,"kind":"orig"},{"term":"σελήνη","score":0.68,"count":1,"kind":"entity"},{"term":"σμινύη","score":0.68,"count":1,"kind":"orig"},{"term":"φλόγα","score":0.68,"count":1,"kind":"orig"},{"term":"ἢ ʼγὼ πρότερόν πως ἐκτραχηλισθῶ πεσών","score":0.68,"count":1,"kind":"orig"},{"term":"ἥλιος","score":0.68,"count":1,"kind":"entity"},{"term":"ΣΩΚΡΆΤΗΣ","score":0.62,"count":2,"kind":"orig"},{"term":"Chairefón","score":0.57,"count":1,"kind":"entity"},{"term":"Hermés","score":0.57,"count":1,"kind":"entity"},{"term":"bláznovství","score":0.57,"count":1,"kind":"word"},{"term":"oheň","score":0.57,"count":1,"kind":"word"},{"term":"Δία","score":0.57,"count":1,"kind":"orig"},{"term":"Δῖνος","score":0.57,"count":1,"kind":"orig"},{"term":"Feidippidés","score":0.49,"count":1,"kind":"entity"},{"term":"Ζεὺς","score":0.49,"count":1,"kind":"orig"},{"term":"Χαιρεφῶν","score":0.49,"count":1,"kind":"orig"},{"term":"θεοὺς","score":0.49,"count":1,"kind":"orig"},{"term":"trest","score":0.44,"count":1,"kind":"word"},{"term":"Nefelai","score":0.4,"count":1,"kind":"entity"},{"term":"Sokrates","score":0.4,"count":1,"kind":"entity"},{"term":"Sókrates","score":0.4,"count":1,"kind":"word"},{"term":"bohové","score":0.4,"count":1,"kind":"word"},{"term":"ΦΕΙΔΙΠΠΊΔΗΣ","score":0.36,"count":1,"kind":"orig"},{"term":"Oblaka","score":0.33,"count":1,"kind":"entity"},{"term":"Zeus","score":0.31,"count":1,"kind":"entity"}]},"c0015":{"terms":[{"term":"chór","score":1.0,"count":1,"kind":"word"},{"term":"dnešek","score":1.0,"count":1,"kind":"word"},{"term":"mírná účast","score":1.0,"count":1,"kind":"word"},{"term":"mírně","score":1.0,"count":1,"kind":"word"},{"term":"radost","score":1.0,"count":1,"kind":"word"},{"term":"společenský rituál","score":1.0,"count":1,"kind":"word"},{"term":"stará komedie","score":1.0,"count":1,"kind":"word"},{"term":"tanec","score":1.0,"count":1,"kind":"word"},{"term":"venkovní aktivita","score":1.0,"count":1,"kind":"word"},{"term":"venku","score":1.0,"count":1,"kind":"word"},{"term":"výzva","score":1.0,"count":1,"kind":"word"},{"term":"výzva k pohybu","score":1.0,"count":1,"kind":"word"},{"term":"κεχόρευται","score":1.0,"count":1,"kind":"orig"},{"term":"μετρίως","score":1.0,"count":1,"kind":"orig"},{"term":"τό γε τήμερον","score":1.0,"count":1,"kind":"orig"},{"term":"ἔξω","score":1.0,"count":1,"kind":"orig"},{"term":"ἡγεῖσθʼ","score":1.0,"count":1,"kind":"orig"},{"term":"ἡμῖν","score":1.0,"count":1,"kind":"orig"},{"term":"ΧΟΡΌΣ","score":0.46,"count":1,"kind":"entity"}]}}},"summaries":{"c0001":{"cs":"Strepsiádés si stýská na své finanční potíže, nespavost způsobenou úroky a dluhy, zatímco jeho syn Fédippidés sní o jízdě na koni a válčení. Otec vzpomíná na svůj klidný venkovský život před sňatkem s měšťankou, která přinesla luxus a zadlužení. Rozhodne se poslat syna ke sofistům, aby se naučil obracet právo ve svůj prospěch a uniknout věřitelům."},"c0002":{"cs":"V Parodos 2 se Sókrates modlí k oblakům (Nefélai) jako k nebeským bohyním pocházejícím od Okeana, které přinášejí déšť, osvěžují zemi a dávají lidem rozum a řeč. Chór oblaků popisuje svůj pohyb nad horami a řeky, schopnost přinášet inspiraci i proměňovat se v různé podoby (kentaur, vlk, žena) podle toho, co pozorovatel vidí. Strepsiás nejprve oblaky zaměňuje s mlhou nebo kouřem, ale postupně začíná chápat jejich božskou povahu prostřednictvím sokratovského dialogu."},"c0003":{"cs":"V tomto úryvku z Aristofanovy komedie Oblaka vede Sókrates dialog se Strepsiádem, během kterého popírá existenci Zeuse jako boha a vysvětluje přírodní jevy – déšť, hrom a blesk – jako důsledky fyzikálních procesů v mracích (nefelai): srážky vodou nasycených mraků způsobují hrom, vítr v mracích pak blesk. Strepsiád je zmatený, vzpomíná na své dřívější představy (např. že Zeus močí přes síto) a zároveň se trápí vlastní nešikovností – spálil si obličej při vaření pro příbuzné. Sbor komentuje Strepsiádovu žádost o pomoc s dluhy a nabízí mu věhlas a úspěch výměnou za poslušnost a učení, zatímco závěr obsahuje satirický výčet hanlivých přízvisek určených někomu nečestnému."},"c0004":{"cs":"Sokrates se ptá Strepsiada na jeho způsob učení a paměti, přičemž Strepsiad přiznává, že si pamatuje jen to, co mu ostatní dluží, a zapomíná své vlastní závazky. Dialog se přesouvá k otázkám přírody, moudrosti a chování při fyzickém napadení, což odhaluje Strepsiadovu neznalost. Sokrates se snaží vyvést ho z omylu pomocí ironie a konfrontace s realitou, zatímco Strepsiades pochybuje o své schopnosti stát se skutečně chytrým žákem."},"c0005":{"cs":"V parabasi 5 sbor nejprve vyjadřuje radost z odvahy a moudrosti stárnoucích, poté kritizuje nepoctivé básníky, kteří opisují cizí díla, a nakonec se obrací k bohům – chválí Zeuse, Aithéra a jiné božstva, zatímco kritizuje athénské diváky za nedostatek úcty k určitým bohům a spojuje tento nedostatek se špatnými politickými rozhodnutími, jako je volba Kleóna jako stratéga."},"c0006":{"cs":"Sókratés se snaží naučit Strepsiáda základům básnické metriky, správnému pojmenování pohlaví u zvířat a rostlin a logickému myšlení. Strepsiád však prokazuje hlubokou nevědomost, zaměňuje pohlaví, nedokáže rozlišovat metrika a opakuje nesmyslné otázky. Sókrates jej kritizuje jako agroického a škaiého, zatímco Strepsiád se zoufale snaží vyhnout dluhům pomocí magických prostředků, což Sókrates odmítá jako iracionální."},"c0007":{"cs":"V tomto úryvku z Agónu 7 komedie Oblaka vede spravedlivý λόγος (slovo) dialog s nespravedlivým λόγосem o povaze výchovy, moudrosti a božské spravedlnosti. Spravedlivé slovo obhajuje starou výchovu založenou na mírnosti, hudbě a tradičních hodnotách, zatímco nespravedlivé slovo zastává sofistickou rétoriku, kritizuje bohy a tradiční ideály a chválí vítězství v disputaci nad pravdou. Sbor nakonec žádá o ukončení sporu a předvedení obou forem výchovy."},"c0008":{"cs":"Sokrates se ptá Strepsiada, zda chce, aby jeho syn byl odveden pryč, nebo aby ho Sokrates naučil mluvit. Strepsiad žádá, aby Sokrates syna naučil, potrestal a pamatoval si, jak má ústa tvarovat, aby mohl mluvit o větších věcech, zatímco Fidippides poznamenává, že syn je bledý a nešťastný."},"c0009":{"cs":"Chor v parabasi hrozí soudci, že pokud jej neocení spravedlivě za své umění, bude trestat jeho vinice, úrodu a dokonce i svatby, aby ho přiměl k úctě vůči bohyním a lepšímu chování."},"c0010":{"cs":"Strepsiades vyjadřuje strach z nadcházejících dnů splatnosti dluhů a soudů, zatímco diskutuje se Sókratem o vzdělání svého syna Feidippida. Následuje série komických výměn: řešení právních triků kolem 'starého a nového dne', spory o dluhy s Pasíou (kde se vtipně obrací význam slova 'kardopos'), lamentace Amyniáše nad ztrátou majetku a bohů, a debaty o spravedlnosti vymáhání dluhů bez pochopení přírodních zákonů. Scéna vrcholí hrozbou fyzického trestu a ironickým odkazem na sofistické vzdělání jako nástroj k úniku před odpovědností."},"c0011":{"cs":"Chorální pasáž zobrazuje starého muže, který se zamiloval do povrchních věcí a touží po majetku získaném nečestně, aby se stal sofistou, i když tím riskuje nebezpečí. Spekuluje se, že jednoho dne najde to, co dlouho hledal – schopnost říkat nepravdy ve prospěch nespravedlivých, aby porazil své protivníky, možná i zmlknout."},"c0012":{"cs":"Scéna zachycuje hádku mezi otcem Strepsiádem a jeho synem Fidippidem, kde syn otevřeně přiznává fyzické násilí vůči otci a snaží se je obhájit pomocí filozofických sofismů, zejména rozlišováním 'lepšího' a 'horšího' argumentu, což odráží Aristofanovu kritiku sofistického vzdělávání a jeho dopadu na morálku a rodinné vztahy."},"c0013":{"cs":"V této scéně z Aristofanových Oblak se Strepsiás a jeho syn Feidippid přou o správnou výchovu: Strepsiás hájí tradiční tělesné tresty, zatímco Feidippid, ovlivněn sofistikou (zejména Euripidem a Sokratem), tvrdí, že je nyní schopen ospravedlnit i bití svého otce pomocí sofistických argumentů. Sbor komentuje jejich spory a kritizuje rozmařilost a nevzdělanost mladé generace."},"c0014":{"cs":"Strepsiades vyčítá oblakům (Nefelai), že ho svedli k víře v bohy a následování Sokrata, což vedlo k jeho bláznovství. Jeho syn Feidippides odmítá jednat nespravedlivě vůči učitelům a zpochybňuje povahu Dia. Strepsiades pak zuřivě plánuje zapálit dům sofistů, aby se pomstil Sokratovi, a žádá služebnictvo o žebřík a smolu. Sókrates přichází a ptá se, co dělá, zatímco postavy diskutují o létání, urážení bohů a trestu za rouhání."},"c0015":{"cs":"Chór vyzývá účastníky, aby vyšli ven a zatančili si, jelikož dnešní den byl v tanci jen mírně aktivní, což naznačuje potřebu uvolnění a radosti prostřednictvím pohybu."}}}