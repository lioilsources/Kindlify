ore":0.3,"count":5,"kind":"entity"},{"term":"Ennius","score":0.3,"count":5,"kind":"entity"},{"term":"Epicurus","score":0.3,"count":7,"kind":"entity"},{"term":"Etrusci","score":0.3,"count":4,"kind":"entity"},{"term":"Homerus","score":0.3,"count":4,"kind":"entity"},{"term":"Iuppiter","score":0.3,"count":10,"kind":"entity"},{"term":"Jupiter","score":0.3,"count":5,"kind":"entity"},{"term":"M. Tullius Cicero","score":0.3,"count":10,"kind":"entity"},{"term":"Romulus","score":0.3,"count":5,"kind":"entity"},{"term":"Stoici","score":0.3,"count":11,"kind":"entity"},{"term":"animus","score":0.3,"count":4,"kind":"orig"},{"term":"argumentace","score":0.3,"count":5,"kind":"word"},{"term":"božská vůle","score":0.3,"count":6,"kind":"word"},{"term":"casu","score":0.3,"count":8,"kind":"orig"},{"term":"casus","score":0.3,"count":4,"kind":"orig"},{"term":"deorum","score":0.3,"count":5,"kind":"orig"},{"term":"divinatio","score":0.3,"count":11,"kind":"orig"},{"term":"exta","score":0.3,"count":6,"kind":"orig"},{"term":"fato","score":0.3,"count":5,"kind":"orig"},{"term":"filozofie","score":0.3,"count":10,"kind":"word"},{"term":"haruspices","score":0.3,"count":12,"kind":"orig"},{"term":"hvězdy","score":0.3,"count":5,"kind":"word"},{"term":"interpretace","score":0.3,"count":7,"kind":"word"},{"term":"logika","score":0.3,"count":17,"kind":"word"},{"term":"měsíc","score":0.3,"count":4,"kind":"word"},{"term":"narození","score":0.3,"count":5,"kind":"word"},{"term":"natura","score":0.3,"count":12,"kind":"orig"},{"term":"nejasnost","score":0.3,"count":4,"kind":"word"},{"term":"pravda","score":0.3,"count":10,"kind":"word"},{"term":"předpověď","score":0.3,"count":9,"kind":"word"},{"term":"příroda","score":0.3,"count":9,"kind":"word"},{"term":"sny","score":0.3,"count":15,"kind":"word"},{"term":"somniorum","score":0.3,"count":5,"kind":"orig"}]}}},"summaries":{"root":{"cs":"De Divinatione je filozofická rozprava M. Tullia Cicerona, která se zabývá povahou a důvěryhodností věštby. První kniha argumentuje pro existenci věštby jako součásti přirozeného a božského řádu, zatímco druhá kniha, v rámci stoického skepticismu, ji zpochybňuje jako založenou na náhodě, předsudcích nebo nesmyslných interpretacích. Dílo je strukturováno jako dialog, v němž se vystřídají různé názory na věštby z blesků, snů, astrologie, augurátů a jiných forem. Knihovna má překlad do češtiny."},"c0001":{"cs":"Kniha 1 De divinatione se zabývá systematickým zkoumáním věštění jako důležitého prvku antického života, včetně jeho různých forem – augurátů, haruspiků, orákulů, snů a přírodních znamení. Cicero diskutuje, zda věštby jsou založeny na božském zásahu, přirozeném řádu nebo lidském rozumu, a argumentuje, že i když některé předpovědi selhají, jedno nezpochybnitelné splnění může potvrdit jejich pravdivost. Zdůrazňuje význam věštby pro římskou politiku, vojenské rozhodování a náboženský život, přičemž představuje příklady z mytologie, historie a filozofie, aby ukázal její hlubší, logickou a etickou oporu. Kritizuje jak stoické odmítnutí věštby, tak akademický skepticismus, a obrání její místo v lidském poznání."},"c0002":{"cs":"V druhé knize 'O věštění' Cicero pokračuje v kritice stoické teorie věštění, která byla v předchozí knize vysvětlena a obraněna. Zaměřuje se na argument, že věštění nemůže existovat, protože neexistuje žádná podstata, kterou by mohlo tvořit. Odmítá možnost předvídání náhodných událostí, jako jsou větry, choroby nebo jiné náhodné jevy, které nelze rozumně ani uměle předpovědět. Pokud by vše bylo zcela předurčeno, pak by věštění bylo zbytečné. Kritizuje jednotlivé formy věštby – haruspiky, věštby z blesků, příznamů, výběr losů, astrologii Chaldejců, věštby z rozhodnutí a snů – a ukazuje jejich neopodstatněnost. Na závěr upozorňuje, že náboženská věrnost je třeba zachovat, ale superstice je třeba odmítnout."},"c0003":{"cs":"Kniha 2 díla 'De Divinatione' představuje rozsáhlou filozofickou kritiku věštby, kterou Cicero považuje za nevěrohodnou a nesmyslnou. Zabývá se výzvami k jejímu základu v náhodě, osudu a božském zásahu, argumentuje, že pokud je vše předurčeno, věštba je zbytečná, a pokud se osud může změnit, není předurčen. Kritizuje věštby z extilů, blesků, snů, astrologie a auspicií jako založené na náhodě, zvyku nebo nepochopení přírodních zákonů. Poukazuje na nejasnost, nesrovnalosti a záměrnou nejasnost orákul, a zpochybňuje možnost předvídání budoucnosti v oblastech, kde jsou potřebné odborné znalosti. Zároveň se vyjadřuje proti přisuzování významu náhodným přírodním jevům a výkladům snů, které považuje za výsledek duševních procesů, nikoli božských zpráv."}}}