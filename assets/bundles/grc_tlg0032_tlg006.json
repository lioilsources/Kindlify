},{"term":"Bithyné","score":0.3,"count":2,"kind":"entity"},{"term":"Kléandros","score":0.3,"count":2,"kind":"entity"},{"term":"Obětní rituál","score":0.3,"count":2,"kind":"entity"},{"term":"Orel","score":0.3,"count":2,"kind":"entity"},{"term":"Thrákové","score":0.3,"count":2,"kind":"entity"},{"term":"modlitba bohům","score":0.3,"count":2,"kind":"word"},{"term":"pohřeb padlých","score":0.3,"count":2,"kind":"word"},{"term":"vojenský pochod","score":0.3,"count":3,"kind":"word"},{"term":"vyslanci","score":0.3,"count":2,"kind":"word"},{"term":"znamení","score":0.3,"count":2,"kind":"word"},{"term":"zástupci","score":0.3,"count":2,"kind":"word"},{"term":"úrodná země","score":0.3,"count":2,"kind":"word"},{"term":"řecká armáda","score":0.3,"count":5,"kind":"word"},{"term":"Βιθυνοῖς","score":0.3,"count":2,"kind":"orig"},{"term":"Βιθυνῶν","score":0.3,"count":2,"kind":"orig"},{"term":"Δέξιππος","score":0.3,"count":2,"kind":"orig"},{"term":"Θρᾷκες","score":0.3,"count":4,"kind":"orig"},{"term":"Κάλπης λιμένα","score":0.3,"count":2,"kind":"orig"},{"term":"Κλέανδρον","score":0.3,"count":2,"kind":"orig"},{"term":"Κλέανδρος","score":0.3,"count":3,"kind":"orig"},{"term":"Σμίκρητος","score":0.3,"count":2,"kind":"orig"},{"term":"Χειρίσοφος","score":0.3,"count":4,"kind":"orig"},{"term":"Χειρισόφου","score":0.3,"count":2,"kind":"orig"},{"term":"Χρυσόπολιν","score":0.3,"count":2,"kind":"orig"},{"term":"Ἕλληνες","score":0.3,"count":6,"kind":"orig"}]},"c0007":{"terms":[{"term":"Anaxibios","score":1.0,"count":6,"kind":"entity"},{"term":"Byzant","score":1.0,"count":1,"kind":"word"},{"term":"Hellespont","score":1.0,"count":1,"kind":"entity"},{"term":"Perinthus","score":1.0,"count":1,"kind":"entity"},{"term":"Seuthes","score":1.0,"count":18,"kind":"entity"},{"term":"Xenofón","score":1.0,"count":41,"kind":"entity"},{"term":"nedostatek mzdy","score":1.0,"count":1,"kind":"word"},{"term":"vzpoura vojsk","score":1.0,"count":1,"kind":"word"},{"term":"Σεύθης","score":1.0,"count":23,"kind":"orig"},{"term":"Ξενοφῶν","score":0.51,"count":28,"kind":"orig"},{"term":"Anabáze","score":0.3,"count":9,"kind":"entity"},{"term":"Aristarchos","score":0.3,"count":4,"kind":"entity"},{"term":"Aristarhos","score":0.3,"count":4,"kind":"entity"},{"term":"Asie","score":0.3,"count":4,"kind":"word"},{"term":"Byzantion","score":0.3,"count":3,"kind":"entity"},{"term":"Herakleides","score":0.3,"count":3,"kind":"word"},{"term":"Lakedaimonci","score":0.3,"count":3,"kind":"entity"},{"term":"Seuthos","score":0.3,"count":3,"kind":"entity"},{"term":"Seuthés","score":0.3,"count":7,"kind":"entity"},{"term":"Thráky","score":0.3,"count":3,"kind":"entity"},{"term":"Xenofon","score":0.3,"count":6,"kind":"entity"},{"term":"bohové","score":0.3,"count":6,"kind":"word"},{"term":"brány","score":0.3,"count":3,"kind":"word"},{"term":"dar","score":0.3,"count":3,"kind":"word"},{"term":"kořist","score":0.3,"count":5,"kind":"word"},{"term":"mzda","score":0.3,"count":6,"kind":"word"},{"term":"odměna","score":0.3,"count":7,"kind":"word"},{"term":"spravedlnost","score":0.3,"count":8,"kind":"word"},{"term":"vojsko","score":0.3,"count":9,"kind":"word"},{"term":"vojáci","score":0.3,"count":8,"kind":"word"},{"term":"žold","score":0.3,"count":3,"kind":"word"},{"term":"žoldnéři","score":0.3,"count":6,"kind":"word"},{"term":"Βυζάντιον","score":0.3,"count":5,"kind":"orig"},{"term":"Θίβρων","score":0.3,"count":3,"kind":"orig"},{"term":"Λακεδαιμόνιοι","score":0.3,"count":4,"kind":"orig"},{"term":"Μηδοσάδης","score":0.3,"count":5,"kind":"orig"},{"term":"Ξενοφῶντα","score":0.3,"count":7,"kind":"orig"},{"term":"Πέρινθον","score":0.3,"count":4,"kind":"orig"},{"term":"Σεύθην","score":0.3,"count":6,"kind":"orig"},{"term":"Σεύθου","score":0.3,"count":5,"kind":"orig"},{"term":"Τιμασίων","score":0.3,"count":4,"kind":"entity"},{"term":"Φρυνίσκος","score":0.3,"count":3,"kind":"orig"},{"term":"μισθὸν","score":0.3,"count":6,"kind":"orig"},{"term":"στράτευμα","score":0.3,"count":7,"kind":"orig"},{"term":"στρατιῶται","score":0.3,"count":8,"kind":"orig"},{"term":"χρήματα","score":0.3,"count":4,"kind":"orig"},{"term":"Ἀναξίβιος","score":0.3,"count":8,"kind":"orig"},{"term":"Ἀρίσταρχος","score":0.3,"count":3,"kind":"orig"},{"term":"Ἡρακλείδης","score":0.3,"count":6,"kind":"orig"},{"term":"Ὀδρυσῶν","score":0.3,"count":3,"kind":"orig"}]}}},"summaries":{"c0001":{"cs":"Po smrti Dareia se Kyrus snaží uchvátit trůn od svého bratra Artaxerxe tím, že tajně shromažďuje vojsko. Získává podporu matky Parysatidy, která ho osvobozuje z obvinění ze zrady, platí řecké hoplity prostřednictvím velitelů jako Klearchos a Aristippos, podplácí úředníky a využívá záminky jako obranu Miletu proti Tissaphernovi k náboru síly. Postupně posiluje své pozice v Malé Asii, přijímá řecké sbory a připravuje výpravu pod záminkou tažení proti Pisidům, zatímco ve skutečnosti míří proti bratrovi."},"c0002":{"cs":"Po smrti Kyra řečtí vojevůdci, zejména Klearchos, řeší kritickou situaci: informují se o Ariaiově útěku, nabízejí mu trůn výměnou za podporu a vysílají posly. Mezitím vojska shání potravu z dobytka a vyrábějí zbraně z materiálů na bojišti. Perští poslové žádají odevzdání zbraní, ale Řekové odmítají s odkazem na své vítězství. Po vyjednávání s Tissafarnem uzavírají příměří a dohodu o výměně zásob za bezpečný průchod. Klearchos zdůrazňuje, že zbraně jsou symbolem svobody a síly. Vojsko postupuje podél řeky Tigrid, získává zásoby od místních (fíkovníky, datle), odpočívá a přijímá Tissafarnovu nabídku návratu do Řecka výměnou za přísahu věrnosti, kterou stvrdí obětmi zvířat. Pokračují dále, udržují obezřetnost vůči Peršanům, staví tábory podle římského vzoru a dosahují města Sittaké u Tigridu, kde se připravují na další pochod."},"c0003":{"cs":"Po smrti Kyra mladšího a zradě barbarů se řečtí žoldnéři ocitají v zoufalé situaci: obklíčeni nepřátelskými kmeny a městy, bez vůdce, bez cest, bez zásob a daleko od domova. Xenofón, původně jen soukromý společník Proxena, se po poradě se Sókratem rozhodne vykonat božskou vůli po konzultaci s delfským orákulem a přidá se k výpravě Kyra mladšího proti perskému králi. Po Kyrově smrti a zradě barbarů se Řekové ocitají v hluboké úzkosti, ale Xenofón je povzbuzuje senem a projevem, aby se chopili iniciativy, zvolili nové vůdce a připravili se na boj s důvěrou v božskou pomoc a vlastní hodnotu. Navrhuje, aby vojsko vytvořilo ochranné čtvercové uspořádání (plaision) pro bezpečný přesun s náklady a ne bojeschopnými, přičemž Cheirisofos vede přední stranu, nejstarší velitelé boky a nejmladší (Xenofón a Timasión) zadní hlídku. Po schválení plánu se vojsko vydává na pochod, pálí přebytečné vozy a stany a dělí si zásoby. Brzy je přepaden Mithradátem s lehkou jízdou a lučištníky, což vede k neúspěšnému pronásledování Řeky kvůli jejich nedostatku účinné jízdy a lučištníků. Xenofón poté navrhuje využít Rhodské prakovníky a zajaté koně k vytvoření účinné protipěchotní obrany, což je přijato a vede k úspěšnému odražení dalšího útoku Mithradáta u řeky Zápates, kde Řekové postupují v pevném pořadí s náklady uprostřed. Stratégové, po vyslechnutí zpráv, zůstali nejistí ohledně směru pochodu, avšak usoudili, že je nutné projít horami do území Karduchů, protože po jejich překročení by bylo možné dosáhnout Arménie, kterou vládl bohatý a šťastný král Orontes, odkud by se dalo pokračovat libovolným směrem. Po oběti bohům, aby byla zvolena vhodná hodina pro pochod a aby se zabránilo překvapení nepřítelem v horských průsmycích, nařídili, aby se všichni po večeři připravili k odpočinku a následně pochodovali pouze na rozkaz."},"c0004":{"cs":"Řecké vojsko pod velením Xenofonta a Chirisofa postupuje horami, kde se snaží vyhnout konfliktu s Kardoúchy, kteří opouštějí svá obydlí a prchají do hor; Řekové berou jen nezbytné zásoby, aby nevyvolali nepřátelství, ale Kardoúchové neposlouchají výzvy k přátelskému průchodu. V noci jsou Řekové přepadeni při sestupu z vrcholu hory, kde Kardoúchové útočí kameny a šípy na zadní hlídky, což způsobuje ztráty a nutí vojsko k rychlému ústupu. Xenofon později vyjednává s Kardoúchy o vydání mrtvol a uzavírá příměří pod podmínkou, že nebudou vypalovat domy. Po přechodu řeky a úspěšném odražení útoku Kardoúchů vstupuje vojsko do Arménie, kde nachází úkryt v vesnici s bohatými zásobami a odpočívá po náročném pochodu skrz horstvo. Stratégové rozhodli, že není bezpečné zůstávat v táboře kvůli nočním ohňům a sněhu, a proto se rozhodli shromáždit vojsko znovu. Po silném sněžení, které zakrylo zbraně a znemožnilo pohyb, Xenofón rozdal dřevo na oheň, což povzbudilo ostatní k rozdělávání ohňů a používání místního tuku (řepkového, sezamového, mandlového a terebintového) jako náhražky oleje. Vojsko poté přešlo přes zasněžené pláně a hory, utrpělo ztráty na lidech i zvířatech kvůli extrémnímu chladu a nedostatku potravy, přičemž někteří trpěli hladem a omrzlinami. Po dosažení vesnice, kde byli přijati s pohostinností, se vojsko znovu vydalo na pochod, překonalo horské průsmyky a zaútočilo na nepřátelské pozice na vrcholu hory, kde Řekové zvítězili a pokračovali dále do země Chalybů a Táochů. Řecká vojska dosáhla hory Θήχης, odkud spatřila moře, což vyvolalo velký jásot. Xenofón s jezdci přispěchal na pomoc, když se ozvaly poplašné výkřiky kvůli domnělému nepřítelskému útoku. Po dosažení vrcholu se vojáci objímali se slzami, poté postavili mohylu z kamenů a věnovali na ní kořist včetně syrových hovězích kůží a zajatých předmětů. Řekové propustili svého průvodce s dary, poté pokračovali přes území Makrónů, kde postavili přechod přes řeku a uzavřeli příměří výměnou za rukojmí. Spoluprací s"},"c0005":{"cs":"Xenofón detailně popisuje logistiku zásobování vojska v nepřátelském území: navrhuje systematické sbírání pod dozorem, evidenci toho, kdo jde na kořist a kdo zůstává, posílení hlídek kolem tábora a přípravu vlastních lodí (získáním a opravou dlouhých lodí od Trapezúntů), pokud nepřijdou lodě od Cheirisófa. Dále podporuje společné stravování a stavbu loděnice pro vzájemnou výhodu a obranu. Řecká vojska poté dorazila do země Tibarenů, kde po obětování a poradě s věštci přijala dary od místních a zůstala 45 dní ve městě Cotyora, řecké kolonii Sinopy. Během pobytu obětovala bohům, pořádala průvody a gymnastické soutěže, zásobovala se z Paphlagonie a okolí, protože ve městě nebyla tržnice. Sinopští poslové varovali před násilným chováním Řeků vůči Cotyorům a žádali náhradu za škody, zatímco Xenofón obhajoval chování vojska jako nutnou obranu a zdůrazňoval přátelství s Řeky i nepřátelství vůči barbarům. Nakonec se rozhodlo plout po moři do Hellady, protože zemědělská cesta byla považována za příliš nebezpečnou kvůli nedostatku tržišť a obtížím s přechodem řek. Xenofón také obhajuje svá disciplinární opatření vůči vojákům, kteří porušili kázeň: trest byl podle něj spravedlivý a nutný pro zachování pořádku, nikoli urážlivý, ale nápravný – podobně jako lékař řeže nebo pálí pro dobro pacienta. Po trestech byla provedena očistná ceremonie (katharmós), ustanoveni soudci z lochagů a viníci potrestáni. Xenofón čelí obvinění ze zneužívání moci, ale odmítá je s tím, že nikoho nebil bez příčiny a že jeho činy byly motivovány starostí o vojáky a potřebou udržet disciplínu. Apeluje na vojáky, aby si pamatovali spravedlivé a dobré činy, nikoli jen ty špatné, a aby se vrátili k rozumu a pořádku."},"c0006":{"cs":"Po návratu do tábora se vojáci shromáždili a přijali přísné usnesení: kdo by se oddělil od vojska, bude potrestán smrtí a musí jít touž cestou jako dříve pod velením bývalých stratégů. Xenofón promluvil, že je nutné pochodovat pěšky, protože nejsou lodě a zásoby docházejí, a navrhl obětování bohům. Přestože se obětovalo několikrát, znamení (hierá) se neukázala, což vojáky znepokojovalo, zejména proto že už neměli zásoby a nebylo kde je nakoupit. Nakonec se rozhodli opustit tábor a vydat se na cestu, přičemž Xenofón je povzbudil, aby šli proti nepříteli, protože útěk by je vystavil pronásledování, zatímco útočná akce by mohla znamení bohů obnovit."},"c0007":{"cs":"Xenofón se pokouší vyjednat přepravu řeckého vojska přes Hellespont s námořním velitelem Anaxibiem, který přislíbí mzdu za převoz, ale nakonec ji nevyplatí a nařídí vojákům odevzdat zbraně a vybavení před odchodem. Tato zrada vyvolá mezi vojáky vztek kvůli nedostatku peněz na stravu, což vede k bouři a pokusu o násilné vniknutí do Byzantu, což způsobí paniku mezi obyvateli. Xenofón se snaží zabránit rabování a násilí tím, že vstupuje do davu a obnovuje pořádek. Mezitím se řeší alternativní možnost přepravy vojska do Asie přes Perinthu, kde by mohlo navázat spojenectví s Trákem Seuthem, který nabízí podporu a zásoby. Kapitola zachycuje napětí mezi velením a vojsky, krizi důvěry v sliby velitelů a snahu udržet disciplínu amid chaosu a nejistoty o dalším osudu vojska."}}}