},{"term":"truhlář","score":0.3,"count":2,"kind":"word"},{"term":"tvůrce","score":0.3,"count":2,"kind":"entity"},{"term":"tělo","score":0.3,"count":4,"kind":"word"},{"term":"umělec","score":0.3,"count":2,"kind":"entity"},{"term":"užitečnost","score":0.3,"count":4,"kind":"word"},{"term":"volba života","score":0.3,"count":2,"kind":"word"},{"term":"vzhled","score":0.3,"count":3,"kind":"word"},{"term":"řeka Léthe","score":0.3,"count":2,"kind":"word"},{"term":"špatnost","score":0.3,"count":3,"kind":"entity"},{"term":"Γύγου δακτύλιον","score":0.3,"count":2,"kind":"orig"},{"term":"γῆς","score":0.3,"count":3,"kind":"orig"},{"term":"μίμησιν","score":0.3,"count":3,"kind":"orig"},{"term":"μιμητὴς","score":0.3,"count":3,"kind":"orig"},{"term":"οὐρανοῦ","score":0.3,"count":4,"kind":"orig"},{"term":"ψυχή","score":0.3,"count":7,"kind":"orig"},{"term":"ψυχῇ","score":0.3,"count":4,"kind":"orig"},{"term":"ἀρετὴν","score":0.3,"count":4,"kind":"orig"},{"term":"Ὁμήρου","score":0.3,"count":3,"kind":"orig"}]}}},"summaries":{"c0001":{"cs":"V úvodní knize Ústavy se Sókratés setkává s Kephalem, který chválí stáří a bohatství jako prostředek k spravedlivému životu, poté vede dialog s Polemarchosem o nedostatečnosti definic spravedlnosti jako vracení dluhů nebo pomoci přátelům a škody nepřátelům, a nakonec se střetává s Thrásymachem, který tvrdí, že spravedlnost je výhodou silnějšího, což Sókratés vyvrací analogiemi z lékařství a kormidelnictví, kde odbornost slouží druhým, nikoli sobě."},"c0002":{"cs":"Glaukon pokračuje v dialógu s Sókrátem a zpochybňuje, zda je spravedlnost dobrá sama o sobě, rozdělující dobro na tři kategorie a tvrdíc, že spravedlnost je dobrá jen kvůli důsledkům, ilustruje to mýtem o Gygově prstenu neviditelnosti. Sókrates navrhuje nejprve zkoumat spravedlnost ve městě jako větším celku, popisuje vznik města z dělby práce a specializace, rozvíjí myšlenku ideálního státu a kritizuje nevhodné mýty o bohách, kteří by podle něj neměli být zobrazováni jako lživí, proměnliví či škodliví, protože Bůh je absolutně dobrý a neměnný."},"c0003":{"cs":"V knize 3 Ústavy Platón prostřednictvím Sókrata kritizuje tradiční básnické zobrazení bohů a podsvětí, které vyvolává strach a nesprávné představy o smrti, a navrhuje jejich úpravu či vyloučení z výchovy mladých strážců. Dále rozebírá vhodnou hudbu a rytmus pro ideální stát, zdůrazňující soulad řeči s hudbou, prostotu nástrojů a jejich vliv na duševní harmonii. Výchova musí pěstovat rozum, statečnost a ctnost prostřednictvím pečlivě vybraných příběhů, hudby a tělesné výchovy, aby vznikla vyvážená duše vhodná pro spravedlivý stát."},"c0004":{"cs":"V knize 4 Ústavy Sokrates s Glaukónem a Adeimantem rozebírá podstatu spravedlnosti prostřednictvím analogie mezi městem a duší. Argumentuje, že spravedlivý stát i jednotlivec jsou takové, kde každá třída (tvůrci, ochránci, vládci) resp. každá část duše (rozum, thumos, epithymetikon) plní svou vlastní úlohu bez přecházení do jiných funkcí. Takové uspořádání zajišťuje harmonii, která je základem ctnosti – moudrosti, statečnosti, umírněnosti a spravedlnosti samotné. Naopak nespravedlnost je vnitřní nepořádek, kdy jedna část usurpuje vládu, což vede ke zkaženosti. Vzdělání a správná výchova jsou klíčové pro udržení tohoto řádu."},"c0005":{"cs":"V páté knize Ústavy diskutují Sókratés a Glaukón o tom, že ženy i muži, pokud jsou přirozeně vhodní, by měli dostávat stejné vzdělání v hudbě a gymnastice, sdílet stejné povinnosti včetně vojenské služby a společně vychovávat děti, přičemž odmítají námitky proti nahotě ve cvičení jako povrchní. Dále rozebírají rozdíl mezi poznáním (epistémé), které se vztahuje k tomu, co skutečně jest (to ón), a míněním (dóxa), které se týká mezi-stavu (metaxy) – věcí, které jsou zároveň tím a nejsou tím – a zdůrazňují, že pouze filosofové, kteří se obracejí k tomu, co skutečně jest, jsou schopni pravého poznání."},"c0006":{"cs":"Sokrates pokračuje v analýze vztahu mezi smyslovým vnímáním a intelektuálním poznáním, přičemž používá analogii zraku a světla: stejně jako zrak potřebuje světlo k vidění, tak duše potřebuje intelektuální světlo – ideu dobra – k poznávání pravdy. Dělí poznání na čtyři stupně: eikasia (představy), pistis (víra ve smyslové objekty), dianoia (diskurzivní myšlení pomocí hypotéz) a noesis (čisté intuitivní poznání idejí). Zdůrazňuje, že pravé poznání (noesis) pochází z dobra jako nejvyšší příčiny, která není jen zdrojem poznání, ale i bytosti a reality samotné, a proto je dobro hodno nejvyšší úcty."},"c0007":{"cs":"V knize 7 Ústavy Platón prostřednictvím Sókratese rozvíjí alegorii jeskyně, kde vězni vidí jen stíny a považují je za skutečnost. Osvobozený vězeň postupně poznává skutečné předměty, odrazy, objekty a nakonec slunce jako symbol dobra a pravdy. Tento proces ilustruje stupně poznání: eikasia, pistis, dianoia, noesis. Vzdělání není vkládání poznání, ale otočení duše k pravdě pomocí matematiky a dialektiky. Ti, kdo poznají dobro, mají povinnost se vrátit do jeskyně a vzdělávat ostatní, i když budou považováni za blázny. Filosofové musí po dlouhém výcviku vládnout ne ze touhy po moci, ale z povinnosti uskutečnit dobro ve státě."},"c0008":{"cs":"Sokrates rozebírá, jak aristokracie degeneruje v timokracii kvůli špatné výchově a sňatkům, následně v oligarchii, demokracii a nakonec v tyranii. Každý přechod je způsoben vnitřními rozmary duše a společnosti, nikoli vnějšími příčinami. Tyranie vzniká z nadměrné svobody v demokracii a vede k absolutnímu otroctví."},"c0009":{"cs":"Sokrates zkoumá vývoj tyrannického člověka z demokratického typu, jeho charakter ovládaný silnými, nezkrotnými tužbami – zejména těmi spojenými se spánkem, opilstvím a násilím – kdy rozum ztrácí kontrolu nad duší. Takový člověk se nebojí ničeho, je vyčerpán nekonečnými touhami, uchyluje se ke krádežím a násilí, žije ve strachu a úzkosti, a nakonec se stává otrokem svých vlastních vášní, i když se zdá být pánem ostatních."},"c0010":{"cs":"V desáté knize Ústavy Sókrates a Glaukón rozebírají problém mimesis (imitace) v umění, zejména v tragédii a malířství, která je dvakrát vzdálená od pravdy a posiluje iracionální části duše. Následně Platón líčí kosmologický mýtus o osmi nebeských sférách, Moirach a výběru nových životů duší po smrti, včetně pití z řeky Léthé a nutnosti filosofického života pro spravedlnost a štěstí."}}}