count":1,"kind":"entity"},{"term":"Pentheus","score":0.3,"count":1,"kind":"entity"}]},"c0013":{"terms":[{"term":"Agavé","score":1.0,"count":6,"kind":"entity"},{"term":"Kadmos","score":1.0,"count":8,"kind":"entity"},{"term":"Pentheus","score":1.0,"count":4,"kind":"entity"},{"term":"bakchantické šílenství","score":1.0,"count":1,"kind":"word"},{"term":"božská pomsta","score":1.0,"count":1,"kind":"word"},{"term":"lví hlava","score":1.0,"count":1,"kind":"word"},{"term":"poznání vraždy","score":1.0,"count":1,"kind":"word"},{"term":"tragické poznání","score":1.0,"count":1,"kind":"word"},{"term":"ΚΆΔΜΟΣ","score":0.69,"count":5,"kind":"orig"},{"term":"ἈΓΑΎΗ","score":0.48,"count":5,"kind":"orig"},{"term":"Bakchantky","score":0.33,"count":6,"kind":"entity"},{"term":"Dionýsos","score":0.33,"count":6,"kind":"entity"},{"term":"rodinná tragédie","score":0.33,"count":2,"kind":"word"},{"term":"Θήβαις","score":0.33,"count":2,"kind":"orig"},{"term":"θηρῶν","score":0.33,"count":2,"kind":"orig"},{"term":"Théby","score":0.32,"count":4,"kind":"entity"},{"term":"Achéron","score":0.3,"count":1,"kind":"entity"},{"term":"Arés","score":0.3,"count":1,"kind":"entity"},{"term":"Harmonia","score":0.3,"count":1,"kind":"entity"},{"term":"Harmonía","score":0.3,"count":1,"kind":"entity"},{"term":"Lev","score":0.3,"count":1,"kind":"entity"},{"term":"Sparta","score":0.3,"count":1,"kind":"entity"},{"term":"bakchické šílenství","score":0.3,"count":1,"kind":"word"},{"term":"božská svévole","score":0.3,"count":1,"kind":"word"},{"term":"božský hněv","score":0.3,"count":1,"kind":"word"},{"term":"hostina","score":0.3,"count":1,"kind":"word"},{"term":"loučení","score":0.3,"count":1,"kind":"word"},{"term":"poznání pravdy","score":0.3,"count":1,"kind":"word"},{"term":"proměna vnímání","score":0.3,"count":1,"kind":"word"},{"term":"pronásledování","score":0.3,"count":1,"kind":"word"},{"term":"rodina","score":0.3,"count":1,"kind":"word"},{"term":"smilování","score":0.3,"count":1,"kind":"word"},{"term":"vinna","score":0.3,"count":1,"kind":"word"},{"term":"vražda syna","score":0.3,"count":1,"kind":"word"},{"term":"vyhnanství","score":0.3,"count":1,"kind":"word"},{"term":"ztráta cti","score":0.3,"count":1,"kind":"word"},{"term":"zármutek","score":0.3,"count":1,"kind":"word"},{"term":"úkryt","score":0.3,"count":1,"kind":"word"},{"term":"ΑΓΑΎΗ","score":0.3,"count":1,"kind":"orig"},{"term":"Αὐτονόην","score":0.3,"count":1,"kind":"orig"},{"term":"ΔΙΌΝΥΣΟΣ","score":0.3,"count":3,"kind":"orig"},{"term":"Ζηνός","score":0.3,"count":1,"kind":"orig"},{"term":"Πενθεῖ","score":0.3,"count":1,"kind":"orig"},{"term":"ΧΟΡΌΣ","score":0.3,"count":2,"kind":"orig"},{"term":"βακχείῳ ποδὶ","score":0.3,"count":1,"kind":"orig"},{"term":"βωμοὺς","score":0.3,"count":1,"kind":"orig"},{"term":"γέροντα","score":0.3,"count":1,"kind":"orig"},{"term":"γενήσῃ","score":0.3,"count":1,"kind":"orig"},{"term":"δαίμονων","score":0.3,"count":1,"kind":"orig"},{"term":"δαῖτα","score":0.3,"count":1,"kind":"orig"}]}}},"summaries":{"c0001":{"cs":"Dionýsos přichází do Théb jako syn Dia a Semele, připomíná svůj božský původ a trest, který uložil matčiným sestrám za jejich nevěru a pomluvy ohledně jeho narození. Vysvětluje, že je bůh a žádá uznání své božské přítomnosti prostřednictvím bakchantických rituálů."},"c0002":{"cs":"Chór oslavuje Dionýsa jako boha vína a extáze, popisuje jeho zázračné narození z Diova stehna po smrti Semele, jeho ochranu před Hérou a následuje jej bakchantky v divokém horském rituálu s vavřínem, kožešinami, tancem a zpěvem, spojeným s přírodními živly jako mlékem, vínem a medem."},"c0003":{"cs":"Kadmos žádá Teiresia o radu ohledně Dionýsova kultu, včetně rituálů s thyrsy a vavřínovými věnci, a oba staří muži vyjadřují touhu účastnit se tance. Teiresias zdůrazňuje, že bůh nečiní rozdíl mezi mladými a starými. Následuje Pentheova zpráva o ženách opouštějících domovy a oddávajících se divokému kultu na horách, kde uctívají Dionýsa a připisují mu božský původ, zatímco kritizují cizince, který se za boha vydává."},"c0004":{"cs":"Chór ve čtyřech strofách vzývá Dionýsa (Brómia) jako boha vína, šílenství a extáze, který osvobozuje od starostí prostřednictvím opojení a bacchantického tance. Kontrastuje pomíjivý lidský život s věčnou božskou přítomností, odkazuje na Kypr jako sídlo Afrodity a lásky, a zdůrazňuje, že ti, kdo odmítají Dionýsův kult, odmítají radost, štěstí a svobodu od rozumu. Bohu je milý mír, štěstí a nezatížená radost z vína, zatímco kritizuje nadměrnou moudrost a pýchu."},"c0005":{"cs":"V této scéně služebník přivádí Dionýsa jako zajatce před Penthea, který ho důkladně vyslýchá. Dionýs se představuje jako cizinec z Lýdie, syna Zeuse a Semele, a odmítá být považován za obyčejného smrtelníka. Vysvětluje, že jeho kult přináší božské šílenství (orgie), které je tajné a nevhodné pro nevěřící. Pentheus pochybnosti o Dionýsově božství vede k hádce o náboženské pravosti, autoritě krále a vztahu mezi řeckými a cizími kulty. Dionýs nakonec varuje, že Pentheusova neúcta k bohu povede k jeho vlastní zkáze prostřednictvím božského trestu."},"c0006":{"cs":"Chorální zpěv vzývá Dionýsa jako boha zrozeného u řeky Achelous, jehož síla se projevuje v divokých bakchantkách a rituálním šílenství, které postihuje odpůrce boha. Zároveň se odkazuje na mýtus o Pentheovi, jehož monstrózní původ symbolizuje chaos, který Dionýs přináší, a na Orfeovu moc nad přírodou prostřednictvím hudby, která sjednocuje lesy, zvířata i lidi v extatickém tanci uctívání boha vína."},"c0007":{"cs":"Dionýs se hlásí jako syn Semele a Dia, vyzývá bakchantky k uctívání a popisuje svou božskou moc, včetně schopnosti způsobit zemětřesení a zapálit město Théb. Sbor reaguje s úctou, strachem a náboženským nadšením, uznává jeho božskou přítomnost a moc nad přírodou i osudem lidí."},"c0008":{"cs":"Chór Bakchantek vyjadřuje extatickou radost z tance v přírodě, lovu a spojení s božskou silou Dionýsa, která překonává lidské zákony a smrtelnost. Střídá se s otázkou po skutečné moudrosti a kráse v očích bohů. Následuje reflexe nad lidským štěstím: někteří uniknou bouři a najdou přístav, jiní překonají námahu a dosáhnou štěstí, zatímco mnoho nadějí zůstává nesplněno nebo končí smrtí. Závěrem chór blahopřeje těm, jejichž život je šťastný a požehnaný."},"c0009":{"cs":"Dionýs přesvědčuje nevěřícího Penthea, že nyní vidí božskou pravdu – dvojí slunce, sedmibranné Théby a býčí znamení – zatímco Pentheus popisuje své halucinace pod vlivem božského šílenství. Dialog směřuje k Pentheovu přijetí bakchického extatického stavu a předznamenává jeho tragický osud v rukou příbuzných."},"c0010":{"cs":"Chorální zpěv v Bakchantkách líčí divoký hon na báčného boha Dionýsa, kterého bacchantky pronásledují jako šílené zvíře či monstrum, zatímco vyjadřují svou oddanost rituálnímu šílenství a božské spravedlnosti proti nevěřícím, zejména proti Pentheovi, synu Echiona. Zpěv dále vyzývá Dionýsa, aby se zjevil v děsivé podobě – jako býk, drak, ohnivý had nebo lev – aby svým zjevem postavil past na šílené bakchantky, které pronásleduje lovec, což symbolizuje střet mezi rozumem a božským šílenstvím."},"c0011":{"cs":"Posel přichází s zprávou o smrti Penthea, syna Agáve, kterého bakchantky roztrhaly na hoře Kithairon během rituálu vyvolaného Dionýsem. Agáve, posedlá božským šílenstvím, nepozná svého syna a věří, že zabíjí lva. Nakonec nese jeho useknutou hlavu jako trofej na thyrsu, zatímco sbor zdůrazňuje úctu k bohům jako nejvyšší ctnost."},"c0012":{"cs":"V tomto úryvku z Bakchantek vede sbor dialog s Agavou, matkou Penthea, která přináší ulovené zvíře – mladého býka nebo lva – jako oběť Dionýsovi. Sbor komentuje její činy, ptá se na původ lovu a oslavuje sílu a božské šílenství bakchantky, přičemž zdůrazňuje zjevnost a velikost úlovku jako znamení božské moci a rituální správnosti."},"c0013":{"cs":"Agavé hrdě předkládá Kadmovi úlovek lva, který sama ulovila holýma rukama. Kadmos jí postupně odhaluje hrůznou pravdu: že tím ‚lvem‘ byl její vlastní syn Pentheus, kterého zabila v bakchickém šílenství. Agavé nejprve zapírá, poté se s tímto poznáním vyrovnává s hlubokým zármutkem."}}}