,{"term":"Židé","score":0.56,"count":10,"kind":"entity"},{"term":"Ἰουδαίων","score":0.56,"count":10,"kind":"orig"},{"term":"Titus","score":0.55,"count":9,"kind":"entity"},{"term":"Τίτος","score":0.55,"count":9,"kind":"orig"},{"term":"φρούριον","score":0.55,"count":8,"kind":"orig"},{"term":"Ῥωμαίοις","score":0.55,"count":9,"kind":"orig"},{"term":"πῦρ","score":0.54,"count":7,"kind":"orig"},{"term":"σικαρίων","score":0.53,"count":4,"kind":"orig"},{"term":"Alexandrie","score":0.49,"count":8,"kind":"entity"},{"term":"Ἐλεάζαρος","score":0.49,"count":8,"kind":"orig"},{"term":"Vespasian","score":0.48,"count":7,"kind":"entity"},{"term":"osvobození","score":0.48,"count":7,"kind":"word"},{"term":"vláda","score":0.48,"count":7,"kind":"word"},{"term":"Židovská válka","score":0.44,"count":8,"kind":"word"},{"term":"Ῥωμαίων","score":0.44,"count":8,"kind":"orig"},{"term":"Ῥωμαῖοι","score":0.44,"count":8,"kind":"entity"},{"term":"Antiochos","score":0.43,"count":4,"kind":"word"},{"term":"Οὐεσπασιανὸς","score":0.41,"count":6,"kind":"orig"},{"term":"θάνατος","score":0.4,"count":3,"kind":"entity"},{"term":"νεὼν","score":0.4,"count":3,"kind":"orig"},{"term":"φρουρίου","score":0.4,"count":3,"kind":"orig"},{"term":"Antiochie","score":0.39,"count":5,"kind":"word"},{"term":"Flavius Josephus","score":0.39,"count":7,"kind":"entity"},{"term":"Masáda","score":0.39,"count":5,"kind":"entity"},{"term":"obléhání","score":0.39,"count":7,"kind":"word"},{"term":"válka","score":0.39,"count":7,"kind":"word"},{"term":"Řím","score":0.39,"count":5,"kind":"entity"},{"term":"θεός","score":0.37,"count":6,"kind":"entity"},{"term":"Antiochia","score":0.36,"count":4,"kind":"entity"},{"term":"odpor proti Římanům","score":0.34,"count":5,"kind":"word"},{"term":"τεῖχος","score":0.33,"count":6,"kind":"orig"},{"term":"otroctví","score":0.32,"count":3,"kind":"word"},{"term":"triumf","score":0.32,"count":3,"kind":"word"},{"term":"Γερμανῶν","score":0.32,"count":3,"kind":"orig"},{"term":"γυναῖκας","score":0.32,"count":3,"kind":"orig"},{"term":"ἀπόστασιν","score":0.32,"count":3,"kind":"orig"},{"term":"Eléazar","score":0.31,"count":4,"kind":"entity"},{"term":"Herodes","score":0.31,"count":4,"kind":"word"},{"term":"duše","score":0.31,"count":4,"kind":"word"},{"term":"smrt","score":0.31,"count":5,"kind":"word"},{"term":"Μασάδαν","score":0.31,"count":4,"kind":"orig"}]}}},"summaries":{"root":{"cs":"Židovská válka proti Římanům je sedmiknihová historická studie Flavius Josephus, která zachycuje průběh židovského povstání proti Římské říši v letech 66–70 n. l. Dílo je založeno na osobním zkušenostech autora, který byl významným vůdcem v obléhání Iotapaty a později přešel na stranu Římanů. Josephus se snaží o objektivní a pravdivé vyprávění, kritizuje předchozí zprávy a zdůrazňuje božský zásah, osudovost a náboženskou věrnost. Struktura sleduje politické přechody, vojenské akce, vnitřní rozdělení mezi židovskými skupinami a tragický konec Jeruzaléma. Knihovna má překlad do češtiny."},"c0001":{"cs":"Kniha 1 slouží jako úvodní prohlášení Flavia Josepha k jeho dílu o židovské válce proti Římanům. Autor vysvětluje své motivy: snahu o objektivní a pravdivé vyprávění, které se opírá o osobní zkušenosti a původní zdroje. Kritizuje nespolehlivé historické zprávy, které jsou ovlivněny lichotkou, nenávistí nebo neznalostí. Josephus se hlásí k ideálu historika, který píše s nasazením, věrností faktům a bez zatajování. Zaměřuje se na podrobné líčení války, zároveň shrnuje dřívější dějiny, včetně Makabejského povstání a římského zásahu, aby poskytl kontext pro následující události."},"c0002":{"cs":"Kapitola se zabývá komplexním přechodem moci po smrti Heroda Velikého, kdy se jeho synové Archelaos a Antipas snaží získat vládu nad královstvím. Římský císař Kajus rozhoduje o rozdělení území, což však nezadrží napětí. Zároveň se objevují falešní nástupci, jako je podvodný Alexander, a politické intriky v Římě. V Judě se rozhoří odpor proti římskému vládnutí, způsobený násilnými akcemi správců, zneužíváním moci a náboženskými konflikty. Josephus zdůrazňuje následky kruté vlády, náboženské rozdělení mezi farizejci, sadukány a essény, a konečně přechod k vojenskému odporu, který se vyšplhá do celonárodní války."},"c0003":{"cs":"Kapitola se zabývá klíčovými vojenskými událostmi v Galileji a obléháním města Iotapaty, kde Židé odolávají římskému útoku s vysokou odvahou a organizací. Josephus popisuje obranné uspořádání, použití vojenských strojů, jako je krius, a náročné boje, při nichž Římané trpí ztrátami i při úspěchu. Zaznamenává sebevraždy v obléhaném městě, napětí mezi vůdci a rozhodnutí o osudu, včetně Josephova přechodu na stranu Římanů. Zároveň se objevují filozofické a náboženské reflektivní momenty o smrti, osudu, božském zásahu a morální odpovědnosti. Kapitola ukazuje konflikt mezi odvahou a zoufalstvím, mezi věrností vlasti a přežitím, a zároveň zachycuje přechod od odporu k kapitulaci."},"c0004":{"cs":"Kapitola se soustředí na poslední fáze Židovské války, konkrétně na obléhání Jeruzaléma Římany pod vedením Tituse a Vespasianu. Popisuje intenzivní boje v úzkých ulicích, použití vojenských strojů a překvapivé útoky, které vedou k zničení města. Zároveň se ukazuje tragický vnitřní rozpad společnosti: občanská válka mezi skupinami, zneužívání svatyně, násilí, zradníci a ztráta morálního řádu. Josephus zdůrazňuje, že osud města je nevyhnutelný, protože vnitřní rozdělení a zneužívání moci zničily schopnost jednotné obrany. Konečně se město vzdává, přičemž přeživší jsou zatčeni nebo zabití."},"c0005":{"cs":"Kapitola popisuje tragický vývoj v Jeruzalémě během Židovské války, kdy se vnitřní konflikty mezi vůdci jako Jan a Simon přeměňují v násilnou stáši. Boj o kontrolu nad městem a chrámem způsobuje zničení svatého místa, ztrátu lidské důstojnosti a hladové utrpení. Přestože Římané pod vedením Titu připravují útok, hlavní příčinou pádu města je nejen vojenská síla, ale i vnitřní rozpad, korupce a ztráta jednoty. Josephus zdůrazňuje, že válka je zároveň božským trestem za hříchy a neuposlech, a vyzývá k repentanci, zatímco popisuje extrémní utrpení, sebevraždy a ztrátu morálního řádu."},"c0006":{"cs":"Kapitola představuje závěrečnou fázi Židovské války, kdy Římané po dlouhém obléhání dobyli Jeruzalém. Město bylo zničeno, chrám spálen, obyvatelstvo zabité, zraněné nebo zatčeno. Josephus popisuje extrémní utrpení, hlad, násilí, ztrátu morálky a dokonce dětobojství. Židovské vůdce se rozdělují, vnitřní rozdory oslabují odpor. Přestože Titus původně chtěl zachovat chrám, vojáci ho zničí. Josephus zdůrazňuje osudovost války jako božského trestu za hříchy města. Konec je popsán jako tragédie, kdy zničené město symbolizuje konec národní identity a duchovního života."},"c0007":{"cs":"Kniha 7 dokumentuje konec židovské války proti Římanům, s důrazem na zničení Jeruzaléma a masovou sebevraždu jeho obyvatel. Po pádu města se římské vojsko vydává do města, kde najde pouze zničené hradby, spálené domy a těla mrtvých. Židovští bojovníci, včetně vůdců jako Eléazar, rozhodnou o sebevraždě, aby se vyhnuli otroctví a hanbě. Tento akt je motivován náboženskou vírou v osvobození duše a ctností svobody. Josephus popisuje i další události v Egyptě a Kyréně, kde došlo k masakru Židů, a kritizuje násilí, které způsobilo zánik jejich společnosti. Zároveň se zabývá osudem vůdců, jako je Simona z Giora, a významem vítězství pro Římanův triumf."}}}