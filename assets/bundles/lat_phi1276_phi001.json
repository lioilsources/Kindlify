ity"},{"term":"Laribus","score":0.52,"count":3,"kind":"orig"},{"term":"Tentyra","score":0.52,"count":3,"kind":"entity"},{"term":"moralita","score":0.5,"count":6,"kind":"word"},{"term":"ztráta majetku","score":0.4,"count":3,"kind":"word"},{"term":"kritika společnosti","score":0.38,"count":4,"kind":"word"},{"term":"Cantaber","score":0.34,"count":2,"kind":"orig"},{"term":"Cretonius","score":0.34,"count":2,"kind":"orig"},{"term":"Cybeles","score":0.34,"count":2,"kind":"orig"},{"term":"Euros","score":0.34,"count":2,"kind":"orig"},{"term":"Florae","score":0.34,"count":2,"kind":"orig"},{"term":"Hercules","score":0.34,"count":2,"kind":"entity"},{"term":"Molossi","score":0.34,"count":2,"kind":"entity"},{"term":"Ombos","score":0.34,"count":2,"kind":"orig"},{"term":"Pyrrhus","score":0.34,"count":2,"kind":"entity"},{"term":"Stoicus","score":0.34,"count":2,"kind":"orig"},{"term":"Tarpeia","score":0.34,"count":2,"kind":"entity"},{"term":"Titan","score":0.34,"count":2,"kind":"orig"},{"term":"galli","score":0.34,"count":2,"kind":"orig"},{"term":"kritika současnosti","score":0.34,"count":2,"kind":"word"},{"term":"lidská hloupost","score":0.34,"count":2,"kind":"word"},{"term":"právo","score":0.34,"count":2,"kind":"word"},{"term":"verre","score":0.34,"count":2,"kind":"orig"},{"term":"výchova","score":0.34,"count":2,"kind":"word"},{"term":"Aiax","score":0.33,"count":3,"kind":"entity"},{"term":"nespravedlnost","score":0.33,"count":3,"kind":"word"},{"term":"Cereris","score":0.3,"count":2,"kind":"orig"},{"term":"Ceres","score":0.3,"count":3,"kind":"entity"},{"term":"Fortunae","score":0.3,"count":2,"kind":"orig"},{"term":"Iuppiter","score":0.3,"count":3,"kind":"entity"},{"term":"Mars","score":0.3,"count":2,"kind":"entity"},{"term":"Prometheus","score":0.3,"count":2,"kind":"entity"},{"term":"chudoba","score":0.3,"count":3,"kind":"word"},{"term":"majetek","score":0.3,"count":2,"kind":"word"},{"term":"moc","score":0.3,"count":3,"kind":"word"},{"term":"spravedlnost","score":0.3,"count":3,"kind":"word"},{"term":"trest","score":0.3,"count":2,"kind":"word"},{"term":"zneužívání","score":0.3,"count":3,"kind":"word"}]}}},"summaries":{"root":{"cs":"Saturae jsou pět knih satirických epigramů latinského básníka Juvenala, které analyzují morální a společenský rozpad římského světa. Každá kniha se zabývá různými aspekty lidského chování – od korupce a zneužívání moci přes ztrátu ctnosti a manželskou nevěru až po nespravedlnost právního systému a ztrátu důvěry v božskou pomstu. Autor využívá mytologické příklady, historické reference a ironii k vyjádření absurdity lidské ambice a povrchního života. Knihovna má překlad do češtiny."},"c0001":{"cs":"První kniha Saturae Juvenala představuje ostře kritický pohled na římskou společnost, jejíž morální a politický úpadek je zobrazen přes satirické obrazy života, závislosti, korupce a falešné zbožnosti. Kritizuje se zneužívání moci, závislost klientů na bohatých patronech, ztráta ctnosti a skutečné spravedlnosti. Zároveň se objevuje kritika luxusu, zbytečné nákladnosti, zneužívání obětí a ztráty starých tradic. Autor se obrací k útěku do ústraní, kde by mohl být v klidu, a zároveň vyjadřuje znechucení z nespravedlivosti, která vládne ve městě. Témata zahrnují společenský řád, politiku, spravedlnost, etiku, bohatství a morální úpadek."},"c0002":{"cs":"Kapitola druhé knihy Juvenalovy Satury vypráví o ideálním zlatém věku, kdy pod vládou Saturna žili lidé v čistotě a jednoduchosti, bez bohatství, práva a zákonů. Tento období je vystaveno kontrastu s rozpadem morálky v římské společnosti, kde se objevují manželská nevěra, korupce, závislost na bohatství a zneužívání právních a politických struktur. Autor kritizuje ztrátu ctnosti, zneužívání manželství, závislost na zábavě a náboženských rituálech, přičemž používá ironii, grotesku a příběhy z mytologie k vyjádření nespravedlivosti a zbytečného utrpení. Zároveň se zabývá zneužíváním vědy, proroctví a náboženství pro podvod a manipulaci."},"c0003":{"cs":"Kapitola z knihy 3 Saturai Juvenala představuje rozsáhlou satirickou kritiku společenského a kulturního úpadku v římské společnosti. Autor upozorňuje na ztrátu duchovní hodnoty umění, kdy básníci prodávají svá díla jako zboží a závisí na veřejném ocenění. Kritizuje se zneužívání právního systému, kde právníci získávají výhody z korupce a závisí na bohatství, nikoli na spravedlnosti. Zároveň se vysmívá nesmyslnému významu rodových původů a mytologických předků, zatímco skutečná ctnost je dána skutky, ne původem. Kritizuje se i ztráta osobní svobody, závislost na osudu a náhodě, až do případu, kdy se z řečníka stane senátor a z senátora řečník. Závěrem se vyzývá k morální pevnosti, spravedlnosti a odpovědnosti ve veřejném životě."},"c0004":{"cs":"Kapitola 4 Saturai Juvenala je satirickým přehledem lidského chování, zaměřeným na kritiku moci, bohatství a iluzí o spravedlnosti. Autor ztotožňuje svého hrdinu s Demokritem, který se smál světu, a ukazuje, jak i nejvýznamnější vládci jsou zároveň předmětem smíchu. Zvláštní pozornost věnuje pádu Sejana, který je zatčen, vystaven a zabit, zatímco dav se těší z jeho hanby. Text kritizuje závislost na bohatství, ztrátu ctnosti, fyzický a duševní rozpad v důchodu, zároveň se dotýká osudu, smrti a nespravedlivosti. Používá příklady z mytologie (Achilles, Priamos, Cassandra) a historie (Hannibal, Pompeius, Croesus) k ukázání, že i největší vítězové jsou nakonec zničeni osudem."},"c0005":{"cs":"Kapitola 5 Juvenalovy Saturae je drsnou satirou na morální a společenský rozpad římského světa, který se projevuje v korupci, zneužívání svatých věcí a ztrátě důvěry v spravedlnost. Autor kritizuje nespravedlivé tresty, kdy zločin může být odměněn korunou, zatímco nevinný trpí křížem. Zdůrazňuje, že i myšlenka zla je trestána vnitřním výčitkem, bolestí a nočními můrami. Porovnává ideální minulost, kdy lidé žili v jednoduchosti a spravedlnosti pod vládou Saturna, s dekadencí dnešní doby, kdy zločiny jsou běžné a božská spravedlnost se zdá pomalá a neúčinná. Kritizuje i náboženské rituály, které jsou bez významu bez skutečné morálky, a vysmívá se závislosti na bohatství, násilí a zneužívání moci. Zároveň se dotýká otázek o lidské povaze, výchově a zodpovědnosti rodičů, které mohou vést k nekonečnému rozpadu rodiny i společnosti."}}}