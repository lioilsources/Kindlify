0.41,"count":3,"kind":"orig"},{"term":"obžaloba","score":0.41,"count":3,"kind":"word"},{"term":"stáří","score":0.41,"count":3,"kind":"word"},{"term":"Cicero","score":0.4,"count":4,"kind":"entity"},{"term":"vzdělání","score":0.4,"count":4,"kind":"word"},{"term":"moudrost","score":0.37,"count":5,"kind":"word"},{"term":"osvobození","score":0.36,"count":4,"kind":"word"},{"term":"Anaxagoras","score":0.35,"count":3,"kind":"entity"},{"term":"Demosthenes","score":0.35,"count":3,"kind":"entity"},{"term":"gloria","score":0.35,"count":3,"kind":"orig"},{"term":"soudní proces","score":0.35,"count":3,"kind":"word"},{"term":"Aegyptum","score":0.33,"count":2,"kind":"orig"},{"term":"Amphiaraos","score":0.33,"count":2,"kind":"entity"},{"term":"Amphiaraum","score":0.33,"count":2,"kind":"orig"},{"term":"C. Afrania","score":0.33,"count":2,"kind":"orig"},{"term":"C. Decianus","score":0.33,"count":2,"kind":"entity"},{"term":"C. Licinius Hoplomachus","score":0.33,"count":2,"kind":"entity"},{"term":"C. Norbanus","score":0.33,"count":2,"kind":"entity"},{"term":"Chrysippus","score":0.33,"count":2,"kind":"entity"},{"term":"Isocrates","score":0.33,"count":2,"kind":"orig"},{"term":"P. Furium","score":0.33,"count":2,"kind":"orig"},{"term":"P. Scipio Aemilianus","score":0.33,"count":2,"kind":"orig"},{"term":"P. Seruilius","score":0.33,"count":2,"kind":"entity"},{"term":"Platón","score":0.33,"count":2,"kind":"entity"},{"term":"Salamina","score":0.33,"count":2,"kind":"entity"},{"term":"T. Caelius","score":0.33,"count":2,"kind":"entity"}]},"c0009":{"terms":[{"term":"krutost","score":1.0,"count":6,"kind":"word"},{"term":"luxus","score":1.0,"count":5,"kind":"word"},{"term":"morální pád","score":1.0,"count":2,"kind":"word"},{"term":"nenávist","score":1.0,"count":2,"kind":"word"},{"term":"násilí","score":1.0,"count":13,"kind":"word"},{"term":"vláda","score":1.0,"count":6,"kind":"word"},{"term":"válka","score":1.0,"count":2,"kind":"word"},{"term":"zločin","score":1.0,"count":4,"kind":"word"},{"term":"zrad