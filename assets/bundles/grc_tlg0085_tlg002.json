},{"term":"ΧΟΡΌΣ","score":0.61,"count":4,"kind":"orig"},{"term":"Bitva u Salamíny","score":0.39,"count":1,"kind":"entity"},{"term":"Mýsos","score":0.39,"count":1,"kind":"entity"},{"term":"Persepolis","score":0.39,"count":1,"kind":"entity"},{"term":"bolest","score":0.39,"count":1,"kind":"word"},{"term":"rituál","score":0.39,"count":1,"kind":"word"},{"term":"smutek","score":0.39,"count":1,"kind":"word"},{"term":"válečný zmar","score":0.39,"count":1,"kind":"word"},{"term":"ztráta slávy","score":0.39,"count":1,"kind":"word"},{"term":"řecký tragický hlas","score":0.39,"count":1,"kind":"word"},{"term":"Δοτάμας","score":0.39,"count":1,"kind":"entity"},{"term":"Πελάγων","score":0.39,"count":1,"kind":"orig"},{"term":"Σαλαμινιάσι","score":0.39,"count":1,"kind":"orig"},{"term":"Σουσισκάνης","score":0.39,"count":1,"kind":"entity"},{"term":"Σούσας","score":0.39,"count":1,"kind":"orig"},{"term":"Φαρανδάκης","score":0.39,"count":1,"kind":"orig"},{"term":"Ψάμμις","score":0.39,"count":1,"kind":"entity"},{"term":"βεβᾶσι","score":0.39,"count":1,"kind":"orig"},{"term":"βελέεσσιν","score":0.39,"count":1,"kind":"orig"},{"term":"βόα","score":0.39,"count":1,"kind":"orig"},{"term":"γόοι","score":0.39,"count":1,"kind":"orig"},{"term":"δαιμόνες","score":0.39,"count":1,"kind":"orig"},{"term":"θησαυρὸν","score":0.39,"count":1,"kind":"orig"},{"term":"μέλαινα","score":0.39,"count":1,"kind":"orig"},{"term":"ναύφρακτον","score":0.39,"count":1,"kind":"entity"},{"term":"πεπλήγμεθʼ","score":0.39,"count":1,"kind":"orig"},{"term":"στέρνʼ","score":0.39,"count":1,"kind":"orig"},{"term":"στολᾶς","score":0.39,"count":1,"kind":"orig"},{"term":"ἀρωγῶν","score":0.39,"count":1,"kind":"orig"},{"term":"ἄρασσε","score":0.39,"count":1,"kind":"orig"},{"term":"Ἀγδαβάτας","score":0.39,"count":1,"kind":"entity"},{"term":"Ἀρης","score":0.39,"count":1,"kind":"orig"},{"term":"Ἄρης","score":0.39,"count":1,"kind":"entity"},{"term":"ἔλιπες","score":0.39,"count":1,"kind":"orig"},{"term":"Ἰάνων ναυβατᾶν","score":0.39,"count":1,"kind":"orig"},{"term":"ὀτοτοτοτοῖ","score":0.39,"count":1,"kind":"orig"},{"term":"Sbor","score":0.38,"count":2,"kind":"entity"},{"term":"Xerxés","score":0.35,"count":2,"kind":"entity"},{"term":"Chorál","score":0.32,"count":1,"kind":"entity"}]}}},"summaries":{"c0001":{"cs":"Sbor perských vojáků lamentuje nad ztrátou síly a neschopností získat zprávy z domova po porážce v řecké válce. Popisuje rozprchlé jednotky, jejich vůdce a nepřítomnost zpravodajů, což symbolizuje rozpad vojenské moci a nejistotu osudu říše."},"c0002":{"cs":"Chór popisuje prázdné domy v Persii, truchlící ženy, které oplakávají své muže, a vyjadřuje obavy, zda král Xerxes přežil bitvu. Zdůrazňuje nevyhnutelnost božského soudu a křehkost lidského štěstí před osudem, zatímco reflektuje na pomíjivost války a slávy."},"c0003":{"cs":"Atossa vyjadřuje obavy o syna Xerxa po jeho neúspěšné výpravě proti Řekům a ptá se na sílu perského vojska. Sbor odpovídá s rostoucím pocitem porážky, až anděl oznámí zničení perské moci a slávy v jedné ráně."},"c0004":{"cs":"Sbor lamentuje nad strašlivými ztrátami Peršanů v námořní bitvě u Salamíny, zatímco posel potvrzuje úplné zničení perské flotily řeckými loděmi a popisuje hrůzy porážky, včetně mrtvých těl na pobřeží a zoufalého křiku přeživších."},"c0005":{"cs":"Posel přináší Atosse zprávu o smrti mnoha perských velitelů a zkáze flotily u Salamíny, přičemž zdůrazňuje, že porážka nastala ne kvůli nedostatku síly, ale díky lstivé řecké taktice a božské podpoře Athény, která zachránila své město."},"c0006":{"cs":"Chorál vyjadřuje hluboký zármutek nad zánikem perské říše po porážce Xerxa ve válce proti Řekům. Popisuje ztrátu perské flotily, utrpení přeživších vojáků, rozpad státní správy a osvobození podrobených národů. Zdůrazňuje, že perská síla byla zlomena a jejich nadvláda v Asii skončila."},"c0007":{"cs":"Atossa, matka perského krále, vyjadřuje hluboký strach z božského osudu a přináší oběti zemřelým – mléko, med, olej, víno a jiné dary – jako projevy úcty a snahy o smíření. Sbor následně vyzývá chthonické bohy (Zemi, Herméa a vládce živých), aby duše zemřelých přivedli ze tmy na světlo, zdůrazňujíc, že jen ten, kdo zná lék proti zlu, může určit hranici smrti."},"c0008":{"cs":"Chorál v Peršanech vyjadřuje hluboký smutek nad smrtí krále Daria, vzývá bohy (zejména chthonické síly) a zemské vládce, aby vyslechly nářek perského lidu. Připomíná bývalou slávu perského vojska a panovníka, zatímco lamentuje nad současným zničením, beznadějí a ztrátou řádu po porážce Řeky. Je to modlitba za zemřelého panovníka i výkřik zoufalství nad osudem národa."},"c0009":{"cs":"Perští staříci truchlí u hrobu Dareia, vyjadřují svůj zármutek a obavy z budoucnosti, zároveň se snaží uctít mrtvého rituálními oběťmi a vzýváním bohů podzemí, zatímco zpochybňují účinnost takových úkonů vůči nevyhnutelnému osudu."},"c0010":{"cs":"V tomto úryvku z Choral 10 sbor vyjadřuje hlubokou úctu a obavu před božskou mocí a starověkým strachem, zatímco Dareios, přesvědčený o své přítomnosti pod zemí, žádá stručnou a jasnou odpověď, aby mohl projevit svou úctu zemřelým a vyhnout se dlouhým, složitým řečem."},"c0011":{"cs":"V epizodě 11 hovoří Dareios s Atossou o zničení perského vojska, které přešlo přes Hellespont a Bospor pomocí mostu naznačujícího božský zásah. Atossa popisuje zmar syna Xerxa, jeho hybris a následný božský trest, zatímco Dareios vzpomíná na dřívější úspěchy Peršanů a lamentuje nad ztrátou vojenské síly a moudrosti."},"c0012":{"cs":"Chór ve své ódě vyvyšuje perského krále Dareia jako panovníka božského původu, jehož vláda zajistila mír, hospodářskou prosperitu a bezpečný návrat vojáků z válek. Zdůrazňuje jeho vliv nad oblastmi kolem Egejského a Černého moře, kde pod jeho nadvládou kvitly města a národy, a připomíná božskou podporu a sílu řeckých spojenců v boji proti nepříteli."},"c0013":{"cs":"Perský král Xerxos vyjadřuje hlubokou zoufalost nad svou porážkou v řecko-perských válkách, cítí se bezmocný před krutým osudem a božskou vůlí, zatímco sbor lamentuje nad ztrátou mohutné perské armády, jejíž síla a mladost byly pohlceny podsvětím, a oplakává padlé vojáky jako kvítko země, zatímco Asie sama sklání se v žalu."},"c0014":{"cs":"Kapitola zachycuje hluboký žal perského krále Xerxa a sboru po porážce u Salamíny. Xerxes truchlí nad ztrátou vojska, slávy a vůdců, zatímco sbor odpovídá lamentací, vzpomíná na padlé vůdce a města a zdůrazňuje zkázu perského vojska a flotily. Prostřednictvím střídavých výkřiků, rituálních nářků a opakujících se motivů smutku je vyjádřena kolektivní bolest a uznání božského osudu v katastrofě."}}}