":"entity"},{"term":"Δίʼ","score":0.3,"count":5,"kind":"entity"},{"term":"Θεοδότη","score":0.3,"count":4,"kind":"orig"},{"term":"πόλις","score":0.3,"count":4,"kind":"orig"},{"term":"στρατηγεῖν","score":0.3,"count":4,"kind":"orig"},{"term":"ἐπιμελεῖσθαι","score":0.3,"count":4,"kind":"orig"},{"term":"ἔφη","score":0.3,"count":5,"kind":"orig"}]},"c0004":{"terms":[{"term":"Sókratés","score":1.0,"count":41,"kind":"entity"},{"term":"akrasie","score":1.0,"count":1,"kind":"word"},{"term":"božská péče","score":1.0,"count":1,"kind":"word"},{"term":"božská vůle","score":1.0,"count":1,"kind":"word"},{"term":"cnota","score":1.0,"count":2,"kind":"word"},{"term":"enkrateia","score":1.0,"count":1,"kind":"word"},{"term":"přírodní dary","score":1.0,"count":1,"kind":"word"},{"term":"sebekontrola","score":1.0,"count":2,"kind":"word"},{"term":"zákony","score":1.0,"count":6,"kind":"word"},{"term":"spravedlnost","score":0.46,"count":19,"kind":"word"},{"term":"Εὐθύδημος","score":0.36,"count":8,"kind":"entity"},{"term":"Euthydémos","score":0.35,"count":10,"kind":"entity"},{"term":"Σωκράτης","score":0.32,"count":13,"kind":"orig"},{"term":"Athény","score":0.3,"count":5,"kind":"entity"},{"term":"Delfy","score":0.3,"count":3,"kind":"entity"},{"term":"Euthýdemos","score":0.3,"count":3,"kind":"entity"},{"term":"Euthýdémos","score":0.3,"count":3,"kind":"entity"},{"term":"Hippias","score":0.3,"count":3,"kind":"entity"},{"term":"Hippías","score":0.3,"count":3,"kind":"entity"},{"term":"Sokrates","score":0.3,"count":5,"kind":"entity"},{"term":"Sokratés","score":0.3,"count":4,"kind":"entity"},{"term":"Xenofón","score":0.3,"count":4,"kind":"entity"},{"term":"Zeus","score":0.3,"count":9,"kind":"entity"},{"term":"Zeús","score":0.3,"count":5,"kind":"entity"},{"term":"bohatství","score":0.3,"count":4,"kind":"word"},{"term":"bohové","score":0.3,"count":5,"kind":"entity"},{"term":"ctnost","score":0.3,"count":9,"kind":"word"},{"term":"daimonion","score":0.3,"count":3,"kind":"entity"},{"term":"dialog","score":0.3,"count":8,"kind":"word"},{"term":"dobro","score":0.3,"count":8,"kind":"word"},{"term":"moudrost","score":0.3,"count":10,"kind":"word"},{"term":"nepřátelé","score":0.3,"count":3,"kind":"word"},{"term":"poslušnost","score":0.3,"count":3,"kind":"word"},{"term":"sebepoznání","score":0.3,"count":4,"kind":"word"},{"term":"smrt","score":0.3,"count":4,"kind":"word"},{"term":"soud","score":0.3,"count":3,"kind":"word"},{"term":"síla","score":0.3,"count":4,"kind":"word"},{"term":"vzdělání","score":0.3,"count":4,"kind":"word"},{"term":"zlo","score":0.3,"count":4,"kind":"word"},{"term":"znalost","score":0.3,"count":3,"kind":"word"},{"term":"zákon","score":0.3,"count":3,"kind":"word"},{"term":"Εὐθύδημε","score":0.3,"count":3,"kind":"orig"},{"term":"δίκαια","score":0.3,"count":4,"kind":"orig"},{"term":"θεοὺς","score":0.3,"count":5,"kind":"orig"},{"term":"νόμους","score":0.3,"count":5,"kind":"orig"},{"term":"παιδείας","score":0.3,"count":3,"kind":"orig"},{"term":"σοφία","score":0.3,"count":3,"kind":"orig"},{"term":"ἀκρατεῖς","score":0.3,"count":3,"kind":"orig"},{"term":"ἐπιστήμη","score":0.3,"count":3,"kind":"orig"},{"term":"ἥλιος","score":0.3,"count":3,"kind":"orig"}]}}},"summaries":{"c0001":{"cs":"Xenofón v první knize svých Vzpomínek na Sókrata brání svého učitele před athénským soudem, který Sókrata odsoudil za nevěru a korupci mládeže. Argumentuje, že obvinění jsou neopodstatněná: Sókrátes ve skutečnosti veřejně i soukromě obětoval bohům města, neodmítal tradiční náboženskou praxi a jeho daimonion – vnitřní hlas, který ho vedl – byl vnímán jako božské znamení podobné ptačí augurii, nikoli jako zavádění nových bohů. Sókrátes používal tento daimonion k radě mladým: ti, kteří ho poslechli, vedli lepší život, zatímco ti, kteří ho ignorovali, později litovali. Jeho život byl veřejný, střídmý a asketický – vyhýbal se luxusu, neučil za peníze, a své žáky vedl k ctnosti ne prostřednictvím řečnické techniky nebo politické moci, ale vlastním příkladem a dialógem. Věřil, že bohové jsou vševědoucí a přítomní ve všech lidských činech, zatímco největší věci – jako budoucnost, válka nebo osud – nechávají lidem skryté, aby je hledali prostřednictvím božského znamení. Sókrátes kritizoval sofisty, kteří prodávali moudrost za peníze, zdůrazňoval, že pravá hodnota spočívá v přátelství, ctnosti a sebekontrole, a že nejšťastnější je ten, kdo je nezávislý na vnějších věcech a žije v souladu s božskou vůli prostřednictvím ctnosti."},"c0002":{"cs":"V této kapitole Sókratés vede dva klíčové dialogy. Nejprve s Arístippos rozebírá, jak vychovávat budoucí vůdce – ty, kteří musí být schopni odolávat hladu, žízni, spánku, chladu, tepu a práci, aby mohli vládnout s rozumem a ctností – versus ty, kdo moc odmítají a mají být vedeni k pohodlnému životu. Rozlišuje mezi dobrovolnou utrpením (práce vykonávanou s nadějí na dobro, která přináší radost) a nuceným (otrokotské), přičemž chválí první jako cestu k trvalému štěstí prostřednictvím ctnosti a sebepřekonání. Dále s Chairekrátés diskutuje o tom, že lidé často vidí škodu v tom, že sourozenci něco nevlastní, ale nevnímají škodu v tom, že nevlastní majetek spoluobčanů, přestože společnost a přátelství přinášejí větší bezpečí než izolované hromadění bohatství. Zdůrazňuje, že přátelství je přirozenější mezi sourozenci díky společnému původu a výchově, a že člověk by měl jednat podle reciprocity – jak chce být traktován druhými. Kritizuje iluze bezpečnosti v izolaci a otroctví pod záminkou svobody, zatímco vyzdvihuje věrné přátele jako nejcennější 'majetek', který často přehlížíme ve prospěch hmotného statku. Skutečná svoboda a štěstí podle Sokratése přicházejí skrze ctnost, sebekázeň a užitečné jednání, nikoli přes moc nebo pohodlí bez námahy."},"c0003":{"cs":"Sokrates vysvětluje, že ten, kdo chce ve městě vést jako stratég, se musí nejprve naučit válečnému umění, protože neznalost vede k škodě pro obec – podobně jako nezkušený sochař poškodí své dílo. Strateg musí mít mnoho protikladných vlastností: být přípravný, zásobovací, mechanický, pracovitý, pečlivý, vytrvalý, mírný i tvrdý, prostý i lstivý, ochranný i lupičský, předvídavý i kořistnický, štědrý i chamtivý, bezpečný i útočný. Přirovnává uspořádané vojsko k dobře postavené budově: roztroušené kamení, cihly a dřevo nemají užitek, dokud nejsou správně naskládány – tak i vojsko potřebuje správné uspořádání, kde nejlepší jsou vpředu, nejhorší uprostřed a nejslabší vzadu, aby byli chráněni silnými. Sokrates se ptá, zda Dionysodoros skutečně naučil rozlišovat dobré a zlé lidi, protože bez této schopnosti je výuka formace k ničemu. Nakonec přirovnává stratéga k pastýři, který se stará o své stádě: stejně jako pastýř zajišťuje bezpečí a zdroje pro ovce, musí stratég zajistit bezpečí a zásoby pro vojáky, neboť válčí se proto, aby byli bojovníci šťastnější."},"c0004":{"cs":"Sókratés a Euthýdémos nejprve zkoumají, jak bohové projevují péči o člověka prostřednictvím základních darů jako voda, oheň a slunce, které jsou poskytovány s mírou a prospěchem, aby je člověk mohl rozumně užívat. Dále debatují o původu zákonů: zda pocházejí od lidí či bohů, přičemž Sókratés tvrdí, že božské zákony jsou nezpochybnitelné a že lidé by se měli řídit náznakem božské vůle skrze přírodu a svědomí. Hovor pak přechází k etice – konkrétně k ctnosti sebekontroly (enkrateia), která umožňuje člověku jednat rozumně, užívat skutečných dobrot a vyhýbat se škodlivým vášním. Tato ctnost je kontrastována s akrasií (slabostí vůle), která vede k otroctví pudům a znemožňuje svobodné, rozumné jednání. Sebekontrola je tak prezentována jako základ etického života a rozumného využívání božských darů."}}}