rig"},{"term":"nákaza","score":0.31,"count":3,"kind":"word"},{"term":"pramen","score":0.31,"count":3,"kind":"word"},{"term":"Lukrécij","score":0.3,"count":5,"kind":"entity"},{"term":"Tellus","score":0.3,"count":5,"kind":"entity"},{"term":"Terra","score":0.3,"count":5,"kind":"entity"},{"term":"bohové","score":0.3,"count":4,"kind":"word"},{"term":"caelo","score":0.3,"count":3,"kind":"orig"},{"term":"calor","score":0.3,"count":5,"kind":"orig"},{"term":"moře","score":0.3,"count":4,"kind":"word"},{"term":"nubes","score":0.3,"count":4,"kind":"orig"},{"term":"slunce","score":0.3,"count":4,"kind":"word"},{"term":"smrt","score":0.3,"count":6,"kind":"word"},{"term":"teplo","score":0.3,"count":4,"kind":"word"},{"term":"umor","score":0.3,"count":4,"kind":"orig"},{"term":"železo","score":0.3,"count":3,"kind":"word"}]}}},"summaries":{"c0001":{"cs":"První kniha De rerum natura otevírá invokací bohyně Venuše jakožto kosmické síly života, lásky a plodnosti. Následuje polemika proti náboženské superstici a strachu ze smrti, přičemž Lucretius představuje svůj atomistický systém: vše vzniká z nezničitelných prvotních částic (atomů) pohybujících se v prázdnotě (inane), nic nevzniká z ničeho a nic neztrácí svou existenci úplně. Kritizuje náboženské obřady jako zdroj násilí (příklad Ifigenie) a zdůrazňuje, že pravé poznání přírody osvobozuje od iracionálních strachů."},"c0002":{"cs":"Liber Secundus popisuje, jak primordia (atomy) pohybují se ve vakuu, narážejí, spojují a rozcházejí, čímž tvoří všechny jevy v přírodě – od pevných látek po světlo a páru. Zdůrazňuje, že přirozený pohyb dolů je narušován náhodnými odchylkami (clinamen), což umožňuje svobodu vůle a rozmanitu světa. Vše vzniká z kombinace částic bez účelu či božského řízení."},"c0003":{"cs":"V třetí knize Lucretius vyvrací představu o nesmrtelné duši a tvrdí, že duše (animus) i životní síla (anima) jsou jemné tělesné substance rozptýlené po celém těle, závislé na fyzickém substrátu jako nervy, krev a dech. Jejich činnost zaniká spolu s tělem při smrti, podobně jako kouř nebo pára se rozptýlí do vzduchu. Smrt tedy není ničím, čeho by se měl člověk bát, protože po ní již nic nepociťujeme."},"c0004":{"cs":"Lucretius popisuje vznik a šíření tenkých obrazů (simulacra) z předmětů, které pronikají vzduchem a stimulují smysly – zrak, sluch, čich a chuť – čímž umožňují vnímat tvar, barvu, vzdálenost a pohyb objektů. Vysvětluje optické jevy jako zrcadlení, lom a zdánlivý pohyb stínů či nebeských těles jako důsledek tohoto mechanizmu."},"c0005":{"cs":"Lucretius v knize 5 O přírodě vyvrací mytologické vysvětlení světa a bohů, přičemž ukazuje, že vesmír, země, živá příroda i lidská společnost vznikly přirozenými procesy z prvotních částic, bez zásahu nadpřirozených sil. Rozum a moudrost, nikoli bohové, přivedli lidstvo z temnoty do civilizace. Příroda sama řídí cykly nebeských těles, živlů a života, zatímco lidské strachy a rituály jsou důsledkem neznalosti, nikoli božské vůle."},"c0006":{"cs":"V knize 6 Lucretius podrobně rozebírá meteorologické a geologické jevy – blesky, hrom, bouře, zemětřesení, sopky – a vysvětluje je prostřednictvím atomistické fyziky jako důsledek střetu a pohybu jemných částic v atmosféře a zemi. Zdůrazňuje, že lidský strach z těchto jevů pramení z neznalosti přírodních příčin a vede k pověrám a náboženské úzkosti, zatímco pravé osvobození přichází skrze rozum a pochopení přírody."}}}