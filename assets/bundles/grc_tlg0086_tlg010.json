t":2,"kind":"entity"},{"term":"moudrost","score":0.3,"count":3,"kind":"word"},{"term":"moudrý člověk","score":0.3,"count":2,"kind":"entity"},{"term":"noûs","score":0.3,"count":2,"kind":"entity"},{"term":"phronésis","score":0.3,"count":3,"kind":"entity"},{"term":"praxe","score":0.3,"count":3,"kind":"word"},{"term":"skutky","score":0.3,"count":2,"kind":"word"},{"term":"smysly","score":0.3,"count":2,"kind":"word"},{"term":"zákon","score":0.3,"count":3,"kind":"word"},{"term":"život","score":0.3,"count":3,"kind":"word"},{"term":"διανοίᾳ","score":0.3,"count":2,"kind":"orig"},{"term":"διδαχῇ","score":0.3,"count":2,"kind":"orig"},{"term":"εἶδος","score":0.3,"count":2,"kind":"orig"},{"term":"θεωρητική","score":0.3,"count":2,"kind":"orig"},{"term":"κίνησις","score":0.3,"count":2,"kind":"orig"},{"term":"νοῦς","score":0.3,"count":3,"kind":"orig"},{"term":"ἀγαθόν","score":0.3,"count":4,"kind":"orig"},{"term":"ἐμπειρίᾳ","score":0.3,"count":2,"kind":"orig"},{"term":"ἔθει","score":0.3,"count":2,"kind":"orig"},{"term":"ἔθεσι","score":0.3,"count":2,"kind":"orig"}]}}},"summaries":{"c0001":{"cs":"Aristoteles zkoumá povahu nejvyššího dobra a identifikuje jej s eudaimonií – štěstím nebo blahem dosaženým činností duše v souladu s ctností po celý život. Rozlišuje mezi cíli samy o sobě a prostředky, kritizuje identifikaci dobra s potěšením, ctí nebo bohatstvím a zdůrazňuje, že pravé štěstí je aktivní život podle rozumu a ctnosti, který je sám o sobě hodný volby. Mladí a nevzdělaní nejsou způsobilí studovat etiku kvůli nedostatku zkušeností a nadvládě vášně nad rozumem."},"c0002":{"cs":"Aristoteles definuje etickou ctnost jako střední polohu mezi dvěma nectnostmi – jednou z přebytku a jednou z nedostatku – která není aritmetickým průměrem, ale závisí na situaci a člověku. Ctnosti jako statečnost a mírnost vznikají opakovaným správným jednáním, nikoli pouhým poznáním, a vyžadují sebekázeň, protože lidé mají sklon k jedné extrémě. Střední cesta je dosažitelná úmyslným nakloněním se proti přirozené sklonnosti, podobně jako narovnávání zkrouceného dřeva. Dianoetické (intelektuální) a etické (mravní) ctnosti se liší způsobem vzniku: první učením, druhé zvyklostí. Praktická moudrost (phronésis) určuje, co je v dané situaci střední. Některé činy (jako vražda) jsou vždy špatné a nepřipouštějí střed."},"c0003":{"cs":"V této kapitole Aristoteles nejprve analyzuje rozdíl mezi činy provedenými z vlastní vůle (ἑκούσια) a těmi vykonanými proti vůli (ἀκούσια), přičemž zdůrazňuje, že odpovědnost, chvála a trest závisí na tomto rozlišení. Dále zkoumá podstatu skutečné statečnosti (andreia) jako střední ctnosti mezi zbabělostí a bezohledností, která se projevuje v trpělivém snášení bolestivých a děsivých věcí proto, že je to krásné a správné, nikoli ze strachu, hněvu nebo touhy po slávě. Rozlišuje různé druhy statečnosti – politickou, zkušenostní a založenou na hněvu – a zdůrazňuje, že pravá statečnost vychází z ctnosti a rozumné volby (proairesis), nikoli z pudu nebo nevědomosti."},"c0004":{"cs":"Kapitola pojednává o ctnosti jako mezosti (mesotés) mezi extrémy, nejprve u lásky k cti (φιλοτιμία) a hněvu (πραότης), kde jen správná míra je chvályhodná. Dále se zabývá mezostí v řeči a společenském chování, kde jsou extrémy alazoneia (chvástavost) a eironeia (ironické podceňování), zatímco prostřední ctnost je bezejmenná, ale podobná přátelskému chování. Rozsáhle pak rozvíjí ctnost štědrosti (eleutheriotēs) jako střed mezi lakotou a rozmařilostí, zdůrazňuje správné nakládání s majetkem podle potřeby a ctnosti, a přechází k velkorysosti (megaloprepeia) a velkoduchosti (megalopsychie) jako k ctnostem velkého měřítka, závislým na kontextu, postavě a vnitřní disposici, nikoli na výši skutku."},"c0005":{"cs":"Aristoteles zkoumá spravedlnost jako ctnost (hexis) spočívající v prostředku mezi přebytkem a nedostatkem vůči druhým. Rozlišuje obecnou spravedlnost (zákonnost a rovnost) a zvláštní spravedlnost, která se dělí na rozdělovací (podle geometrické analogy zásluh) a opravnou (aritmetickou rovnost ve výměnách a trestech). Dále rozlišuje přirozenou a zákonem stanovenou spravedlnost, skutek nespravedlivý (adikema) od nespravedlivého stavu (adikon), a zdůrazňuje odpovědnost za vědomé jednání."},"c0006":{"cs":"Aristoteles rozlišuje přirozenou ctnost bez rozumu jako škodlivou a pravou ctnost jako stav duše řízený praktickou moudrostí (phronésis), která je nezbytná pro správné jednání a vzájemně závislá s etickou ctností. Phronésis není nadřazená jiným ctnostem, ale řídí je směrem k cíli, podobně jako politika určuje pravidla pro polis."},"c0007":{"cs":"Aristoteles rozlišuje mezi akolastickým (nekontinentním) a akratickým (inkontinentním) chováním: akolastický člověk trvá ve špatné volbě bez lítosti, zatímco akratický jedná proti lepšímu úsudku, ale lituje toho. Akolasie je chronická slabost duše, akrasie přerušovaná, jako epilepsie. Akratický je lepší než akolastický, protože zachovává rozumný princip. Diskuse přechází k enkratii a připravuje téma přátelství."},"c0008":{"cs":"Aristoteles zdůrazňuje, že přátelství je nezbytné pro štěstí a ctnostný život, neboť bez něj nelze skutečně užívat žádné statky. Rozlišuje tři druhy přátelství: podle užitku (náhodné a pomíjivé), podle rozkoše (také pomíjivé) a podle ctnosti (trvalé, dokonalé, založené na vzájemném přání dobra pro druhého pro jeho vlastní dobro). Pouze přátelství ctných lidí je skutečné a trvalé."},"c0009":{"cs":"Aristoteles analyzuje přátelství podle jeho základů: užitek, potěšení nebo ctnost. Pouze přátelství založené na ctnosti je rovnocenné, trvalé a prospěšné pro duševní pohodu. Zkoumá také sebe-přátelství jako projev rozumného a ctného jednání, potřebu přátel pro šťastný život a míru v jejich počtu – ani příliš mnoho, ani příliš málo – aby umožnila hluboké sdílení života a myšlenek."},"c0010":{"cs":"Aristoteles analyzuje rozkoš (ἡδονή) jako dokonalost činnosti (ἐνέργεια), nikoli jako pohyb, a rozlišuje přirozené a umělí rozkoše. Zdůrazňuje, že správné užívání rozkoše je nezbytné pro ctný život. Nejvyšší forma rozkoše a štěstí (εὐδαιμονία) je spojena s teoretickým životem (θεωρητικὴ ζωή) a rozumem (νοῦς), který je nejčinnější a nejtrvalejší činností duše. Tento život je sebeúčelný, božský a nezávislý na vnějších statcích, zatímco život podle mravní ctnosti vyžaduje vnější prostředky a je sekundární."}}}