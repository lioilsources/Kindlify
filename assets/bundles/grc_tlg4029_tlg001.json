ount":16,"kind":"orig"},{"term":"στράτευμα","score":0.3,"count":15,"kind":"orig"},{"term":"Ἀρταβάζης","score":0.3,"count":6,"kind":"orig"},{"term":"Ἰωάννης","score":0.3,"count":14,"kind":"orig"},{"term":"Ῥωμαίων","score":0.3,"count":15,"kind":"orig"},{"term":"Ῥωμαῖοι","score":0.3,"count":26,"kind":"orig"}]},"c0008":{"terms":[{"term":"Kavkaz","score":1.0,"count":5,"kind":"entity"},{"term":"Laziky","score":1.0,"count":3,"kind":"entity"},{"term":"Persové","score":1.0,"count":29,"kind":"word"},{"term":"bitva","score":1.0,"count":33,"kind":"word"},{"term":"geografie","score":1.0,"count":13,"kind":"word"},{"term":"obléhání","score":1.0,"count":12,"kind":"word"},{"term":"vojenská strategie","score":1.0,"count":22,"kind":"word"},{"term":"Římani","score":1.0,"count":8,"kind":"entity"},{"term":"Římané","score":1.0,"count":50,"kind":"entity"},{"term":"válka","score":0.76,"count":38,"kind":"word"},{"term":"Ναρσῆς","score":0.72,"count":24,"kind":"orig"},{"term":"Πέρσαι","score":0.64,"count":24,"kind":"orig"},{"term":"Ῥωμαῖοι","score":0.64,"count":32,"kind":"orig"},{"term":"Λαζῶν","score":0.61,"count":15,"kind":"orig"},{"term":"Goty","score":0.59,"count":27,"kind":"entity"},{"term":"Γότθοι","score":0.58,"count":29,"kind":"orig"},{"term":"Τουτίλας","score":0.57,"count":14,"kind":"orig"},{"term":"Ῥωμαίων","score":0.54,"count":27,"kind":"orig"},{"term":"Narses","score":0.53,"count":20,"kind":"entity"},{"term":"Περσῶν","score":0.39,"count":13,"kind":"orig"},{"term":"Abasgové","score":0.37,"count":9,"kind":"entity"},{"term":"Λαζικῆς","score":0.35,"count":10,"kind":"orig"},{"term":"Μερμερόης","score":0.35,"count":10,"kind":"orig"},{"term":"Ἀβασγοὶ","score":0.35,"count":7,"kind":"orig"},{"term":"Justinian","score":0.34,"count":17,"kind":"entity"},{"term":"Lazi","score":0.33,"count":8,"kind":"entity"},{"term":"Γουβάζης","score":0.33,"count":8,"kind":"entity"},{"term":"Τουτίλαν","score":0.33,"count":8,"kind":"orig"},{"term":"Ἰουστινιανὸς","score":0.32,"count":12,"kind":"orig"},{"term":"Gotové","score":0.31,"count":13,"kind":"entity"},{"term":"Fránci","score":0.3,"count":6,"kind":"entity"},{"term":"Itálie","score":0.3,"count":13,"kind":"entity"},{"term":"Justinian I","score":0.3,"count":12,"kind":"entity"},{"term":"Kolchida","score":0.3,"count":6,"kind":"entity"},{"term":"Lazika","score":0.3,"count":7,"kind":"entity"},{"term":"Lazové","score":0.3,"count":6,"kind":"entity"},{"term":"pevnost","score":0.3,"count":13,"kind":"word"},{"term":"strategie","score":0.3,"count":15,"kind":"word"},{"term":"zrada","score":0.3,"count":13,"kind":"word"},{"term":"útok","score":0.3,"count":15,"kind":"word"},{"term":"římské vojsko","score":0.3,"count":12,"kind":"word"},{"term":"Βέσσας","score":0.3,"count":7,"kind":"entity"},{"term":"Βυζάντιον","score":0.3,"count":12,"kind":"orig"},{"term":"Γότθων","score":0.3,"count":10,"kind":"orig"},{"term":"Λαγγοβάρδαι","score":0.3,"count":8,"kind":"orig"},{"term":"Πέτραν","score":0.3,"count":7,"kind":"orig"},{"term":"Φράγγοι","score":0.3,"count":9,"kind":"orig"},{"term":"Χοσρόης","score":0.3,"count":9,"kind":"orig"},{"term":"πολέμιοι","score":0.3,"count":13,"kind":"orig"},{"term":"Ἰωάννης","score":0.3,"count":11,"kind":"orig"}]}}},"summaries":{"root":{"cs":"„Ὑπὲρ τῶν Πολέμων Λόγοι“ je osmiknihová historická kronika Procopia z Byzantské říše, která dokumentuje války císaře Justiniana I. proti Vandalům, Gotům, Persům a dalším nepřátelům. Každá kapitola představuje strategický a etický přehled vojenských akcí, politických změn a osudů vládců, zahrnuje i přírodní a mytologické prvky. Dílo spojuje faktografický záznam s filozofickými úvahami o spravedlnosti, osudu, věrnosti, smrti a lidské duši. Text je založen na starořeckém originálu; knihovna disponuje českým překladem."},"c0001":{"cs":"Kapitola začíná dramatickým zápasem o moc, kdy se vojáci spikli s knězem Mamantem a zavraždili tyranovu osobu, aby ukončili jeho tyranií. Tyran byl uvězněn, a aby se zabránilo dalšímu násilí, byl zabit. Následně se kapitola přesouvá k historickému vyprávění o válkách mezi Římskou říší a Perskou říší, které se odehrávají v rámci vlády císaře Justiniána. Zahrnuje detailní popis obléhání města Amida, taktických manévrů, překvapivých útoků, diplomatických jednání a politických intrik, včetně nástupu krále Kavádise, jeho konfliktu s perskou radou a jeho spojenectví s byzantským císařem. Zároveň se objevují i etnické a náboženské aspekty, jako je vztah k Eftalitům a náboženské rituály, a zároveň se zdůrazňuje morální rozhodnutí, jako je milosrdenství po vítězství a záchrana zajatců."},"c0002":{"cs":"Kapitola popisuje politické a vojenské konflikty mezi Římskou říší a Persií, které vznikly po porušení mírových smluv. Zmiňuje se o zradě, diplomatických plánech, útoku na města jako Antiochie a Dára, a o zničení měst po vítězství. Zdůrazňuje nespravedlnost války, ztrátu životů a násilí, které se projevuje i v náboženských a etických otázkách. Procopius kritizuje jak římské, tak perské vůdce za zločinné jednání a ukazuje, jak osud, zrada a lidské závisti ovlivňují dějiny."},"c0003":{"cs":"Kapitola se zabývá přechodem moci po smrti císaře Theodosia I. a rozdělením římského impéria mezi jeho syny Arcádiem a Honoriem. Zobrazuje geografické rozložení světa podle antické představy, včetně oceánu, pevnin Asie a Evropy, a detailních cestovních tras přes Bosporus, Hellespont a Černé moře. Popisuje politickou krizi v římské říši, včetně invazí Wézígotů, zradu Bonifácia, zničení Říma Alarichem a následný pád římské moci. Zmiňuje se o vládě Valentiniana, jeho zločinném chování, a následném převratu, který přinesl moc Theoďsiovi. Kapitola pokračuje příběhem Vandalů, jejich vlády v Afrike, válkami s Byzantem a návratem moci pod Justinianem, včetně příprav války proti Vandalům a významu Belisária. Zároveň zachycuje etnické a politické změny, náboženské konflikty a osudové události, které ovlivnily osudy římského impéria."},"c0004":{"cs":"Kniha 4 je soustředěna na vojenské kampaně Belisáře proti Vandalům v Severní Africe, kde se objevují detailní popisy strategií, příprav k bitvě, morálních řečí a zázračných příznaků, jako je zářící kopí. Zdůrazňuje význam odvahy, jednoty a božské pomoci. Po vítězství následuje útěk Gelimeru, jeho zajetí a triumfální příjezd do Byzantu. Kniha také ukazuje negativní důsledky vítězství – ztrátu disciplíny, loupež, závislost na bohatství a vnitřní rozkol v armádě. Zahrnuje i konflikty s Maurovy, jejich přípravy na boj, přesuny a následné porážky, což ukazuje komplexní obrázek války jako procesu, který zasahuje do politiky, morálky, společnosti i osudu."},"c0005":{"cs":"Kapitola zachycuje komplexní politickou a vojenskou krizi v Itálii na přelomu 5. a 6. století. Po pádu Odoakra se Theodorich, král Gotů, ujme moci a obléhá Ravennu, jejíž geografické umístění způsobuje náročnost přístupu. Následuje přechod moci k jeho dcery Amalasuntě, která se snaží spojit římskou a gotskou kulturu. Po smrti jejího syna Atalaricha se vláda přebírá Theudátem, který zradí Amalasuntu, zavraždí její příbuzné a uvězní ji. Její smrt vyvolává válku mezi Byzantinci a Goty. Císař Justinianus posílá Belisáře, který dobyje Sicílii a připravuje se na invazi do Itálie, což ukazuje přechod moci z gotského království k byzantskému zásahu."},"c0006":{"cs":"Kniha 6 zachycuje detailní průběh vojenských operací mezi byzantskými silami pod velením Belisáře a gotskými vojsky v Itálii. Zahrnuje bitvy, obléhání měst, tajné přesuny vojsk, strategické rozhodnutí a diplomatické jednání. Významně se objevuje hrdinství jednotlivých vojáků, jako je Chorsáman, a rozhodující role Belisáře v plánování a vedení války. Zároveň se projevuje napětí mezi vojenskou efektivitou a politickými konflikty, včetně konfrontace s císařským synem Konstantínem. Kniha tak kombinuje vojenskou kroniku s etickými, politickými a lidskými aspekty války, včetně utrpení civilistů, hladomoru a ztráty naděje."},"c0007":{"cs":"Kapitola se zabývá návratem vojevůdce Belisária do Konstantinopole po úspěšném zvládnutí války proti Gotům, přestože mu byl odmítnut triumf, což zdůrazňuje jeho výjimečnou osobnost, spravedlnost a sebeovládání. Následně se rozvíjí příběh války v Itálii, kde se ukazuje komplexní obrázek vojenských a politických událostí: bitvy, zrad, obléhání měst, vnitřní rozbroje mezi vůdci, hladomor, kanibalismus a ztráta morálního řádu. Zároveň jsou popsány jednotlivé postavy – od zradného Tutílase přes ztraceného generála Vitalia až po ztraceného Chilbudia – a jejich osudy, které ilustrují osudovost, spravedlnost a lidskou slabost ve válce. Kapitola zároveň kritizuje korupci, zneužívání moci a ztrátu ctnosti mezi vojenskými vůdci."},"c0008":{"cs":"Kapitola zahrnuje komplexní popis války mezi Římskou a Perskou říší v oblasti Laziky a Kavkazu, zaměřený na vojenské akce, geografické podmínky a politické důsledky. Zmiňuje se o příchodu perské armády pod vedením Choríanu, o přípravě táboru u řeky Hippis, a o složitém geografickém a etnickém rozložení oblasti, kde žijí Lazi, Aláni, Ounové a jiné skupiny. Kritizuje mytologické příběhy o Amazónkách a Argonautech, vysvětluje historické změny jmen míst a zmiňuje křesťanství jako faktor změny společenské identity. Popisuje bitvu u řeky Hippi, obléhání pevnosti Petra, použití nových válečných strojů a konečnou porážku Persů. Zároveň se zabývá etickými otázkami války, osudem a spravedlností, a vysvětluje, proč odpor je ctnostnější než poddání."}}}