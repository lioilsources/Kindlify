t":4,"kind":"word"},{"term":"prázdno","score":0.59,"count":4,"kind":"word"},{"term":"velikost","score":0.59,"count":4,"kind":"word"},{"term":"Τιμοκράτης","score":0.59,"count":4,"kind":"orig"},{"term":"μέγεθος","score":0.59,"count":4,"kind":"orig"},{"term":"vzduch","score":0.57,"count":7,"kind":"word"},{"term":"štěstí","score":0.54,"count":8,"kind":"word"},{"term":"κενόν","score":0.52,"count":5,"kind":"orig"},{"term":"αἴσθησις","score":0.49,"count":4,"kind":"orig"},{"term":"tělo","score":0.47,"count":7,"kind":"word"},{"term":"Epikúros","score":0.45,"count":5,"kind":"entity"},{"term":"pohyb","score":0.45,"count":5,"kind":"word"},{"term":"příčina","score":0.45,"count":5,"kind":"word"},{"term":"σῶμα","score":0.45,"count":5,"kind":"orig"},{"term":"kondenzace","score":0.44,"count":3,"kind":"word"},{"term":"částice","score":0.44,"count":3,"kind":"word"},{"term":"κόσμος","score":0.44,"count":6,"kind":"entity"},{"term":"μετέωρα","score":0.44,"count":3,"kind":"entity"},{"term":"πρόληψιν","score":0.44,"count":3,"kind":"orig"},{"term":"πυρὸς","score":0.44,"count":3,"kind":"entity"},{"term":"ἀπείρου","score":0.44,"count":3,"kind":"orig"},{"term":"Ἐπίκουρον","score":0.44,"count":3,"kind":"orig"},{"term":"ἥλιος","score":0.44,"count":6,"kind":"entity"},{"term":"smrt","score":0.43,"count":8,"kind":"word"},{"term":"Epikur","score":0.41,"count":4,"kind":"entity"},{"term":"ἄστρα","score":0.41,"count":4,"kind":"orig"},{"term":"duše","score":0.37,"count":6,"kind":"word"},{"term":"rozum","score":0.37,"count":6,"kind":"word"},{"term":"Eudaimonia","score":0.36,"count":3,"kind":"entity"}]}}},"summaries":{"c0001":{"cs":"Text zkoumá původ filozofie, kterou někteří připisují barbarům (Peršané, Babylóňané, Indové, Keltové), jiní Řekům (Músaios, Línos). Dále popisuje dělení na ionickou (od Thála) a italskou (od Pythagora) větev, jejich představitele a následovníky, včetně Sókratésových a Platónových žáků. Zaměřuje se na Thála z Milétu: jeho původ, činy (předpověď zatmění, měření pyramid, návrh kalendáře) a výroky o Bohu, světě, čase a ctnosti."},"c0002":{"cs":"Kapitola začíná výkladem o Anaximandrovi, Anaximenovi a Anaxagorovi jako zakladatelích ionické přírodní filozofie s jejich teoriemi o arche, kosmologii a přírodních jevech. Následuje podrobný líčení soudního procesu proti Sókratovi za neuctivost a zkažení mládeže, vedeného Mélétem, Anytem a Lykónem, jeho odsouzení, vypití jedu a posmrtných poct. Dále se věnuje Aristippovu obhajobě hedonského života a Stilponovu dialektickému umění a tragickému konci."},"c0003":{"cs":"Kapitola líčí život Platona od jeho athénského původu přes vzdělání u Sókratese, cestování po řeckém světě, založení Akademie až k jeho smrti a pohřbu. Zdůrazňuje jeho teorii idejí, trojdílnou duši, kosmologii čtyř prvků, dialektiku jako filozofickou metodu a učení o ctnosti, spravedlnosti a různých formách vlády."},"c0004":{"cs":"Speusippus, synovec Platona, vedl Akademii osm let, zachoval jeho doktríny, ale byl podrážděný a slabý vůči rozkoši, což vedlo k impulzivním činům a nakonec k sebevraždě z deprese. Arkéilaos byl výřečný, štědří a společensky aktivní filozof, který tajně pomáhal přátelům, vyhýbal se přímému kontaktu s Antígónosem a zemřel opilý ve 75 letech, jehož pohřeb doprovázely ironické verše o nadměrné konzumaci vína."},"c0005":{"cs":"Text popisuje Aristotela, syna Nikomacha, žáka Platona, zakladatele Lykeia a učitele Alexandra Velikého. Po obvinění z bezbožnosti uprchl do Chalkidy, kde zemřel ve věku 62 let na otravu akonitem. Jeho závěť řeší péči o děti, otroky a majetek, jmenuje Antipatra opatrovníkem a zahrnuje ustanovení o výchově, manželství dcery, osvobození otroků a rozdělení knih a pozemků přátelům."},"c0006":{"cs":"Kapitola začíná životopisem Antisthéna, athénského filozofa pochybného původu, který po studiu u Gorgia následoval Sókrateta každodenní chůzí z Pireu do Athén a rozvinul filozofii zaměřenou na ctnost, sebevystačičnost a odmítnutí společenských konvencí, přičemž je považován za prvního cynika. Následuje podrobný výčet Diogenova života: jeho konflikt s otcem kvůli padělání mincí, útěk do Athén, setkání s Antisthenem, přijetí asketického života (život v sudu, odmítnutí pohodlí), kritika společnosti, filozofie i Platonových názorů skrz ironické činy a výroky, jeho stáří a smrt (verze o požití syrového mnoho nohou nebo zadržení dechu), spor o pohřeb a nakonec pohřbení u brány k Isthmosu se sloupem a psem, později uctěn bronzovou sochou chválící jeho autarkii."},"c0007":{"cs":"Text popisuje Zénónův život od ztroskotání lodi přes setkání s Kratétem, studium u několika filozofů, založení vlastní školy v Stoa Poikilé, až po jeho smrt a pocty od Athéňanů. Dále rozebírá stoické dělení filozofie na fyzikální, etickou a logickou část, teorii poznání prostřednictvím kataleptické fantazie, klasifikaci řeči a logických výroků, pojetí ctnosti jako života podle příčiny a rozumu, a kosmologii založenou na božském rozumu prostupujícím světem."},"c0008":{"cs":"Kapitola se zabývá životem Pythagora – jeho původem, cestami do Egypta a na Krétu, založením školy v Krotonu, učením o metempsychóze, asketickém životním stylu, stravovacích tabu a kosmologické teorii – a popisuje jeho smrt při útěku přes pole s bobovými lusky nebo po hladovění v chrámu Muz. Dále pojednává o Eudoxovi z Knida jako astronomovi, geometrovi, lékaři a zákonodárci, jeho studiích u Archyty a Filistiona, cestách do Egypta a Kyziku, působení v Athénách a zákonech pro občany, přičemž uvádí, že zemřel ve 53 letech během třetí sté olympiády."},"c0009":{"cs":"Kapitola se zaměřuje na skeptickou tradici ve starověké filozofii, zejména na Pyrróna z Élidy a jeho následovníky, kteří odmítají dogmatická tvrzení a zdůrazňují rovnocennost protichůdných zdání (isostheneia). Popisuje se metoda epoché (pozastavení soudu) jako reakce na nedostatek spolehlivého kritéria pravdy, podpořená deseti troposy založenými na relativitě vnímání podle smyslů, stavu, zvyklostí a dalších podmínek. Kritérium pravdy je odmítnuto jako buď cirkulární nebo regresivní, což vede k závěru, že pravda je nepoznatelná. Cílem skeptiků je ataraxie – klidu duše dosaženého suspendováním soudu."},"c0010":{"cs":"Kapitola pojednává o životě Epikúra, řeckého filozofa ze Samu, který založil školu v Athénách založenou na atomismu Démokrita. Jeho učení se dělí na kanonické (kritérium pravdy), fyzické (teorie přírody včetně atomů a prázdna, vysvětlení přírodních jevů bez božského zásahu) a etické (rokoš jako nejvyšší dobro chápaná jako ataraxie – absence bolesti a neklidu). Zdůrazňuje hodnotu přátelství, skromného života a rozumné volby tužeb. Závěť Epikúra zajišťovala pokračování jeho komunity."}}}