e":0.77,"count":1,"kind":"orig"},{"term":"ὁ λόγος","score":0.77,"count":1,"kind":"orig"},{"term":"božská úcta","score":0.65,"count":1,"kind":"word"},{"term":"ὠφελία","score":0.65,"count":1,"kind":"orig"},{"term":"ὅσιον","score":0.62,"count":2,"kind":"orig"},{"term":"zbožnost","score":0.56,"count":1,"kind":"word"},{"term":"θεοῖς","score":0.5,"count":1,"kind":"orig"},{"term":"Euthyfrón","score":0.48,"count":2,"kind":"entity"},{"term":"Sókratés","score":0.48,"count":2,"kind":"entity"},{"term":"bohové","score":0.33,"count":1,"kind":"entity"}]},"c0015":{"terms":[{"term":"Euthyfrón","score":1.0,"count":1,"kind":"entity"},{"term":"Sókratés","score":1.0,"count":1,"kind":"entity"},{"term":"ctnostný život","score":1.0,"count":1,"kind":"word"},{"term":"lepší život","score":1.0,"count":1,"kind":"word"},{"term":"naděje","score":1.0,"count":1,"kind":"word"},{"term":"nauka","score":1.0,"count":1,"kind":"word"},{"term":"nevědomost","score":1.0,"count":1,"kind":"word"},{"term":"obvinění","score":1.0,"count":1,"kind":"word"},{"term":"svaté (hosion)","score":1.0,"count":1,"kind":"word"},{"term":"světské","score":1.0,"count":1,"kind":"entity"},{"term":"zbožnost","score":1.0,"count":1,"kind":"word"},{"term":"αὐτοσχεδιάζω","score":1.0,"count":1,"kind":"orig"},{"term":"καινοτομῶ","score":1.0,"count":1,"kind":"orig"},{"term":"μὴ ὅσια","score":1.0,"count":1,"kind":"orig"},{"term":"πρὸς Μέλητον γραφῆς","score":1.0,"count":1,"kind":"orig"},{"term":"ἀγνοίας","score":1.0,"count":1,"kind":"orig"},{"term":"svaté","score":0.73,"count":1,"kind":"word"},{"term":"ὅσια","score":0.73,"count":1,"kind":"orig"},{"term":"Mélétos","score":0.65,"count":1,"kind":"entity"}]}}},"summaries":{"c0001":{"cs":"Sókratés říká Eutyfrónovi, že jej obžaloval Mélétos z Pitthé, mladý muž nízkého původu, který ho viní z kazení mládeže a předstírání moudrosti. Sókratés obžalobu považuje za nezaslouženou a zdůrazňuje, že správné vedení města začíná péčí o mládež, podobně jako zemědělec pečuje o mladé rostliny."},"c0002":{"cs":"Sókratés a Euthyfrón diskutují o tom, že Mélétos Sókrata obviňuje z kazení mladých a zavádění nových bohů, zatímco Sókratés tato obvinění odmítá jako nesmyslná a odkazuje na své božské znamení (daimonion), které ho vede. Euthyfrón poznamenává, že lidé často posmívají těm, kteří mluví o božském, i když říkají pravdu."},"c0003":{"cs":"Euthyfrón vysvětluje, že žaluje svého otce za zabití otroka, který zabil jednoho z jejich otroků na poli v Náxu. Otec otroka svázal a nechal zemřít hlady a zimou v příkopě, zatímco čekal na poselství od náboženského experta. Euthyfrón tvrdí, že je povinné stíhat vraždu bez ohledu na vztah k pachateli či oběti, protože náboženská nečistota (anozia) hrozí všem, kdo se stýkají s vrahem bez očisty. Sókratés jej však vyzývá k pokoře a ptá se, zdo Euthyfrón skutečně rozumí tomu, co je svaté a co nesvaté, když se tak suverénně pouští do náboženského soudění."},"c0004":{"cs":"Sókratés vyjadřuje přání stát se Euthyfrónovým žákem v božských věcech a žádá ho, aby před soudem proti Méletovi jasně definoval, co je svaté (hosion) a co nesváté (anhosion), přičemž zkoumá, zda jsou tyto pojmy jednotné ve všech činech či závislé na kontextu."},"c0005":{"cs":"Euthyfrón obhajuje své rozhodnutí žalovat svého otce za vraždu otroka tím, že tvrdí, že je to spravedlivé a bohulibé, protože bohové sami trestají své otce za podobné činy. Sókratés vyjadřuje pochybnosti o tom, zda je takové jednání skutečně pious, a naznačuje, že pokud Euthyfrón skutečně rozumí božským věcem, pak by i on měl přijmout jeho jednání jako správné. Sókratés se dále ptá, zda mezi bohy existují války a konflikty jako mezi lidmi, a Euthyfrón potvrzuje, že ano. Nakonec Sókratés naléhá na Euthyfróna, aby definoval podstatu svatosti jako jednotnou ideu, nikoli jen vyjmenovávat jednotlivé svaté činy."},"c0006":{"cs":"Sókratés a Euthyfrón rozebírají rozdíl mezi tím, co je milé bohům (hosion) a co není (anhosion), a zkoumají, zda božské neshody o tom, co je spravedlivé, krásné, dobré či zlé, mohou vést k rozporu v lidském chápání svatosti a nesvatosti, přičemž zdůrazňují, že lidské spory o hodnoty často pramení z nedostatku společného kritéria pro soud."},"c0007":{"cs":"Sokrates ukazuje Euthyfrónovi, že pokud něco je současně milováno a nenáviděno bohy, muselo by být současně svaté i nesvaté – což je nemožné. Euthyfrón se brání tvrzením, že bohové mezi sebou v ničem neshodují, ale Sokrates ho přivádí k tomu, že ani lidé nepopírají, že nespravedlivý má být potrestán; spory vznikají pouze o definici, kdo je nespravedlivý a co činí."},"c0008":{"cs":"Sókratés žádá Euthyfróna, aby mu vysvětlil, na základě čeho soudí, že bohové považují za nespravedlivou smrt člověka zabitého otrokem svého pána, a aby tak prokázal své poznání o svatosti a nesvatosti. Euthyfrón navrhuje definovat svatost jako to, co bohové milují, a nesvatost jako to, co bohové nenávidí. Sókratés však upozorňuje na problém, pokud bohové mezi sebou v těchto citech nesouhlasí."},"c0009":{"cs":"Sókratés vede dialog s Euthyfrónem o povaze svatosti (hosion) a zkoumá, zda je něco svaté proto, že je milováno bohy, nebo je milováno bohy proto, že je svaté. Používá analogii s pohybem, vnímáním a jinými vztahy, aby ukázal, že vlastnosti vznikají díky akci, nikoli naopak. Závěrem vyvrací Euthyfrónovu definici svatosti jako 'to, co je milováno bohy' jako logicky nesprávnou, protože zaměňuje příčinu a následek."},"c0010":{"cs":"Sókratés poukazuje na to, že Euthyfrónova definice svatosti vede k cirkulárnímu uvažování: něco je svaté, protože je milováno bohy, a je milováno bohy, protože je svaté. Euthyfrón přiznává, že nedokáže jasně definovat podstatu svatosti, a Sókratés to přirovnává k Daidalovým sochám, které neustále unikají z místa, kde jsou umístěny."},"c0011":{"cs":"Sókratés se ptá, zda je vše svaté také spravedlivé, či naopak, a prostřednictvím analogie s lichými a celými čísly ukazuje, že svatost (hosion) je částí spravedlnosti (dikaion). Euthyfrón souhlasí a upřesňuje, že tato část spravedlnosti se týká péče o bohy (euseebeia), zatímco zbývající část se vztahuje k lidem."},"c0012":{"cs":"Sokrates se ptá Euthyfróna na význam slova 'terapeia' (péče, služba) v kontextu božské úcty. Používá analogie z péče o koně, psy a dobytek, aby zjistil, zda je bohoslužba prospěšná pro bohy podobně jako péče o zvířata pro jejich majitele. Euthyfrón souhlasí, že péče je vždy prospěšná, nikoli škodlivá."},"c0013":{"cs":"Sókratés se ptá Euthyfróna na společný rys všech svatých činů. Euthyfrón nejprve uvádí příklady svatosti, pak ji definuje jako to, co je bohům milé a co zachraňuje jednotlivce i obce, zatímco bezbožnost vše ničí. Sókratés dále zkoumá, zda svatost spočívá v správném žádání a dávání bohům, a zda taková výměna připomíná obchodní vztah mezi lidmi a bohy."},"c0014":{"cs":"Sókratés se ptá, zda dary, které lidé bohům přinášejí, jsou bohům skutečně prospěšné, a zpochybňuje, zbožné jednání (hosion) jako něco, co je bohům milé, ale ne nutně užitečné. Euthyfrón tvrdí, že svaté je právě to, co je bohům milé, avšak Sókratés ukazuje, že tato definice vede k cirkulární argumentaci, protože dříve rozlišovali mezi svatým a bohům milým jako odlišné pojmy. Výzva k jasné a upřímné definici svatosti zůstává nezodpovězená kvůli Euthyfrónovu spěchu."},"c0015":{"cs":"Sókratés vyčítá svému příteli, že ho zklamal velkou nadějí, protože si myslel, že díky učení od Euthyfróna pochopí rozdíl mezi svatým a světským, zbaví se nevědomosti v náboženských otázkách, vyvázne z obvinění od Mélétos a povede lepší život."}}}