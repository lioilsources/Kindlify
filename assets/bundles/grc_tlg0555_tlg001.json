word"},{"term":"království nebeské","score":0.47,"count":1,"kind":"word"},{"term":"láska božská","score":0.47,"count":1,"kind":"word"},{"term":"malá víra, velké dary","score":0.47,"count":1,"kind":"word"},{"term":"nebeská výprava","score":0.47,"count":1,"kind":"word"},{"term":"nebeská výška","score":0.47,"count":1,"kind":"entity"},{"term":"nové stvoření","score":0.47,"count":1,"kind":"word"},{"term":"osvícení","score":0.47,"count":1,"kind":"word"},{"term":"osvícení myšlení","score":0.47,"count":1,"kind":"word"},{"term":"pastýř","score":0.47,"count":1,"kind":"word"},{"term":"pravá moudrost","score":0.47,"count":1,"kind":"word"},{"term":"přeměna smrti na život","score":0.47,"count":1,"kind":"word"},{"term":"přeměna země v nebe","score":0.47,"count":1,"kind":"word"},{"term":"přítomnost božská","score":0.47,"count":1,"kind":"word"},{"term":"ráj","score":0.47,"count":1,"kind":"entity"},{"term":"světlo poznání","score":0.47,"count":1,"kind":"word"}]},"c0012":{"terms":[{"term":"Kristus","score":1.0,"count":3,"kind":"word"},{"term":"křesťanská tajemství","score":1.0,"count":1,"kind":"word"},{"term":"mytologie","score":1.0,"count":2,"kind":"word"},{"term":"osvobození","score":1.0,"count":4,"kind":"word"},{"term":"pokora","score":1.0,"count":2,"kind":"word"},{"term":"poznání","score":1.0,"count":1,"kind":"word"},{"term":"pravda","score":1.0,"count":4,"kind":"word"},{"term":"víra","score":1.0,"count":1,"kind":"word"},{"term":"God","score":0.89,"count":2,"kind":"entity"},{"term":"Θήβας","score":0.89,"count":2,"kind":"entity"},{"term":"tajemství","score":0.73,"count":2,"kind":"word"},{"term":"θεῷ","score":0.73,"count":2,"kind":"orig"},{"term":"Boží slovo","score":0.68,"count":3,"kind":"word"},{"term":"spasení","score":0.5,"count":2,"kind":"word"},{"term":"θεὸν","score":0.45,"count":2,"kind":"orig"},{"term":"ἀλήθεια","score":0.45,"count":2,"kind":"orig"},{"term":"ἀληθείας","score":0.45,"count":2,"kind":"orig"},{"term":"Christ","score":0.44,"count":1,"kind":"entity"},{"term":"Christ Jesus","score":0.44,"count":1,"kind":"entity"},{"term":"Faith","score":0.44,"count":1,"kind":"entity"},{"term":"Helenismus","score":0.44,"count":1,"kind":"entity"},{"term":"Hesychius","score":0.44,"count":1,"kind":"entity"},{"term":"Páter","score":0.44,"count":1,"kind":"entity"},{"term":"Salvation","score":0.44,"count":1,"kind":"entity"},{"term":"bezbožnost","score":0.44,"count":1,"kind":"word"},{"term":"bohatství","score":0.44,"count":1,"kind":"word"},{"term":"báchké rituály","score":0.44,"count":1,"kind":"word"},{"term":"duchovní cesta","score":0.44,"count":1,"kind":"word"},{"term":"duševní probuzení","score":0.44,"count":1,"kind":"word"},{"term":"lákadlo","score":0.44,"count":1,"kind":"word"},{"term":"láska k Bohu","score":0.44,"count":1,"kind":"word"},{"term":"nebeská vidění","score":0.44,"count":1,"kind":"word"},{"term":"nevědomost","score":0.44,"count":1,"kind":"word"},{"term":"náboženská transformace","score":0.44,"count":1,"kind":"word"},{"term":"následovníci Krista","score":0.44,"count":1,"kind":"word"},{"term":"následování","score":0.44,"count":1,"kind":"word"},{"term":"osvobození od smrti","score":0.44,"count":1,"kind":"word"},{"term":"podoba Boha","score":0.44,"count":1,"kind":"word"},{"term":"podobnost s Bohem","score":0.44,"count":1,"kind":"word"},{"term":"přechod k pravdě","score":0.44,"count":1,"kind":"word"},{"term":"soud","score":0.44,"count":1,"kind":"word"},{"term":"souvislost všeho s Bohem","score":0.44,"count":1,"kind":"word"},{"term":"svatost","score":0.44,"count":1,"kind":"word"},{"term":"svatý taneční kruh","score":0.44,"count":1,"kind":"word"},{"term":"víra a rozum","score":0.44,"count":1,"kind":"word"},{"term":"víra v Krista","score":0.44,"count":1,"kind":"word"},{"term":"vědomí boží pravdy","score":0.44,"count":1,"kind":"word"},{"term":"životní styl","score":0.44,"count":1,"kind":"word"},{"term":"Σειρῆνες","score":0.44,"count":1,"kind":"entity"},{"term":"Σεμέλης","score":0.44,"count":1,"kind":"entity"}]}}},"summaries":{"root":{"cs":"„Προτρεπτικὸς πρὸς Ἕλληνας“ je apologetická práce Clementa z Alexandrie, která v 12 kapitolách kritizuje pohanské náboženství, mytologii, idolatrii, rituály a filozofické představy jako zavádějící iluze. Autor vyzývá Řeky k přijetí křesťanské pravdy, osvobození prostřednictvím Krista a poznání Boha jako jediného, neviditelného a nekonečného Stvořitele. Dílo kombinuje kritiku antické kultury s křesťanskou teologií, představuje Krista jako zjevení pravdy a zákonu a zdůrazňuje důležitost vnitřní přeměny, víry a poznání. Knihovna má překlad do češtiny."},"c0001":{"cs":"Kapitola začíná příběhem řeckých mýtů o hudebnících, jako Amphión, Arion a Eúnomos, jejichž zpěv měl magickou moc nad zvířaty, přírodou a dokonce i mrtvými. Autor tyto příběhy kritizuje jako iluze, které zavádějí lidstvo do otroctví démonů a idolatrie. Naopak vyzývá k přijetí pravé, nebeské pravdy, která se projevuje v božském zákonném slově, uspořádávajícím vesmír a člověka jako malý kosmos. Kristus je zjevením tohoto slova, které osvobozuje od hříchu, smrti a zločinnosti, a vede k věčnému životu. Závěr zdůrazňuje, že pravda je věčná, zatímco pošetilost je stará, a že skrze víru a čistotu se člověk stává dědicem nebeského království."},"c0002":{"cs":"Kapitola 2 díla 'Προτρεπτικὸς πρὸς Ἕλληνας' představuje systematickou kritiku pohanských náboženských tradic, mytů a rituálů. Clement z Alexandrie odhaluje, že orákula, tajemství a božské příběhy – jako ty o Dionýsovi, Zévu, Afrodité nebo Demeter – jsou založeny na iluzích, zneužívání a zavádějících představách. Kritizuje symboliku spojenou s obětmi, sexuálními a smrtelnými motivy, které podkopávají morální a náboženský pořádek. Zároveň upozorňuje na nesrovnalosti v mytologii, neslučitelnost božské přirozenosti s lidskými slabostmi a zneužíváním svatých symbolů. Vyzývá čtenáře k přechodu od mytologických iluzí k pravému poznání jediného Boha a spasení prostřednictvím Krista, který živým slovem vzkřísil lidstvo."},"c0003":{"cs":"Clement v této kapitole kritizuje základní prvky pohanského náboženství, zejména lidské oběti, které jsou podle něj zcela zvrácené a v rozporu s lidskou morálkou. Představuje bohové jako zlé duchy, kteří se radují z lidské smrti a vytvářejí příležitosti k válce a vraždě. Předkládá konkrétní příklady z historie a mytologie – jako například oběť Aristoména, oběti v Tauridě, nebo tragédii Króise – aby ukázal, že proroctví a božské vůle často vedou k tragédii. Zároveň ukazuje, že svatyně, oběti a pocty mrtvým jsou výsledkem lidských fantazí a nejsou založeny na pravdě. Konečně tvrdí, že skutečným zdrojem zla je člověk, nikoli bohové, a že pravda je v lidském rozumu, nikoli v mýtech."},"c0004":{"cs":"Clement v této kapitole rozebírá náboženskou praxi uctívání soch a obrazů jako zcela zavádějící a nesmyslné. Ukazuje, že všechny sochy – od kamenných a dřevěných předmětů po zlaté a kovové výtvory – jsou výrobky lidské ruky, bezdušné a nevědomé. Představuje příklady z historie, jako je socha Serapa v Egyptě, Antinoo jako boh, nebo sochy v Athénách a Samu, aby ukázal, že jejich původ je vždy lidský, nikoli božský. Kritizuje i příběhy o jejich „životnosti“ nebo „božském původu“. Zdůrazňuje, že pravý boh je neviditelný, nezničitelný a poznatelný pouze myšlením, nikoli smysly. Vyzývá k odmítnutí idolatrie a k přijetí pravé víry v Boha jako Stvořitele světa, který stvořil nebe i zemi jediným vůlí. Výsledkem je výzva k vnitřnímu poznání a odvrácení od zemských, hmotných symbolů k duchovnímu poznání Boha."},"c0005":{"cs":"Kapitola se zabývá kritikou filozofických teorií o božstvích a vesmíru u starověkých myslitelů, kteří přirozené prvky (voda, vzduch, oheň, země) považovali za základní božstva. Clement z Alexandrie zpochybňuje, zda tato představa skutečně odráží pravdu, a upozorňuje, že i když některé kultury vyhýbají se idolatrii, mohou se přesunout do jiné formy iluze, když místo soch uctívají přírodní elementy jako filozofy. Kritizuje také představy o planetách jako bozích, o kosmické duši jako bohu a o nebeských tělesech jakožto projevech božství, které považuje za nesmyslné a nekřesťanské. Zvláštní pozornost věnuje Epikurovi, který podle něj odmítá zájem boha o svět, a Herakleidovi z Pontu, který je ovlivněn Demokritovými myšlenkami."},"c0006":{"cs":"Clement v kapitole 6 upozorňuje na nebezpečí mytologizace a nesmyslných příběhů, které zavádějí lidi, zejména děti, do nepravdivých představ o bozích a vesmíru. Kritizuje astrologii jako záměnu za vědu a vyhledává pravdu v božství jako vytvůrci světa, nikoli v jeho dílech. Zaměřuje se na důležitost rozumu a pravého slova jako zdroje božského poznání, které se projevuje v nitru duše. Boh je popsán jako jediné spravedlivé měřítko všeho bytí, které všechno měří a udržuje. Kritizuje falešná měřítka a idolátrie a chválí hebrejskou víru, která uctívá jediného nekonečného Boha. Pravá božská pravda se objevuje pouze při hlubokém zrození, vědomém přípravě a duchovní čistotě."},"c0007":{"cs":"Kapitola se zabývá neschopností filosofie a poezie plně vyjádřit pravdu, když jsou zaměřeny na myty a iluze. Přesto autor uznává, že i řecká poezie, zejména Orfeův příběh po rituálu orfických obřadů, obsahuje zárodky pravdy o jediném, nezrozeném, nebeském Bohu, který je zdrojem všeho, vidí všechno, ale není viděn smrtelníky. Kritizuje lidské zbožnosti založené na sochách a prázdných obětech, a ukazuje, jak básníci jako Homér, Euripidés a Menandros zpochybňují a posmívají se řeckých bohů, což vede k přemýšlení o spravedlnosti, morálce a skutečné věře. Text vyzývá k přemýšlení o tom, jak může být pravda přesto přinášena i přes poezii, i když neúplně."},"c0008":{"cs":"Kapitola se zaměřuje na význam prorockých textů jako zdroje pravdy a cesty k spasení. Clement vysvětluje, že prorocké slovo, jako je řeč Sibylly nebo proroctví Jeremiáše a Izaiáše, osvětlují jedinost Boha a jeho přítomnost ve vesmíru. Zdůrazňuje, že Bůh nejen vidí všechny skryté činy, ale že je i všude přítomen – v nebi i na zemi. Idoly, které lidé pokládají za bohy, budou zničeny před sluncem a měsícem, a jejich zbytky se stanou potravou pro zvířata. Pravá víra a poznání Boha, které pochází od něj, vedou k osvobození od iluzí a hříchu. Kapitola zavěšuje na Mojžíšovo přikázání jedinosti Boha a výzvu Davida k poznání a pokání, a ukazuje, že Boží slovo zůstává navěky, zatímco vesmír bude zničen a zjevena Boží moc."},"c0009":{"cs":"Kapitola je intenzivním povzbuzením k poslušnosti Božímu slovu a k přijetí spasení prostřednictvím víry, strachu před Božím hnevu a lásky k milosti. Clement zdůrazňuje, že k vstupu do nebeské království je nutné se narodit znovu jako dítě, což je podmínkou přijetí jako dítě Boží. Text varuje před sebepřesahem a odmítáním Boží milosti, která nabízí osvobození, život a svobodu, ale lidé se zvolením závislosti a smrti sami způsobují své zničení. Zdůrazňuje, že Boží slovo je výzvou k probuzení z temnoty a k přijetí spasení prostřednictvím Krista, slunce vstání, a že každý den přináší novou příležitost k osvobození. Pravá „dnes“ je nekonečná a spojující se s věčným časem."},"c0010":{"cs":"Klement Alexandrinský v této kapitole vystupuje proti národnímu zvyku, který se předává z generace na generaci a který je podle něj neuvážený a nepravdivý. Porovnává lidi s nesklonými koněmi, kteří odmítají vedení, a vyzývá je k odtržení od zvyků, které jsou jako otravné léky. Kritizuje náboženskou praxi, která se soustředí na sochy a neživé předměty, a porovnává jejich stav s utrpením a ztrátou lidského důstojenství. Zdůrazňuje, že pravý Bůh je milující otec, který osvobozuje a léčí, a vyzývá k přechodu od nevědomosti k poznání, od zlých zvyků k božímu zákonu. Vyzývá k pokání, k návratu k Bohu a k životu v pravdě, spravedlnosti a moudrosti, který je přístupný každému, kdo má touhu po spasení."},"c0011":{"cs":"Kapitola 11 Clementa z Alexandrie vypráví o ztrátě původního stavu člověka v ráji, kdy Adam podle křesťanské allegorie podléhl hříšné touze (přirovnávané k hadovi) a porušil poslušnost Bohu. Kristus, přicházející jako člověk, přebírá tuto hříšnou touhu, poráží smrt a osvobozuje člověka, který byl ztracen v hříchu. Tím se zpřístupňuje nebeská výška a věčná životní cesta. Autor vyzývá k odmítnutí mytologických příběhů o Minosovi a přijetí pravé moudrosti, kterou získali učedníci Krista. Zdůrazňuje, že Kristus je jediným učitelem, který všemi prostředky — zákonem, proroctvím, učením — již všem lidem předal plnou pravdu. Boží slovo je světlem, které osvětlující mysl a umožňuje poznání Boha i člověka. Text je vyjádřen jako hlas modlitby a učení, kde se spojují osvícení, učení a příbuzenská vazba s Bohem. Závěr vyzývá k odmítnutí tmy a hříchu, k přijetí světla pravdy a k vnitřnímu oživení, aby člověk byl hodný království Božího."},"c0012":{"cs":"Clement v kapitole 12 vyzývá čtenáře k útěku od zvyků, které jsou nebezpečné jako Charybda, Síryny nebo zatracená ostrov s pohanskými lákadly. Tyto zvyky zavádějí od pravdy, života a osvobození. Kritizuje mytologické a orakulární praxe, které jsou založeny na iluzích a nevědomosti. Naopak nabízí křesťanské tajemství jako místo pravého poznání, kde se člověk stává podobným Bohu. Vyzývá k přijetí jediného Božího slova, k pokornosti a následování Krista, který je mírný a lehký nositel závaží. Pravý život je založen na víře, rozumu a ctnosti, a vede k nekonečné životnosti a vidění Boha."}}}