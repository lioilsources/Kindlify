:"pomník","score":0.4,"count":1,"kind":"word"},{"term":"půjčka","score":0.4,"count":1,"kind":"word"},{"term":"smíření","score":0.4,"count":1,"kind":"word"},{"term":"textilní dary","score":0.4,"count":1,"kind":"word"},{"term":"zlo","score":0.4,"count":1,"kind":"word"},{"term":"území","score":0.4,"count":1,"kind":"word"},{"term":"řecké obce","score":0.4,"count":1,"kind":"word"},{"term":"Δίς","score":0.4,"count":1,"kind":"entity"}]},"c0012":{"terms":[{"term":"Athéňané","score":1.0,"count":2,"kind":"entity"},{"term":"Spartané","score":1.0,"count":1,"kind":"entity"},{"term":"bohové","score":1.0,"count":1,"kind":"word"},{"term":"diplomacie","score":1.0,"count":1,"kind":"word"},{"term":"mír","score":1.0,"count":2,"kind":"word"},{"term":"opilost","score":1.0,"count":1,"kind":"word"},{"term":"rituál","score":1.0,"count":1,"kind":"word"},{"term":"tanec","score":1.0,"count":2,"kind":"word"},{"term":"ΧΟΡῸΣ ΛΑΚΕΔΑΙΜΟΝΊΩΝ","score":1.0,"count":2,"kind":"orig"},{"term":"ΧΟΡῸΣ ἈΘΗΝΑΊΩΝ","score":1.0,"count":2,"kind":"orig"},{"term":"ΛΆΚΩΝ","score":0.83,"count":2,"kind":"orig"},{"term":"ἈΘΗΝΑΙ͂ΟΣ","score":0.83,"count":2,"kind":"orig"},{"term":"Dionýsos","score":0.5,"count":1,"kind":"entity"},{"term":"Lakóni","score":0.5,"count":1,"kind":"entity"},{"term":"aténské ženy","score":0.5,"count":1,"kind":"word"},{"term":"bohyně","score":0.5,"count":1,"kind":"word"},{"term":"bohyně Artemis","score":0.5,"count":1,"kind":"word"},{"term":"chorus","score":0.5,"count":1,"kind":"word"},{"term":"diplomatická mise","score":0.5,"count":1,"kind":"word"},{"term":"kulturní rozdíl","score":0.5,"count":1,"kind":"word"},{"term":"moudrost","score":0.5,"count":1,"kind":"word"},{"term":"posel","score":0.5,"count":1,"kind":"word"},{"term":"přátelství","score":0.5,"count":1,"kind":"word"},{"term":"ritual","score":0.5,"count":1,"kind":"word"},{"term":"spartské ženy","score":0.5,"count":1,"kind":"word"},{"term":"vítězství","score":0.5,"count":1,"kind":"word"},{"term":"Βάκχιος","score":0.5,"count":1,"kind":"orig"},{"term":"Εὐρώταν","score":0.5,"count":1,"kind":"orig"},{"term":"Κύπρις","score":0.5,"count":1,"kind":"orig"},{"term":"Λακεδαίμονα","score":0.5,"count":1,"kind":"orig"},{"term":"Νύσιον","score":0.5,"count":1,"kind":"orig"},{"term":"Χάριτας","score":0.5,"count":1,"kind":"orig"},{"term":"μεθύοντες","score":0.5,"count":1,"kind":"orig"},{"term":"μετὰ σοῦ","score":0.5,"count":1,"kind":"orig"},{"term":"νήφοντες","score":0.5,"count":1,"kind":"orig"},{"term":"νὴ τὸν Δίʼ","score":0.5,"count":1,"kind":"orig"},{"term":"σύμπόσιον","score":0.5,"count":1,"kind":"orig"},{"term":"φυσατήρια","score":0.5,"count":1,"kind":"orig"},{"term":"Ἀρτεμιν","score":0.5,"count":1,"kind":"orig"},{"term":"Artemis","score":0.41,"count":1,"kind":"entity"},{"term":"Diós","score":0.41,"count":1,"kind":"entity"},{"term":"víno","score":0.41,"count":1,"kind":"word"},{"term":"Δία","score":0.41,"count":1,"kind":"orig"},{"term":"Lysistraté","score":0.38,"count":2,"kind":"entity"},{"term":"Afrodita","score":0.36,"count":1,"kind":"word"},{"term":"Athény","score":0.36,"count":1,"kind":"entity"},{"term":"Sparta","score":0.36,"count":1,"kind":"entity"},{"term":"Ἄρτεμιν","score":0.36,"count":1,"kind":"orig"},{"term":"Zeus","score":0.3,"count":1,"kind":"entity"},{"term":"ΛΥΣΙΣΤΡΆΤΗ","score":0.3,"count":1,"kind":"orig"}]}}},"summaries":{"c0001":{"cs":"Lysistraté svolává ženy z Athén, Béótií a Peloponésu k tajnému jednání, kde navrhuje, aby se vzdaly sexuálního styku s muži a obsadily Akropoli jako nátlak na ukončení peloponéské války. Ženy přísahají věrnost plánu a diskutují o jeho provedení."},"c0002":{"cs":"V parodosu 2 Lysistraté se střetávají sbory starších mužů a žen u Akropole. Muži vyjadřují překvapení nad ženským odporem, hrozí zapálením jejich pozic a vzpomínají na své vojenské činy, zatímco kritizují mužskou slabost. Ženy naopak reagují s odporem, ironií a odkazem na vlastní sílu, vyhýbají se podřízení a kritizují tvrdé zákony a muže jako zdroje zkázy. Dialog je plný urážek, metafor o ohni a teple, a odkazů na bohyni Niké, přičemž obě strany se snaží získat převahu ve slovním i symbolickém boji o kontrolu nad Akropolem a městem."},"c0003":{"cs":"Lysistraté čelí Probulosovi, který se snaží násilím vniknout do Akropole obsazené ženami. Odmítá použití síly a tvrdí, že k míru vede rozum a vůle, nikoli meče. Zdůrazňuje organizaci ženských jednotek a jejich odpor k násilí, zatímco Probulos zoufale hledá zbraně a uráží ženy."},"c0004":{"cs":"Lysistrata argumentuje, že ženy by měly převzít kontrolu nad státními financemi, aby zastavily války financované penězi, a nabízí i sexuální abstinenci jako prostředek k míru. Probulos vyjadřuje skepsi, ale Lysistrata trvá na tom, že ženy zachrání Řecko svou moudrostí a domácími dovednostmi, přirovnávajícími politiku k předení vlny či čištění domu."},"c0005":{"cs":"Probouloš vyjadřuje své trápení a ptá se, zda musí takové věci snášet. Lysistrata odpovídá, že ho neobviňuje z nedostatku přípravy, ale ujišťuje ho, že třetího dne ráno přinese připravená jídla, což naznačuje plánovanou podporu a strategické čekání na správný okamžik."},"c0006":{"cs":"Starší muži vyjadřují obavy z možné zrady Lakóňanů a lamentují nad úpadkem své síly, zatímco ženy kritizují muže za neschopnost finančně přispívat státu a obhajují svou užitečnost pro polis. Dialog obsahuje prvky ironie, odkazů na mytologické postavy (Artemisia, Amazónky) a rituálního omlazení prostřednictvím tance a svlečení zbroje. Ženy také odmítají mužskou autoritu a zdůrazňují svou nezávislost."},"c0007":{"cs":"Lysistrata konfrontuje ženy, které se snaží opustit shromáždění pod různými záminkami – praní plen, bodnutí škorpionem, předstírané těhotenství – a odhaluje jejich nesrovnalosti. Naléhá na ně, aby zůstaly pevné v sexuální stávce proti válce, a odkazuje na božské znamení (vlaštovky) jako naději na mír, pokud nezradí orákulum."},"c0008":{"cs":"V lyrické scéně 8 starší muži a ženy střídavě vyprávějí příběhy o mužích jako Melaníón a Tímón, kteří opustili společnost, aby unikli manželství a ženám, žijíce v pustyni se zvířaty, zatímco ženy reagují s ironií a humorem na jejich postoje, zdůrazňujíce absurditu jejich útěku a trvalou přítomnost žen v jejich myšlenkách."},"c0009":{"cs":"V této lyrické scéně Lysistraté konfrontuje Kinéa, manžela Myrrhiny, který trpí sexuální abstinencí kvůli ženskému bojkotu intimnosti. Přes komické výměny o věrnosti, touze a rodinných povinnostech Lysistraté zdůrazňuje, že ženská síla spočívá v jejich schopnosti odepřít sexuální kontakt jako politický nátlak na ukončení války. Kinéas nakonec uznává účinnost ženského hnutí a souhlasí s mírovými jednáními."},"c0010":{"cs":"Sbor starých mužů uráží ženy jako zbabělé a ošklivé, zatímco sbor žen odpovídá výhrůžkami fyzického trestu a odhodláním políbit muže navzdory jejich odporu. Po výměně urážek a vzájemném osočování z nevěrnosti a zbabělosti během války se oba sbory rozhodnou překonat rozdíly a začít společně zpívat v duchu spolupráce a mírnosti."},"c0011":{"cs":"Lysistraté se hlásí jako vyjednavačka míru mezi Athénami a Spartou, odmítá násilí a zdůrazňuje ženskou moudrost a rozumné jednání. Nabízí, že její služky přinesou mírovou dohodu prostřednictvím osobního kontaktu a vzájemné důvěry, zatímco chór komentuje situaci a připomíná potřebu smíření."},"c0012":{"cs":"Scéna začíná hádkou mezi athénskými občany o otevření dveří a neochotě ustoupit, následovanou výměnou názorů s lakonským poslem ohledně opilosti a diplomatické účinnosti. Athéňané tvrdí, že jsou moudřejší při pití, zatímco Lakóni jsou považováni za příliš vážné. Poté následuje střídavý zpěv sborů, vzývající bohyně jako Artemis, Afroditu a Dionýsa, oslavující mír, radost a vítězství prostřednictvím tance a hudby. Nakonec Athéňané vyzývají k tanci a uctívání bohů, zatímco Spartané popisují své tradiční rituály spojené s mládím, krásou a válečnou slávou."}}}