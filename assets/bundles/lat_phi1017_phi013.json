term":"dignus","score":0.3,"count":2,"kind":"orig"},{"term":"dobrodiní","score":0.3,"count":6,"kind":"word"},{"term":"etika","score":0.3,"count":7,"kind":"word"},{"term":"fortuna","score":0.3,"count":4,"kind":"orig"},{"term":"gratiam","score":0.3,"count":5,"kind":"orig"},{"term":"inimicus","score":0.3,"count":2,"kind":"orig"},{"term":"iniuria","score":0.3,"count":5,"kind":"orig"},{"term":"legi","score":0.3,"count":2,"kind":"orig"},{"term":"lékař","score":0.3,"count":2,"kind":"word"},{"term":"opatrnost","score":0.3,"count":2,"kind":"word"},{"term":"optas","score":0.3,"count":2,"kind":"orig"},{"term":"pecus","score":0.3,"count":2,"kind":"orig"},{"term":"pomoc","score":0.3,"count":4,"kind":"word"},{"term":"populum","score":0.3,"count":2,"kind":"orig"},{"term":"pověst","score":0.3,"count":2,"kind":"word"},{"term":"strategie","score":0.3,"count":2,"kind":"word"},{"term":"testis","score":0.3,"count":2,"kind":"orig"},{"term":"universis","score":0.3,"count":2,"kind":"orig"},{"term":"vlastní zájem","score":0.3,"count":2,"kind":"word"},{"term":"voluntas","score":0.3,"count":4,"kind":"orig"},{"term":"votum","score":0.3,"count":2,"kind":"orig"}]},"c0007":{"terms":[{"term":"Seneca","score":1.0,"count":23,"kind":"entity"},{"term":"ctnost","score":1.0,"count":14,"kind":"word"},{"term":"darování","score":1.0,"count":3,"kind":"word"},{"term":"děkování","score":1.0,"count":7,"kind":"word"},{"term":"klid","score":1.0,"count":1,"kind":"word"},{"term":"moudrost","score":1.0,"count":12,"kind":"word"},{"term":"nevděčnost","score":1.0,"count":5,"kind":"word"},{"term":"přátelství","score":1.0,"count":15,"kind":"word"},{"term":"vlastnictví","score":1.0,"count":9,"kind":"word"},{"term":"beneficium","score":0.52,"count":12,"kind":"orig"},{"term":"sapientis","score":0.42,"count":4,"kind":"orig"},{"term":"etika","score":0.35,"count":8,"kind":"word"},{"term":"deorum","score":0.33,"count":4,"kind":"entity"},{"term":"reddere","score":0.32,"count":6,"kind":"orig"},{"term":"communia","score":0.31,"count":3,"kind":"orig"},{"term":"sapienti","score":0.31,"count":3,"kind":"orig"},{"term":"zločinec","score":0.31,"count":3,"kind":"word"},{"term":"Mucio","score":0.3,"count":2,"kind":"orig"},{"term":"Phalaris","score":0.3,"count":2,"kind":"entity"},{"term":"Porsinae","score":0.3,"count":2,"kind":"entity"},{"term":"Titus Livius","score":0.3,"count":2,"kind":"orig"},{"term":"amicis","score":0.3,"count":4,"kind":"orig"},{"term":"bohatství","score":0.3,"count":5,"kind":"word"},{"term":"contentus","score":0.3,"count":2,"kind":"orig"},{"term":"divitias","score":0.3,"count":2,"kind":"orig"},{"term":"dluh","score":0.3,"count":5,"kind":"word"},{"term":"dobrodiní","score":0.3,"count":4,"kind":"word"},{"term":"donare","score":0.3,"count":2,"kind":"orig"},{"term":"filozofie","score":0.3,"count":2,"kind":"word"},{"term":"imperio","score":0.3,"count":3,"kind":"orig"},{"term":"ingratus","score":0.3,"count":5,"kind":"orig"},{"term":"luxus","score":0.3,"count":2,"kind":"word"},{"term":"majetek","score":0.3,"count":2,"kind":"word"},{"term":"malus","score":0.3,"count":3,"kind":"orig"},{"term":"moralita","score":0.3,"count":4,"kind":"word"},{"term":"morální závazek","score":0.3,"count":2,"kind":"word"},{"term":"omnium","score":0.3,"count":3,"kind":"orig"},{"term":"povinnost","score":0.3,"count":4,"kind":"word"},{"term":"právo","score":0.3,"count":2,"kind":"word"},{"term":"pudor","score":0.3,"count":2,"kind":"orig"},{"term":"reddidit","score":0.3,"count":2,"kind":"orig"},{"term":"sacrilegus","score":0.3,"count":2,"kind":"orig"},{"term":"sapiens","score":0.3,"count":3,"kind":"orig"},{"term":"sdílení","score":0.3,"count":2,"kind":"word"},{"term":"societatem","score":0.3,"count":2,"kind":"orig"},{"term":"společenský řád","score":0.3,"count":2,"kind":"word"},{"term":"vděčnost","score":0.3,"count":5,"kind":"word"},{"term":"vnitřní klid","score":0.3,"count":2,"kind":"word"},{"term":"věrnost","score":0.3,"count":6,"kind":"word"},{"term":"úsilí","score":0.3,"count":3,"kind":"word"}]}}},"summaries":{"root":{"cs":"„O dobrodinstvích“ je etická práce Luciusa Annaei Senecy, která se zabývá podstatou dárků, jejich přijímáním a odpovědností za ně. Seneca argumentuje, že skutečná hodnota dobrodinství spočívá v ctnostní vůli dárce, nikoli v materiální hodnotě daru. Kniha je strukturována do sedmi kapitol, které procházejí etikou poskytování a přijímání darů, kritizují nevděčnost, zbytečné zpomalení a formální děkování. Zdůrazňuje, že ctnost je možná i bez výhody, a že pravá moudrost spočívá v duševním klidu a vnitřním vlastnictví. Dílo je překladem z latinského originálu."},"c0001":{"cs":"Seneca v této kapitole rozvíjí filozofickou teorii dobrodiní, která se odlišuje od pověřeného pojetí jako výměny zásluh. Podle něj není dobrodiní v hmotném daru, ale v dobré vůli dárce, která je základem morální hodnoty. Kritizuje nevděčnost, která se projevuje odmítáním, zdržováním nebo neupřímným přijímáním darů. Zdůrazňuje, že pravá vděčnost je vnitřní, neformální a spočívá v odpouštění a větší štědrosti. Dárci by měli darovat s úmyslem, nikoli z výhody, a příjemci by měli přijímat s vědomím, že dluh přesahuje materiální protislužbu. Kapitola také rozlišuje mezi nutnými, užitečnými a příjemnými dary a upozorňuje na důležitost vhodnosti, vzácnosti a trvalosti darů."},"c0002":{"cs":"Kniha 2 díla 'O dobrodincích' se zaměřuje na etiku a správný způsob poskytování dobrodinství. Seneca vysvětluje, že dobrodinství by mělo být dáno rychle, srdce vědomě a bez váhání, aby nebylo považováno za něco, co se musí vynutit. Důležité je předcházet požadavku a dávat, než bude žádáno, aby bylo darování považováno za přirozené. Kritizuje zbytečné zpomalení, které způsobuje utrpení a ztrácí důvěru. Zdůrazňuje, že dárky by měly být poskytovány s úmyslem, bez chvástání a zbytečného připomínání, aby nezničily jejich duchovní hodnotu. Seneca také rozvíjí myšlenku tajného poskytování dárků, které má za cíl zachovat důstojnost příjemce. Zároveň upozorňuje na nebezpečí, kdy se dárky ztrácejí přes mnoho rukou, a varuje před zbytečným odkládáním, které způsobuje utrpení a zneužívá důvěru."},"c0003":{"cs":"Kniha 3 se zabývá hlubokými etickými a psychologickými aspekty nevděčnosti, rozlišuje mezi zapomněním a záměrným odmítnutím uznání dluhu. Seneca argumentuje, že zapomnění může být omluvou, ale nevědomost nebo záměrné odmítnutí uznání dluhu je vážnější. Zdůrazňuje, že skutečná vděčnost vyžaduje paměť, čas, schopnost a štěstí, a že ten, kdo dar zcela ztratil z paměti, nemůže být nikdy vděčný. Kritizuje, že nevděčnost je v rozporu s přirozenou spravedlností a že dárky ztrácejí svou hodnotu, když se stávají závazky. Zdůrazňuje, že ctnostní čin je možný i od nízkého postavení, a že děkování je ctnost, která ztrácí smysl, když je nutná. Zároveň se ptá, jak může být spravedlivě ohodnoceno dobré čin, když jeho hodnota závisí na intenci a okolnostech."},"c0004":{"cs":"Kniha čtvrtá se zabývá filozofickou diskuzí o tom, zda je dobrodružství (beneficium) a odpovídající vděčnost (gratia) samy o sobě ctností, kterou je třeba chtít pro její vlastní hodnotu, nikoli kvůli užitku. Seneca argumentuje proti zneužívání ctnosti jako nástroje pro výhodu a zdůrazňuje, že pravá ctnost, včetně dobrodružství, má svou hodnotu v sobě. Kritizuje epikurejskou filozofii, která ctnost považuje za služebnici potěšení, a argumentuje, že ctnost musí být samostatným a vyšším cílem života. Zdůrazňuje, že bohové dají dary lidem bez očekávání odměny a že všechny přírodní bohatství a podmínky života jsou nezbytnými dary, které svědčí o jejich milosrdné péči. Přiroda, osud a božstvo jsou různými jmény jediného zdroje všeho, a dobrodinství je vlastně přirozenou a ctnostnou odpovědí na vlastní čin."},"c0005":{"cs":"Kniha 5 díla 'O dobrodincích' se zaměřuje na hlubší etický výklad přátelství a děkování za laskavost. Seneca argumentuje, že pravé děkování je vnitřní a nezávislé na uznání. Ukazuje, že nikdo nemůže být poražen dobrodinstvím, pokud ví, co dluží, a chce odpovědět stejnou měrou. Zdůrazňuje, že skutečná vítězství jsou duševní a nezávisí na počtu nebo velikosti darů, ale na vnitřní rovnováze a ctnosti. Příklady Sokrata, Diogena a Lakedaimonců ilustrují, že ctnost spočívá v nezvítězení, nikoli v fyzickém vítězství. Zároveň se vysvětluje, že porážka v morálním souboji není hanbou, pokud se nevzdáváme správného záměru."},"c0006":{"cs":"V knize 6 Seneca rozvíjí myšlenku, že dobrodinství je nezničitelné, i když bylo ztraceno nebo zneužito. Důležité není materiální příjem, ale dobrá vůle, kterou dárce vyjádřil. Pokud někdo pomohl z vlastního záměru, i když byl následně zneužit, dluh zůstává. Seneca rozlišuje mezi náhodným přínosem a skutečným dobrodinstvím, které vyžaduje vůli. Příklady z historie, jako je Demaratus a Xerxes, ukazují, že síla neznamená vítězství, pokud chybí správná vůle. Důležité je i přátelství, které vyžaduje věrnost, ne závislost. Skutečná vděčnost spočívá v připravenosti být užitečným, i když druhý má všechno. Přijetí dluhu je stejně důležité jako jeho poskytnutí."},"c0007":{"cs":"Kniha 7 díla 'O dobrodincích' se zaměřuje na hlubokou filozofickou úvahu o přirozenosti moudrosti, vlastnictví a morální odpovědnosti. Seneca argumentuje, že pravá moudrost spočívá v duševním klidu, vnitřním vlastnictví všeho a odmítnutí strachu před bohy i lidmi. Moudrý člověk, který má všechno, nemůže být příjemcem daru, protože vše, co by mu bylo dán, je již jeho vlastní. Přesto může darovat, protože darování je výrazem vnitřní ctnosti. Kniha kritizuje přehnaný luxus, zbytečné bohatství a zneužívání přírodních a lidských hodnot. Zdůrazňuje, že skutečná vděčnost spočívá v úsilí a záměru, nikoli v formálním vrácení. I když příjemce je nevděčný nebo zlý, dluh se musí splnit, protože ctnostní chování je vlastní samotnému dlužníkovi. Seneca vyzývá k trpělivosti, pochopení a udržení víry, i když je příjemce nevděčný."}}}