"kind":"entity"},{"term":"Cotta","score":0.32,"count":9,"kind":"entity"},{"term":"Alabandus","score":0.3,"count":2,"kind":"entity"},{"term":"Aristo Chius","score":0.3,"count":2,"kind":"orig"},{"term":"Athény","score":0.3,"count":2,"kind":"entity"},{"term":"Atreus","score":0.3,"count":2,"kind":"entity"},{"term":"C. Marius","score":0.3,"count":2,"kind":"orig"},{"term":"Caelus","score":0.3,"count":2,"kind":"entity"},{"term":"Ceres","score":0.3,"count":4,"kind":"entity"},{"term":"Chrysippus","score":0.3,"count":4,"kind":"entity"},{"term":"Cinna","score":0.3,"count":2,"kind":"entity"},{"term":"Cleanthes","score":0.3,"count":5,"kind":"entity"},{"term":"Dies","score":0.3,"count":2,"kind":"orig"},{"term":"Diogenes","score":0.3,"count":2,"kind":"entity"},{"term":"Duha","score":0.3,"count":2,"kind":"entity"},{"term":"Fatum","score":0.3,"count":2,"kind":"orig"},{"term":"Hercules","score":0.3,"count":5,"kind":"entity"},{"term":"Homerus","score":0.3,"count":2,"kind":"entity"},{"term":"Ino","score":0.3,"count":2,"kind":"entity"},{"term":"Iuppiter","score":0.3,"count":6,"kind":"entity"},{"term":"Liber","score":0.3,"count":3,"kind":"entity"},{"term":"Minerva","score":0.3,"count":4,"kind":"entity"},{"term":"Neptunus","score":0.3,"count":4,"kind":"entity"},{"term":"Proserpina","score":0.3,"count":4,"kind":"entity"},{"term":"Stoikové","score":0.3,"count":4,"kind":"entity"},{"term":"Velleius","score":0.3,"count":6,"kind":"entity"},{"term":"Volcano","score":0.3,"count":3,"kind":"orig"},{"term":"Zenon","score":0.3,"count":5,"kind":"entity"},{"term":"aether","score":0.3,"count":4,"kind":"orig"},{"term":"dolor","score":0.3,"count":3,"kind":"orig"},{"term":"genealogie bohů","score":0.3,"count":3,"kind":"word"},{"term":"kult","score":0.3,"count":4,"kind":"word"},{"term":"natura","score":0.3,"count":5,"kind":"orig"},{"term":"nesmrtelnost","score":0.3,"count":3,"kind":"word"},{"term":"osud","score":0.3,"count":3,"kind":"word"},{"term":"providence","score":0.3,"count":3,"kind":"word"},{"term":"příroda","score":0.3,"count":6,"kind":"word"},{"term":"ratio","score":0.3,"count":4,"kind":"orig"},{"term":"spravedlnost","score":0.3,"count":5,"kind":"word"},{"term":"věčnost","score":0.3,"count":5,"kind":"word"},{"term":"zánik","score":0.3,"count":3,"kind":"word"}]}}},"summaries":{"c0001":{"cs":"Cicero uvádí, že otázka přirozenosti bohů je obtížná, ale zásadní pro poznání duše a správné náboženství, kritizuje bezduché hájení neprozkoumaných názorů a zdůrazňuje potřebu opatrnosti ve filozofickém zkoumání kvůli rozdílným stanoviskům učenců."},"c0002":{"cs":"Cicero zdůrazňuje výjimečnost lidských smyslů a rozumu oproti zvířatům, které umožňují vnímat krásu, řád, ctnosti a tvořit vědu, umění a společnost. Lidská řeč je božský dar umožňující učení, přesvědčování a spravedlivý život. Lidská nadřazenost dokazuje schopnost ovládat přírodu, využívat kovy, plout po moři, rozumět nebesům a pěstovat plody. Tento rozum spojuje s božskou prozřetelností, kdy umění předpovídat budoucnost (haruspici, augurové, sny) je dar bohů, podporující pobožnost, spravedlnost a šťastný život."},"c0003":{"cs":"Cotta reaguje na Balbův výklad tím, že vysvětluje, že se na diskuzi připravoval spíše proto, aby pochopil nejasné body, než aby vyvrátil Balbův názor. Velleius vyjadřuje očekávání od Cottovy řeči proti stoikům, zatímco Cotta kritizuje Epikurosův přístup k bohům jako nekonzistentní a povrchní."}}}