tumor","score":0.3,"count":10,"kind":"orig"},{"term":"uncus","score":0.3,"count":5,"kind":"orig"},{"term":"varlata","score":0.3,"count":5,"kind":"word"},{"term":"vesica","score":0.3,"count":12,"kind":"orig"},{"term":"vulnus","score":0.3,"count":6,"kind":"orig"}]},"c0008":{"terms":[{"term":"De Medicina","score":1.0,"count":53,"kind":"entity"},{"term":"anatomie","score":1.0,"count":10,"kind":"word"},{"term":"chirurgie","score":1.0,"count":3,"kind":"word"},{"term":"diagnostika","score":1.0,"count":1,"kind":"word"},{"term":"kost","score":1.0,"count":10,"kind":"word"},{"term":"luxace","score":1.0,"count":5,"kind":"word"},{"term":"léčba","score":1.0,"count":14,"kind":"word"},{"term":"mozek","score":1.0,"count":5,"kind":"word"},{"term":"zlomenina","score":1.0,"count":8,"kind":"word"},{"term":"Celsus","score":0.83,"count":44,"kind":"entity"},{"term":"zlomenina kosti","score":0.48,"count":10,"kind":"word"},{"term":"léčba zlomenin","score":0.43,"count":9,"kind":"word"},{"term":"obvaz","score":0.37,"count":13,"kind":"word"},{"term":"Aulus Cornelius Celsus","score":0.36,"count":19,"kind":"entity"},{"term":"os","score":0.34,"count":15,"kind":"orig"},{"term":"zánět","score":0.32,"count":14,"kind":"word"},{"term":"ossa","score":0.31,"count":8,"kind":"orig"},{"term":"Hipp. De artic","score":0.3,"count":3,"kind":"entity"},{"term":"Hippocrates","score":0.3,"count":16,"kind":"entity"},{"term":"brachium","score":0.3,"count":6,"kind":"orig"},{"term":"calvaria","score":0.3,"count":3,"kind":"entity"},{"term":"caries","score":0.3,"count":4,"kind":"orig"},{"term":"cartilagine","score":0.3,"count":4,"kind":"orig"},{"term":"cerebri membranam","score":0.3,"count":3,"kind":"orig"},{"term":"cerebrum","score":0.3,"count":4,"kind":"orig"},{"term":"chrupavka","score":0.3,"count":7,"kind":"word"},{"term":"costa","score":0.3,"count":3,"kind":"orig"},{"term":"cubitus","score":0.3,"count":4,"kind":"orig"},{"term":"fascia","score":0.3,"count":6,"kind":"orig"},{"term":"femur","score":0.3,"count":4,"kind":"orig"},{"term":"fracta","score":0.3,"count":3,"kind":"orig"},{"term":"fraktura","score":0.3,"count":3,"kind":"word"},{"term":"humerus","score":0.3,"count":4,"kind":"orig"},{"term":"kloub","score":0.3,"count":7,"kind":"word"},{"term":"kostní struktura","score":0.3,"count":3,"kind":"word"},{"term":"lebka","score":0.3,"count":5,"kind":"word"},{"term":"léčba zranění","score":0.3,"count":8,"kind":"word"},{"term":"maxilla","score":0.3,"count":6,"kind":"orig"},{"term":"mozková blána","score":0.3,"count":5,"kind":"word"},{"term":"nervi","score":0.3,"count":6,"kind":"orig"},{"term":"nervové poškození","score":0.3,"count":6,"kind":"word"},{"term":"noha","score":0.3,"count":4,"kind":"word"},{"term":"processus","score":0.3,"count":4,"kind":"orig"},{"term":"ramenní kloub","score":0.3,"count":4,"kind":"word"},{"term":"scalpro","score":0.3,"count":6,"kind":"orig"},{"term":"skalpel","score":0.3,"count":4,"kind":"word"},{"term":"terebra","score":0.3,"count":4,"kind":"orig"},{"term":"vykloubení","score":0.3,"count":4,"kind":"word"},{"term":"zranění","score":0.3,"count":6,"kind":"word"},{"term":"čelist","score":0.3,"count":4,"kind":"word"}]}}},"summaries":{"root":{"cs":"„De Medicina“ je osmiknihová encyklopedie lékařských znalostí od římského autora Aula Cornelie Celsa, která shrnuje stav medicíny v 1. století př. n. l. Dílo je rozděleno na osm knih, které pokrývají diagnostiku, léčbu nemocí, farmakologii, chirurgii a anatomii. Obsahuje detailní popisy onemocnění, léčivých přípravků, chirurgických metod a anatomických struktur. Je založeno na kombinaci empirického pozorování a teoretického přístupu. Knihovna má překlad do češtiny."},"c0001":{"cs":"Kapitola uvádí historický vývoj medicíny od nejstarších národů, kde se léčba spojovala s kultem bohů, zejména Aeskulapa a jeho synů, kteří pomáhali vojákům v trojské válce. Léčba byla původně založena na zkušenosti a věštby, ale v Řecku se rozvinula díky filozofickému myšlení a studiu přírody. Kapitola rozlišuje racionální a empirickou školu medicíny, kde první založená na poznání příčin nemocí a vnitřních funkcí těla, druhá na zkušenosti a praktickém pozorování. Kritizuje obě extrémy a vyžaduje kombinaci teorie a praxe. Zdůrazňuje důležitost anatomického studia prostřednictvím pitvy mrtvol a význam individuálního přístupu k nemocnému. Závěrem se zabývá zásadami zdravého života a léčebnými doporučeními podle věku, ročního období a tělesného stavu."},"c0002":{"cs":"Kapitola zahrnuje detailní popis příznaků a průběhu nemocí v závislosti na věku, počasí, tělesném typu a období roku. Celsus analyzuje vliv chladu, horka, deště a větrů na zdraví, přičemž zdůrazňuje největší náchylnost mládí a senilního věku. Popisuje příznaky závažných onemocnění, jako jsou horečky, záněty, hnisavé procesy, problémy s trávicím traktem a močovým ústrojím, a jejich vztah k tělesnému stavu. Zdůrazňuje klinické znaky předcházející smrti, jako je ztráta tělesné hmoty, změna barvy kůže, ztráta vědomí a dehydratace. Léčebná část se zaměřuje na krvácení, lázně, masáž, vyvolávání potu, stravu a výživu, s důrazem na individuální přístup a vhodné časové plánování. Celsus vysvětluje, že lékařská diagnóza je založena na odhadu (konjektuře), který může být chybný, ale stále má svou důvěryhodnost, zejména při chronických onemocněních."},"c0003":{"cs":"Kapitola se zabývá systematickou analýzou průběhu nemocí, zejména horeček, s důrazem na jejich klasifikaci podle cyklu (denní, třetidenní, čtvrtidenní) a reakce těla. Celsus upozorňuje na rozdílné léčebné přístupy pro akutní a chronické stavy, zdůrazňuje důležitost časového plánování stravy, odpočinku, omezení jídla a pití, a kritizuje představy o významu určitých dnů v týdnu. Léčba je založena na pozorování příznaků – tep, barva kůže, pot, dech – a individuálním přístupu k pacientovi. Zmiňuje se o léčbě duševních poruch, zánětech, hydropikách, tuberkulóze a apoplézi, přičemž doporučuje postupné obnovování těla, krevní odběr, fricci, koupel a vhodné bylinné přípravky."},"c0004":{"cs":"Kapitola je věnována detailnímu anatomickému popisu lidského těla, s důrazem na orgány hlavy, krku, hrudníku a břicha, včetně cév, žláz, střevního traktu a močového systému. Celsus popisuje polohu, tvar, funkci a vztahy mezi orgány, např. pyloros, caecum, rectum, močový měchýř a pohlavní orgány. Následně představuje komplexní léčebné metody pro širokou škálu onemocnění – od bolestí hlavy a krku přes záněty hltanu, žaludku a střev až po onemocnění plic, jater a kloubů. Léčba zahrnuje krevní odběr, použití horkých a chladných obkladů, kataplasmat, bylinných přípravků, dietních omezení, pohybu a zvláštních režimů. Důraz je kladen na diferenciaci příznaků, individuální přístup a postupné obnovování zdraví po nemoci."},"c0005":{"cs":"Kapitola 5 'De Medicina' Aula Cornelius Celsus se zaměřuje na systematické vyjádření léčivých látek a jejich použití v antickém lékařství. Obsahuje rozsáhlé receptury pro různé léčivé přípravky – od mastí a emplastrů přes pastilky až po směsi pro vnitřní podávání. Léčiva jsou klasifikována podle jejich účinku: rozkládají hnis, otevírají cesty v těle, čistí organismus, zlepšují hojení ran nebo měkčí tkáně. Zmiňuje se o rostlinách, minerálech, živočišných produktech a chemických sloučeninách, včetně specifických směsí jako Mithridátův lék nebo Ambrozie. Kapitola obsahuje i pokyny pro léčbu zranění, zánětů, vředů a gangrény, včetně chirurgických postupů, péče o ránu a léčby poškození nervů. Zdůrazňuje důležitost správné diagnózy, posouzení závažnosti zranění a individuálního přístupu k pacientovi."},"c0006":{"cs":"Kapitola 6 z díla De Medicina obsahuje systematický přehled léčebných postupů pro širokou škálu onemocnění těla, zaměřený především na léčbu kožních, očních, ušních, ústních a genitálních poruch. Popisuje přípravu a použití různých léčivých směsí (collyrii), obkladů (kataplasma), mastí a klystýrů, včetně přesných receptů s přesnými dávkami a složením z rostlinných, živočišných a minerálních látek. Zdůrazňuje důležitost hygieny, stravovacích omezení, klidu a vhodného času pro léčbu. Zahrnuje léčbu vředů, zánětů, zákalů, polypů, zubní bolesti, krvácení a onemocnění pohlavních orgánů, včetně chirurgických zákroků. Léčba je založena na principu přizpůsobení léčby stavu pacienta a závažnosti onemocnění."},"c0007":{"cs":"Kapitola je komplexním přehledem chirurgických postupů v antickém lékařství, zaměřeným na praktické techniky léčby různých onemocnění a zranění. Obsahuje podrobné popisy léčby ran, abscesů, fistul, nádorů a výpadků orgánů, včetně operací na očích, uších, ústech, břišní stěně a pohlavních orgánech. Zdůrazňuje vývoj chirurgie od Hipokrata přes Filoxena až po římské lékaře, požadavky na charakter chirurga a použití nástrojů jako skalpelu, cucurbitul, háčků a jehel. Popisuje metody odstraňování zbraní, odstranění cizích těles, léčbu zánětů, výběžků a deformací, včetně operací na jazyku, rtu, nosu, zubech a pohlavních orgánech. Zahrnuje i léčbu vnitřních výpadků, hernií, zánětů varlat a techniky šití břišní stěny. Důraz je kladen na přesnost, hygienu, časovou náročnost a individuální přístup k pacientovi."},"c0008":{"cs":"Kapitola je systematickým přehledem anatomie lidského skeletu, zaměřeným na kosti hlavy (calvaria, suturae, foramina), čelistí (maxilla, mandibula), končetin (humerus, cubitus, tibia, femur) a páteře. Podrobně analyzuje strukturu, polohu, spoje a funkce jednotlivých kostí, včetně jejich vztahu k nervům, mozkovému kmeni a vnitřním dutinám. Dále se zabývá poškozeními – zlomeninami, luxacemi, záněty a karií – a jejich diagnostikou pomocí speciálních nástrojů. Předepisuje chirurgické postupy, jako je odstranění poškozené tkáně, použití vrtáků (terebra), modiola a emplastrů, a léčbu pomocí horké vody, ocetu, růžového vosku a vína. Zdůrazňuje kritickou důležitost rychlého zákroku, aby se zabránilo poškození mozku, zánětu nebo smrti."}}}