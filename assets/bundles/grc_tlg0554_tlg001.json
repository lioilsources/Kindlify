core":0.3,"count":2,"kind":"orig"}]},"c0008":{"terms":[{"term":"láska","score":1.0,"count":6,"kind":"word"},{"term":"modlitba","score":1.0,"count":2,"kind":"word"},{"term":"osud","score":1.0,"count":7,"kind":"word"},{"term":"setkání","score":1.0,"count":5,"kind":"word"},{"term":"Χαιρέας","score":1.0,"count":20,"kind":"orig"},{"term":"Καλλιρρόη","score":0.8,"count":16,"kind":"orig"},{"term":"dopis","score":0.51,"count":5,"kind":"word"},{"term":"τριήρεις","score":0.51,"count":5,"kind":"orig"},{"term":"Syrakusy","score":0.48,"count":8,"kind":"entity"},{"term":"Αἰγύπτιος","score":0.41,"count":4,"kind":"orig"},{"term":"Demetrios","score":0.38,"count":3,"kind":"entity"},{"term":"Statéra","score":0.38,"count":3,"kind":"entity"},{"term":"záchraně","score":0.38,"count":3,"kind":"word"},{"term":"Στατείρᾳ","score":0.38,"count":3,"kind":"orig"},{"term":"βασιλεύς","score":0.38,"count":5,"kind":"orig"},{"term":"Charéa","score":0.35,"count":4,"kind":"entity"},{"term":"válka","score":0.35,"count":4,"kind":"word"},{"term":"věrnost","score":0.35,"count":7,"kind":"word"},{"term":"Αἴγυπτος","score":0.35,"count":4,"kind":"entity"},{"term":"Στάτειρα","score":0.35,"count":4,"kind":"orig"},{"term":"Callirrhoe","score":0.33,"count":6,"kind":"entity"},{"term":"manželství","score":0.33,"count":6,"kind":"word"},{"term":"osvobození","score":0.33,"count":5,"kind":"word"},{"term":"Πολύχαρμος","score":0.33,"count":5,"kind":"entity"},{"term":"ναύαρχος","score":0.31,"count":3,"kind":"orig"},{"term":"Afrodita","score":0.3,"count":4,"kind":"entity"},{"term":"Chairea","score":0.3,"count":3,"kind":"word"},{"term":"Chaireas","score":0.3,"count":5,"kind":"entity"},{"term":"Egypt","score":0.3,"count":2,"kind":"entity"},{"term":"Kallirrhoé","score":0.3,"count":5,"kind":"entity"},{"term":"Státeira","score":0.3,"count":2,"kind":"entity"},{"term":"armáda","score":0.3,"count":2,"kind":"word"},{"term":"dar","score":0.3,"count":2,"kind":"word"},{"term":"mír","score":0.3,"count":2,"kind":"word"},{"term":"piráti","score":0.3,"count":2,"kind":"word"},{"term":"plavba","score":0.3,"count":2,"kind":"word"},{"term":"přátelství","score":0.3,"count":4,"kind":"word"},{"term":"radu","score":0.3,"count":2,"kind":"word"},{"term":"slzy","score":0.3,"count":2,"kind":"word"},{"term":"Διονύσιος","score":0.3,"count":4,"kind":"orig"},{"term":"Μιλήτῳ","score":0.3,"count":2,"kind":"orig"},{"term":"Πολυχάρμῳ","score":0.3,"count":2,"kind":"orig"},{"term":"πέμπω","score":0.3,"count":2,"kind":"orig"},{"term":"πολίτης","score":0.3,"count":2,"kind":"orig"},{"term":"πόλεμος","score":0.3,"count":2,"kind":"orig"},{"term":"σταυροῦ","score":0.3,"count":2,"kind":"orig"},{"term":"Ἀσία","score":0.3,"count":2,"kind":"entity"},{"term":"Ἄραδον","score":0.3,"count":2,"kind":"orig"},{"term":"Ἄραδος","score":0.3,"count":2,"kind":"orig"},{"term":"ἐπιστολὴν","score":0.3,"count":2,"kind":"orig"}]}}},"summaries":{"root":{"cs":"Román Charitona z Afrodísie je jedním z nejstarších zachovaných řeckých románů, který vypráví o lásce, osudu a božském zásahu mezi Chaereem a Callirrhoe. Po smrti Callirrhoe je znovuživena a prodána, zatímco Chaereus se vydává na cestu plnou nebezpečí, aby ji našel. Příběh se rozvíjí přes námořní katastrofy, soudní procesy, války a náboženské rituály. Láska a věrnost překonávají smrt, nespravedlnost a politické intriky. Dílo zpracovává tematické souvislosti mezi osudem, božskou péčí, spravedlností a lidskou touhou. Knihovna má překlad do češtiny."},"c0001":{"cs":"Callirrhōē, po smrti a pohřbu, se probouzí v hrobě a je záchranou Thērōna, mořského lupiče, vytáhnutá z mrtvého těla. Přivedena jako otrokyně do domu Leonáse, představuje se jako božská postava, jejíž krása vzbuzuje úžas. Přestože je ztracená a ztratila milovaného Chaerea, kterého Thērōn zavraždil, zachovává vědomí své identity. V duchu prožívá své utrpení, ztrátu a osudovou ztrátu důstojnosti. Když najde obraz Chaerea, políbí ho a přiznává, že je ztracená, že její žena je nyní otrokyní pod vládou Thērōna."},"c0002":{"cs":"Kniha 2 se soustředí na přechod z utrpení k naději, kdy Dionýsios, stále ztracený v smutku, získává útěchu v snu, ve kterém vidí svou zemřelou ženu živou, krásnější a větší než dříve, a sám si představuje její svatbu. Leonas mu o tom zpravuje, zatímco sám neúspěšně hledá Théronu, který prodal Callirhoé, a ztrácí talant, který měl být její výkupné. V domácnosti se objevuje etický konflikt mezi svobodou a otroctvím, kdy Dionýsios odmítá, že by svobodná žena měla být otrokyní, a odkazuje na poezii, která spojuje krásu s božským původem. Příchod Callirhoé je spojen s rituály, modlitbami a zjevením bohyně Afrodity, což otevírá cestu k jejímu osvobození a novému osudu. Její přítomnost v domě způsobuje překvapení a úžas, a její výslovnost a chování vzbuzují respekt i obdiv. Konflikt mezi vlastníkem a jeho sluhou kvůli ztrátě talantu odráží téma majetku a vlastnictví. Zároveň se objevuje konflikt mezi osudem a svobodnou vůlí, kdy Callirhoé se snaží zachránit své dítě, i když ví, že to může vést k jejímu zničení."},"c0003":{"cs":"Kniha 3 díla „De Chaerea et Callirhoe“ představuje vrcholný moment dramatického a metafyzického napětí, kdy se osudové události spojují s láskou, smrtí a božským zásahem. Po smrti Dionýsia se Callirrhoe stává předmětem závisti a tajemných zjevů – její tělo zmizí z hrobu, což vyvolává úžas a pochybnosti. Charéus, její milenec, se vydává na nebezpečnou mořskou cestu, aby ji našel, přičemž jeho cesta je ovlivněna snovými výjevy, modlitbami a znameními bohů. Významně se projevuje téma osudu, když se jeho cesta stává součástí božského plánu. Zároveň se objevují příběhy o námořních katastrofách, ztrátě lodi, zradě a přežití, což zdůrazňuje náboženskou a etickou dimenzi utrpení. Vše ukazuje na tematickou sílu božského zásahu, nevyhnutelnosti smrti a nekonečného hledání pravdy a osvobození."},"c0004":{"cs":"Kniha 4 díla Charitona popisuje klíčový okamžik v osudu Callirhoy a Chaerea. Po smrti Chaerea v Syrakúzách Callirrhoé tráví noc v pláči, přičemž jí přijde sen o barbarském vpádu a plameni, který ničí její loď. Dionýsios ji vyzývá, aby vybudovala hrob pro Chaerea, a zdůrazňuje důležitost pohřebních zákonů. V Milétu se uskuteční slavnostní pohřeb, kdy Callirrhoé zaujme všechny svou neuvěřitelnou krásou a důstojností, přičemž její přítomnost způsobí silný dojem i u významných osob, včetně satrapy Mitridáta, který se zhroutí. Zároveň je Chaereus uvězněný v Karii, pracuje jako otrok a připravuje se na smrt. Přestože jsou odděleni, jejich láska a osud jsou propojeny smrtí a utrpením. Příběh ukazuje, jak náhoda a nespravedlnost ovlivňují jejich osudy, a zároveň se objevuje téma vzájemného pohřbení a osudu, který je přímo způsoben náhodou a nespravedlností."},"c0005":{"cs":"Kniha 5 díla De Chaerea et Callirhoe se soustředí na cestu hlavních postav do Babylónu, kde se jejich osudy stávají součástí komplexního politického a morálního konfliktu. Callirrhoe, po pohřbu a oživení, se vydává s Charéem a Polycharmem do Kárie, kde se jejich cesta stává zároveň utrpením a hledáním osvobození. V Babylóně se jejich příchod stává příležitostí pro soudní proces, kde je Callirrhoe obžalována za nevěru, přičemž její krása a osud vyvolávají zájem i nenávist. Soudní scéna se proměňuje v kulturní a politický moment, kdy se střetávají národní, rodinné a osobní ambice. Charéus se potýká s zoufalstvím, ztrátou a touhou po spravedlnosti, zatímco Callirrhoe se snaží zachovat důstojnost i v největší bolesti. Významný je i návrat Charéa, který vzbuzuje úžas a emoce, a rozhodnutí krále, které zároveň posiluje jeho politickou moc. Celá kapitola je plná napětí, věštby, modliteb a boje o lásku, věrnost a osud."},"c0006":{"cs":"Před rozhodnutím krále o tom, zda je Callirrhoe manželkou Chaerea nebo Dionysia, se Babylón naplní napětím. Město se dělí na dvě strany, které hájí různé právní a morální argumenty ohledně prvního manželství, osvobození z otroctví a spravedlnosti v lásce. Král bdí celou noc, přemýšlí o své vášni k Callirhóe a o tom, co udělá s ní, zatímco jeho eunuch mu připomíná morální a právní důsledky jejich vztahu. Královna se modlí, aby den co nejdříve přišel, aby se zbavila zátěže své krásy. Král přikazuje třicetidenní sváteční období pro celou Asii, během něhož se konají oběti a slavnosti. Výjezd krále na lovu je zároveň útěkem i bojem s vlastní touhou. Kallirrhoe se snaží zůstat věrná svému postavení, zatímco eunuch ji přemlouvá, aby se podvolila králi. Zpráva o povstání v Egyptě přeruší jejich rozhovor a otočí pozornost k válce."},"c0007":{"cs":"Chariton, zničený ztrátou své milenky Callirrhoe, se rozhodne bojovat proti tyrani, který ho zneužil. S přítelem Polycharmem se domlouvá na společné smrti jako posledním aktu odporu, ale nakonec přijímají jinou cestu: využití války jako prostředku k osvobození. Spolu s Egyptem a Syrií vstupují do boje, přičemž Chariton vede řecké jednotky k útoku na Tyr, město dobýt a osvobodit. Po osvobození města se neoslavuje, protože nemá radost bez Callirrhoe. V noci po bitvě připluje do Arádu, kde je zatčená královna, a přikazuje, aby byl ostrov ohraničen. Ženy zůstávají v utrpení, zatímco Egypťané slaví osvobození. Chariton vysvětluje, že ženy nelze přimět násilím, ale jen láskou a sliby, a varuje před násilím, protože porušuje spravedlnost."},"c0008":{"cs":"Kniha 8 díla De Chaerea et Callirhoe zavěšuje příběh hrdinského páru v klíčovém okamžiku jejich znovusjednocení. Po dlouhé pouti, utrpení, otroctví a zdánlivé smrti se Kallirrhoé setkává s Chaireem v Egyptě, kde je osvobozena z vězení. Před chrámem Afrodity, bohyně lásky, se uklání, odloží boty, rozpuští vlasy a prosí o milost: nechť ji již neodtrhne od svého muže, ale umožní jim společný šťastný život a společnou smrt. Tato modlitba je zároveň závěrečným projevem jejich nezvratné lásky, která překonala osud, válku, zradu i smrt. Božstvo Afrodita nakonec zasáhne, aby jejich osud byl splněn, a jejich manželství se obnoví v souladu s právem a spravedlností."}}}