"},{"term":"Babylón","score":0.3,"count":6,"kind":"entity"},{"term":"Chaldejci","score":0.3,"count":2,"kind":"entity"},{"term":"Ekbatány","score":0.3,"count":2,"kind":"entity"},{"term":"Eufrat","score":0.3,"count":2,"kind":"entity"},{"term":"Euphrat","score":0.3,"count":4,"kind":"entity"},{"term":"Hefajstion","score":0.3,"count":5,"kind":"entity"},{"term":"Hefajstos","score":0.3,"count":2,"kind":"entity"},{"term":"Indie","score":0.3,"count":5,"kind":"word"},{"term":"Kaspijské moře","score":0.3,"count":2,"kind":"entity"},{"term":"Médios","score":0.3,"count":2,"kind":"entity"},{"term":"Olympiáda","score":0.3,"count":2,"kind":"entity"},{"term":"Roxana","score":0.3,"count":3,"kind":"entity"},{"term":"Seleukos","score":0.3,"count":3,"kind":"entity"},{"term":"Tigris","score":0.3,"count":5,"kind":"word"},{"term":"Xerxes","score":0.3,"count":3,"kind":"entity"},{"term":"božský původ","score":0.3,"count":3,"kind":"word"},{"term":"oběť","score":0.3,"count":5,"kind":"word"},{"term":"proroctví","score":0.3,"count":3,"kind":"word"},{"term":"rituál","score":0.3,"count":5,"kind":"word"},{"term":"smrt","score":0.3,"count":7,"kind":"word"},{"term":"vláda","score":0.3,"count":10,"kind":"word"},{"term":"vojáci","score":0.3,"count":7,"kind":"word"},{"term":"Βαβυλῶνα","score":0.3,"count":3,"kind":"orig"},{"term":"Βαβυλῶνι","score":0.3,"count":4,"kind":"orig"},{"term":"Εὐφράτην","score":0.3,"count":3,"kind":"orig"},{"term":"Εὐφράτης","score":0.3,"count":4,"kind":"orig"},{"term":"Πέρσας","score":0.3,"count":4,"kind":"orig"},{"term":"Σοῦσα","score":0.3,"count":3,"kind":"orig"},{"term":"Τίγρης","score":0.3,"count":3,"kind":"entity"},{"term":"βασίλεια","score":0.3,"count":3,"kind":"entity"},{"term":"Ἀλέξανδρον","score":0.3,"count":13,"kind":"orig"},{"term":"Ἀντίπατρον","score":0.3,"count":3,"kind":"orig"},{"term":"ἑταῖροι","score":0.3,"count":3,"kind":"orig"},{"term":"Ἰνδῶν","score":0.3,"count":5,"kind":"orig"}]}}},"summaries":{"root":{"cs":"Anabasis je vojenská a historická kronika přesunu řeckých mercenářů pod vedením Kyrů z Persie k západnímu moři. Arrian vychází z děl Ptolemaia a Aristobula a vytváří podrobný popis cesty přes Thrákií, Anatolii a Asii. Dílo kombinuje historické fakta s prvky hrdinského eposu, zaznamenává boje, přírodní překážky, rituály, oběti a božská znamení. Zdůrazňuje osud, věrnost, taktiku a morální výzvy. Knihovna má překlad z řečtiny. Je to důležitý zdroj pro poznání antického vojenského myšlení a kultury."},"c0001":{"cs":"Kniha 1 Anabasis Arriana představuje úvodní fázi tažení Alexandra Velikého, začínající vysvětlením zdrojové základny: Arrian se opírá především o díla Ptolemaia Lagova a Aristobula, jejichž důvěryhodnost považuje za vysokou kvůli osobní účasti a absence motivu k lži. Po smrti Filipa II. přebírá Alexandr vládu, sjednocuje řecké státy v Peloponésu a získává jejich souhlas s vedením proti Persii, s výjimkou Sparte. Následuje příprava a pochod přes Makedonii a Thrákií, kde se setkává s odporem Tráků, kteří blokují průchod vozovými opevněními. Alexandr používá taktiku roztažení falangy, aby umožnil přechod vozů, a zároveň využívá lučištníky a jízdu k útoku. Po vítězství nad Trákům pokračuje přes horu Aimos, překonává řeku Lyginos a střetává se s Trivaly a Géty. Přesun přes Dunaj bez mostu je klíčovým momentem, kdy překvapí nepřátele a získává jejich kořist. Následuje setkání s Kelty, kteří se bojí nebe, a spojenectví s králem Langarosem z Agriánů. Po bitvě u Pélii přichází posila krále Glaukia, což vytváří novou vojenskou situaci. Alexandr reaguje rychlým přesunem, organizuje falangu a překonává nepřátelské postavení v úzkém průsmyku, což ukazuje jeho strategickou a taktickou výkonnost."},"c0002":{"cs":"Kniha 2 Anabasis Arriana pokračuje ve vyprávění o výpravě řeckých mercenářů pod vedením Kyrů, mladšího bratra perského krále Artaxerxese II. Po překonání přírodních překážek a národních hranic se armáda dostává do perského území, kde se setkává s výzvami politického i vojenského charakteru. Arrian zdůrazňuje rozhodovací procesy, vliv osudu a božské znamení, jako jsou sny a věštby, které ovlivňují rozhodnutí o válce. Zároveň se objevuje tematická hloubka: hrdinství, věrnost, spravedlnost a vliv vůle jednotlivce proti osudu. Kapitola je zároveň historickým dokumentem o vojenské strategii a politické realitě v antickém Blízkém východě."},"c0003":{"cs":"Kapitola 3 Anabáze popisuje pokračování výpravy řeckých mercenářů pod vedením Xenofóna po Anatolii. Armáda se přesouvá k řekám, přičemž se setkává s přírodními překážkami a zprávami o nepřátelských silách. Významnou roli hrají božská znamení – věštby, sny a rituály – které ovlivňují rozhodování a věření vojáků. Xenofón zdůrazňuje, jak se osud a božská vůle promítají do každého kroku. Zároveň se prohlubuje téma věrnosti, vedení a morální odpovědnosti v rámci vojenského společenství. Kapitola spojuje historický příběh s mytologickými a filozofickými otázkami."},"c0004":{"cs":"V této kapitole Arrian popisuje klíčový úsek cesty řecké armády po úspěšném překonání Tigrisu, což znamená výstup z mezopotámské oblasti do vnitrozemí Asie. Zdůrazňuje vojenskou disiplínu, organizaci přechodu a přípravu na další výpravu. Výzvy představují jak přírodní překážky, tak strategické rozhodnutí o směru. Zároveň se objevují náznaky božského zásahu a osudu, který vede armádu vpřed. Tato část je zároveň přechodná mezi západní a východní částí cesty, kdy se výzvy stávají nejen vojenskými, ale i metafyzickými."},"c0005":{"cs":"Kniha 5 Anabasis zachycuje klíčové fáze ústupu řeckého vojska pod vedením Alexandra Velikého přes západní údolí. Arrian popisuje vojenské operace, strategická rozhodnutí a setkání s místními národy, které často končí obětmi a rituály. Zde se projevuje tematická souvislost mezi válkou, osudem a božským zásahem – znamení, sny a věštby ovlivňují rozhodování. Významná je i role vůdce, jeho etika a vztah k vojákům, což odráží myšlenky o spravedlnosti, věrnosti a ctnosti. Kapitola je zároveň důležitým dokumentem o politice, vládě a společenském řádu v době velkých vojenských přesunů."},"c0006":{"cs":"V knize 6 Anabáze se armáda, která se vydala z Persie, vydává na dlouhou a náročnou cestu přes nepřátelské území. Překonávají horské údolí, pouště a nepřátelské kmeny, přičemž se setkávají s místními obyvateli, kteří jim někdy pomáhají, jindy se jim brání. Významnou roli hraje osud, který se projevuje v předpovědích, snech a božských znameních. Věrnost mezi vojáky a vůdcem, zejména Xenofontem, je klíčová pro přežití. Kapitola zdůrazňuje i politické a etické dilemata, jako je spravedlnost v čase války, vztah k místním národům a výzvy vedení. Cesta je zároveň i cestou poznání a sebepoznání."},"c0007":{"cs":"V sedmé knize Anabasis Arriana se končí hlavní část příběhu o útěku řeckých mercenářů po smrti Kyrů. Kapitola popisuje poslední fázi jejich cesty k západnímu moři, kdy se setkávají s novými kmeny, překonávají přírodní překážky a čelí zvýšenému napětí. Významnou roli hraje osud, který se projevuje prostřednictvím božských znamení a věštby. Vedení armády přechází do rukou nových vůdců, kteří se snaží udržet jednotu a zorganizovat obranu. Zároveň se objevuje téma spravedlnosti a politiky v krizi, kdy rozhodnutí o přežití jsou ovlivněna etikou, věrností a zkušenostmi z války. Kapitola ukončuje dějovou linii, která se stává symbolem hrdinského odvážení a přežití."}}}