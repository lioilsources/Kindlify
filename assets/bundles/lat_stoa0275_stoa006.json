},{"term":"Christus","score":0.44,"count":39,"kind":"entity"},{"term":"Abraham","score":0.3,"count":6,"kind":"entity"},{"term":"Boh","score":0.3,"count":17,"kind":"entity"},{"term":"Boží duch","score":0.3,"count":4,"kind":"entity"},{"term":"Christi","score":0.3,"count":8,"kind":"orig"},{"term":"Christo","score":0.3,"count":18,"kind":"orig"},{"term":"Christum","score":0.3,"count":13,"kind":"orig"},{"term":"Esaias","score":0.3,"count":8,"kind":"entity"},{"term":"Zákon","score":0.3,"count":9,"kind":"entity"},{"term":"apostol","score":0.3,"count":11,"kind":"entity"},{"term":"apostolus","score":0.3,"count":11,"kind":"entity"},{"term":"carnem","score":0.3,"count":6,"kind":"orig"},{"term":"corporis","score":0.3,"count":5,"kind":"orig"},{"term":"corpus","score":0.3,"count":8,"kind":"orig"},{"term":"creator","score":0.3,"count":17,"kind":"orig"},{"term":"creatoris","score":0.3,"count":21,"kind":"orig"},{"term":"církev","score":0.3,"count":9,"kind":"entity"},{"term":"dei","score":0.3,"count":9,"kind":"orig"},{"term":"deum","score":0.3,"count":7,"kind":"orig"},{"term":"deus","score":0.3,"count":14,"kind":"orig"},{"term":"duch","score":0.3,"count":5,"kind":"word"},{"term":"duše","score":0.3,"count":8,"kind":"word"},{"term":"evangelium","score":0.3,"count":17,"kind":"orig"},{"term":"evangélium","score":0.3,"count":6,"kind":"word"},{"term":"kříž","score":0.3,"count":5,"kind":"word"},{"term":"legem","score":0.3,"count":6,"kind":"orig"},{"term":"legis","score":0.3,"count":11,"kind":"orig"},{"term":"manželství","score":0.3,"count":6,"kind":"word"},{"term":"mír","score":0.3,"count":5,"kind":"word"},{"term":"pravda","score":0.3,"count":16,"kind":"word"},{"term":"proroctví","score":0.3,"count":8,"kind":"word"},{"term":"spiritus","score":0.3,"count":10,"kind":"orig"},{"term":"spravedlnost","score":0.3,"count":8,"kind":"word"},{"term":"stvořitel","score":0.3,"count":6,"kind":"word"},{"term":"tvůrce","score":0.3,"count":16,"kind":"word"},{"term":"tělo","score":0.3,"count":12,"kind":"word"},{"term":"vzkříšení","score":0.3,"count":9,"kind":"word"},{"term":"víra","score":0.3,"count":7,"kind":"word"},{"term":"zákony","score":0.3,"count":10,"kind":"word"}]}}},"summaries":{"root":{"cs":"Tertullianovo dílo 'Adversus Marcionem' je systematická obrana jednoty Boha a pravdivosti křesťanského učení proti Marcionově dualistické teologii, která rozdělovala tvůrce světa a vyššího boha Krista. Pět knih představuje postupný argument: od zpochybnění dvou bohů přes obranu jednoty božstva, interpretaci proroků a kritiku Marcionova odmítnutí starého zákona a tělesného vzkříšení až po obranu apostolské autority. Dílo je založeno na logice, biblické exegéze a metafyzické jednotě. Knihovna má překlad do češtiny."},"c0001":{"cs":"Tertullian v knize 1 'Adversus Marcionem' útočí proti Marcionovu učení o dvou bozích – zlém tvůrci Starého zákona a dobrém tvůrci Nového zákona. Argumentuje, že takové rozdělení je logicky nesmyslné, protože Bůh jako nejvyšší (summum magnum) nemůže mít rovného, jinak by jeho nejvyšší povaha byla zpochybněna. Obhajuje jednotu Boha jako jediného, věčného, nejvyššího a největšího, který je všudypřítomný a všechno vytvořil. Kritizuje Marcionovu představu o novém bohu jako falešnou, protože pravý Bůh není definován novostí, ale pravdou své podstaty. Zdůrazňuje, že Bůh se projevuje svým dílem, a že jeho poznání je založeno na jeho dílech, nikoli na čase nebo názvu. Zároveň odmítá Marcionovu představu o bohu, který nic nevytvořil, a tvrdí, že pravý Bůh musí být tvůrce všeho, protože vše patří jemu."},"c0002":{"cs":"Tertullián v knize druhé 'Adversus Marcionem' obrání jediného Boha jako tvůrce světa a zároveň vysvětlí, proč Bůh dovolil člověku padnout do hříchu. Kritizuje Marcionovo dvojbožství a argumentuje, že pravý Bůh musí být jediný, nekonečný a nezávislý na čase. Zdůrazňuje, že člověk byl stvořen s volnou vůlí a svobodnou mocí rozhodování, aby mohl být opravdovým obrazem Boha. Tato svoboda je nezbytná pro morální odpovědnost a pro to, aby dobro bylo skutečně dobro. Bůh nemohl zásahem zasáhnout, aniž by porušil svou vlastní spravedlivost. Boží dobrá vůle a rozum jsou zachovány i v trpělivosti, pokání a zákonu, který je spojen s důsledkem smrti při porušení."},"c0003":{"cs":"Tertullian v knize třetí rozvíjí argumentaci proti Marcionovi, který tvrdil, že Kristus je Bůh z jiného, než stvořitel. Tertullian argumentuje, že Kristus je jediným Bohem, kterého přednášel stvořitel, a že jeho příchod byl předpovězen v prorocích. Zdůrazňuje, že Boží syn a posel nemohli přijít náhle, protože jejich existence musí být předcházena Božím oznámením a uspořádáním. Prorocká slova jsou interpretována jako záměrné allegorie, způsoby, které nejsou doslovné. Kristus je vždy přítomen v prorocích jako duch stvořitele, a jeho příchod je v souladu s Božím záměrem. Židé neuznali Krista, protože jej neznali jako svého, a jejich odmítnutí je důkazem, že byl od Boha zcela odstraněn z vědomí lidí."},"c0004":{"cs":"Kniha 4 Tertullianova díla 'Adversus Marcionem' je centrální částí obrany křesťanské jednoty proti Marcionově heresii, která rozděluje svět na dva protikladné bohy – tvůrce zemského světa a vysokého boha nového zákona. Tertullian argumentuje, že tato antitétá je nesmyslná a proti přírodě, protože jediný Boh je tvůrce i spasitel. Ukazuje, že Kristus je nejen synem Boha, ale i tvůrcem světa, který splnil proroctví a zákon. Kritizuje Marcionovo zkreslení evangelia, odmítá jeho verzi jako falešnou a podvrženou, a obrací se k původnímu apostolskému předání. Zdůrazňuje, že pravé evangelium je v souladu s učením apoštolů, že Kristus přišel ne zničit zákon, ale jej ho splnit, a že jeho činy – léčení, odpouštění hříchů, výběr apoštolů – jsou důkazem jeho božské povahy a jednoty s tvůrcem. Zároveň obrací pozornost k etice, kde křesťanská láska, spravedlnost a milosrdenství jsou v souladu s božskou vůlí a nejsou proti přírodě."},"c0005":{"cs":"Kniha 5 'Adversus Marcionem' Tertullianova je centrální obranou jednoty božstva a pravdivosti křesťanského učení proti Marcionově dualistické teologii. Tertullian argumentuje, že pravá apostolská autorita nemůže být založena na vlastním prohlášení, ale na Božím zřízení a potvrzení zázračným způsobem, jak je u Pavla. Ukazuje, že Pavel splňuje proroctví o Beniamínovi a že jeho učení je v souladu s učením Petra. Kritizuje Marcionovu myšlenku o dvou bozích, tvrdí, že pokud by byl tvůrce zavržen, nemáme kritérium pro poznání druhého boha. Zdůrazňuje, že zákon nebyl zrušen, ale převeden do nového smyslu skrze evangélium, a že pravá obřízka je duchovní, ne tělesná. Kritizuje Marcionovu odmítnutí tělesného vzkříšení a tvrdí, že Kristus je skutečně zemřel a vzkříšen, a že jeho tělo je základem spasení. Vysvětluje, že víra, ne zákon, je základem spravedlnosti, a že Boží zákon a závěť jsou jednotné a založené na jediném tvůrci."}}}