0.5,"count":2,"kind":"entity"},{"term":"ἹΠΠΌΛΥΤΟΣ","score":0.5,"count":4,"kind":"orig"},{"term":"Κύπρις","score":0.42,"count":3,"kind":"orig"},{"term":"Artemida","score":0.41,"count":2,"kind":"entity"},{"term":"Theseus","score":0.38,"count":3,"kind":"entity"},{"term":"Phaedra","score":0.35,"count":2,"kind":"entity"},{"term":"smrt","score":0.35,"count":2,"kind":"word"},{"term":"trest","score":0.35,"count":2,"kind":"word"},{"term":"Afrodita","score":0.31,"count":2,"kind":"entity"},{"term":"osud","score":0.31,"count":2,"kind":"word"},{"term":"trápení","score":0.31,"count":2,"kind":"word"},{"term":"Afrodíta","score":0.3,"count":1,"kind":"entity"},{"term":"Hippolytos — Eurípidés","score":0.3,"count":2,"kind":"entity"},{"term":"Kýprid","score":0.3,"count":1,"kind":"entity"},{"term":"Pallada","score":0.3,"count":1,"kind":"entity"},{"term":"Tróezén","score":0.3,"count":1,"kind":"entity"},{"term":"lež","score":0.3,"count":1,"kind":"word"},{"term":"nespravedlnost","score":0.3,"count":1,"kind":"word"},{"term":"nevědomost","score":0.3,"count":1,"kind":"word"},{"term":"pocta","score":0.3,"count":1,"kind":"word"},{"term":"tvář","score":0.3,"count":1,"kind":"word"},{"term":"Κυπριδος","score":0.3,"count":1,"kind":"orig"},{"term":"Λητοῦς δὲ κόρη","score":0.3,"count":1,"kind":"orig"},{"term":"Ποσειδῶνος","score":0.3,"count":1,"kind":"orig"},{"term":"Τροζηνίᾳ","score":0.3,"count":1,"kind":"orig"},{"term":"Φαίδρας","score":0.3,"count":1,"kind":"orig"},{"term":"δαίμον","score":0.3,"count":1,"kind":"orig"},{"term":"δαίμοσιν","score":0.3,"count":1,"kind":"orig"},{"term":"δόμοις","score":0.3,"count":1,"kind":"orig"},{"term":"θεοὶ","score":0.3,"count":1,"kind":"orig"},{"term":"θνῄσκοντας","score":0.3,"count":1,"kind":"orig"},{"term":"κακοὺς","score":0.3,"count":1,"kind":"orig"},{"term":"καρτέρει","score":0.3,"count":1,"kind":"orig"},{"term":"κρύψον","score":0.3,"count":1,"kind":"orig"},{"term":"μαρτύρομαι","score":0.3,"count":1,"kind":"orig"},{"term":"μοῖραν","score":0.3,"count":1,"kind":"orig"},{"term":"ναῖος","score":0.3,"count":1,"kind":"orig"},{"term":"οὐ χαίρουσι","score":0.3,"count":1,"kind":"orig"},{"term":"πατέρα","score":0.3,"count":1,"kind":"orig"},{"term":"πατρὸς τρεῖς ἀρὰς","score":0.3,"count":1,"kind":"orig"}]}}},"summaries":{"c0001":{"cs":"Afrodita se představuje jako bohyně lásky s vlivem nad smrtelníky, ohrožuje ty, kdo ji neuctívají, zejména Hippolyta, syna Thesea, který odmítá lásku a zasvětil se Artemidě. Plánuje pomstu za jeho pohrdání, zatímco Theseus přijíždí do Tróezény se svou manželkou Fairou, která se zamiluje do Hippolyta."},"c0002":{"cs":"Chór líčí ženu jako bytost spjatou s vodním živlem, skalami a rituální očistou, obklopenou symboly Oceánu, Démétřiny úrody, Panovy divočiny a Hekatiny magie. Je tázána, zda je bohyní, nymfou, lovkyní nebo spojena s královstvím a mořem. Její přítomnost vyvolává jak posvátnost, tak utrpení spojené s porodními bolestmi a šílenstvím, zatímco chór vzývá Artemis jako ochránkyni a projevuje věrnost bohům."},"c0003":{"cs":"Faidra se svěřuje své chůvě s vnitřním utrpením způsobenou láskou k Hippolytovi, synovi jejího manže Thesea. Chůva se snaží pochopit její stav a nabízí pomoc, zatímco Faidra vyjadřuje strach z prozrazení svého citu a touží po úlevě od svého trápení, které připisuje božskému zásahu."},"c0004":{"cs":"Chorál vyjadřuje uctívání i obavu z moci Eróta, který přináší jak sladkou milost, tak ničivou vášeň vedoucí k násilí a tragédii. Odkazuje na Afrodítinu vliv, Dionýšovy orgiastické rituály a mytologické postavy jako Alkmena a Théby, kde láska prolíná se smrtí a šílenstvím."},"c0005":{"cs":"Faidra trpí vnitřním utrpením a vinou kvůli své lásce k Hippolytovi, kterou považuje za zhoubu. Sbor komentuje její stav jako známku zrady a šílenství. Hippolytos odmítá ženy jako zdroj zla, kritizuje jejich roli v domácnosti a chválí jejich nevzdělanost jako ochranu před zkázou způsobenou Afroditou. Faidra nakonec rozhodne se spáchat sebevraždu, aby zachránila svou čest a skryla svou vášeň před Theseem a svými syny."},"c0006":{"cs":"Chór vyjadřuje touhu po útěku před trápením pomocí symbolů jako jsou ptáci, moře, řeky a bohové, přičemž odkazuje na mýty o Phaethontovi a Atlantidě. Líčí utrpení vzniklé z lásky a osudu, zejména jak Afroditin hněv rozvrací duši a vede k rituálnímu očistnému aktu, který odhání zlé duchy a obnovuje čest."},"c0007":{"cs":"Po sebevraždě Phaidry Theseus přichází domů a dozvídá se o její smrti od sboru a služebné. Vyjadřuje hluboký zármutek nad ztrátou manželky a později i syna Hippolyta, kterého považuje za viníka. Sbor lamentuje nad osudem domu a božskou vůlí, zatímco Theseus volá po spravedlnosti a pomstě prostřednictvím Poseidona."},"c0008":{"cs":"Chór nejprve vzpomíná na pomíjivost lidského štěstí a nestálost osudu, poté lamentuje nad ztrátou naděje kvůli hněvu bohů, konkrétně Athén, a popisuje, jak bylo štěstí zničeno božským zásahem. Nakonec vyjadřuje hluboký žal a obrací se k matce s výčitkou, že ji přivedla na svět jako nešťastnou, zatímco chór Charit se ptá, proč jsou nevinní trestáni vyhnáním."},"c0009":{"cs":"Posel přináší zprávu o tragické smrti Hippolyta, který byl při jízdě na koni vystrašen mořským býkem vyslaným bohy, což vedlo k zničení vozu a uvěznění Hippolyta v otěžích. Theseus se ptá na okolnosti a obviňuje Poseidona, že splnil jeho prokletí proti synovi."},"c0010":{"cs":"Chorál vyjadřuje uctívání Afrodity (Kýpry) jako bohyně, jejíž moc proniká do duší bohů i smrtelníků, rozdmýchává touhu prostřednictvím okřídleného Érose a prostupuje celou přírodou — zemi, mořem i všemi živými bytostmi, které podléhají její vládě."},"c0011":{"cs":"Artemis vystupuje jako bohyně spravedlnosti a obviňuje Thésea, že bez rozumu a ověření uvěřil falešným obviněním své ženy Phaidry proti synovi Hippolytovi, což vedlo k prokletí a smrti mladíka. Připomíná, že jednání bylo vyvoláno Afroditiným záměrem, ale Théseus stále nese vinu za nedostatek rozvážnosti. Hippolytos lamentuje svůj osud, vyjadřuje věrnost Artemidě a žádá o úlevu skrze smrt, zatímco Theseus lituje svého činu. Artemis nakonec slibuje poctu Hippolytovi v Tróezénu za jeho čistotu a věrnost."}}}