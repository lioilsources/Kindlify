ind":"word"},{"term":"Artemida","score":0.81,"count":5,"kind":"entity"},{"term":"Artemis","score":0.81,"count":5,"kind":"entity"},{"term":"zločin","score":0.81,"count":5,"kind":"word"},{"term":"Ἀρτέμις","score":0.8,"count":4,"kind":"entity"},{"term":"Thersandros","score":0.71,"count":6,"kind":"entity"},{"term":"Θέρσανδρος","score":0.71,"count":6,"kind":"entity"},{"term":"Ἀρτέμιδος","score":0.68,"count":5,"kind":"entity"},{"term":"ἱερεὺς","score":0.65,"count":4,"kind":"orig"},{"term":"Pan","score":0.6,"count":3,"kind":"entity"},{"term":"svatost","score":0.6,"count":3,"kind":"word"},{"term":"δίκην","score":0.6,"count":3,"kind":"orig"},{"term":"σπήλαιον","score":0.6,"count":3,"kind":"orig"},{"term":"σύριγξ","score":0.6,"count":3,"kind":"orig"},{"term":"obvinění","score":0.55,"count":4,"kind":"word"},{"term":"παρθένος","score":0.53,"count":5,"kind":"orig"},{"term":"kněz","score":0.48,"count":3,"kind":"word"},{"term":"přísaha","score":0.48,"count":3,"kind":"word"},{"term":"soudní proces","score":0.48,"count":3,"kind":"word"},{"term":"zákony","score":0.48,"count":3,"kind":"word"},{"term":"δίκη","score":0.48,"count":3,"kind":"orig"},{"term":"μοιχείας","score":0.48,"count":3,"kind":"orig"},{"term":"Μελίτη","score":0.47,"count":4,"kind":"entity"},{"term":"ὕδωρ","score":0.47,"count":4,"kind":"orig"},{"term":"manželství","score":0.42,"count":4,"kind":"word"},{"term":"Θέρσανδρον","score":0.41,"count":3,"kind":"orig"},{"term":"božská ochrana","score":0.4,"count":2,"kind":"word"},{"term":"chování","score":0.4,"count":2,"kind":"word"},{"term":"dech","score":0.4,"count":2,"kind":"word"},{"term":"hieros","score":0.4,"count":2,"kind":"entity"},{"term":"hudební nástroj","score":0.4,"count":2,"kind":"word"},{"term":"jeskyně","score":0.4,"count":2,"kind":"word"},{"term":"moralita","score":0.4,"count":2,"kind":"word"},{"term":"moudrost","score":0.4,"count":2,"kind":"word"},{"term":"proměna","score":0.4,"count":2,"kind":"word"},{"term":"právo","score":0.4,"count":2,"kind":"word"},{"term":"soud","score":0.4,"count":2,"kind":"word"},{"term":"statečnost","score":0.4,"count":2,"kind":"word"},{"term":"Θερσάνδρῳ","score":0.4,"count":2,"kind":"orig"},{"term":"Πανός","score":0.4,"count":2,"kind":"orig"},{"term":"Στυγὸς","score":0.4,"count":2,"kind":"orig"},{"term":"αὐλήματα","score":0.4,"count":2,"kind":"orig"},{"term":"θαλάττῃ","score":0.4,"count":2,"kind":"orig"},{"term":"πηγή","score":0.4,"count":2,"kind":"orig"},{"term":"πρόεδρε","score":0.4,"count":2,"kind":"orig"},{"term":"πρόεδρος","score":0.4,"count":2,"kind":"orig"}]}}},"summaries":{"root":{"cs":"Dílo je mytologicko-filozofický epos v osmi kapitolách, který sleduje osudy hlavního hrdiny a Léukippy v kontextu osudu, lásky, božského zásahu a náboženských rituálů. Příběh se rozvíjí přes ztroskotání, útěk, ztrátu, zázračné uzdravení a soudní procesy, přičemž se propracovává k tematickým vrcholům jako je osvobození, pravda a duševní přeměna. Dílo spojuje elementy hrdinského eposu, tragédie, mystiky a etické reflexe. Knihovna má překlad do češtiny."},"c0001":{"cs":"Kapitola se rozvíjí jako komplexní obraz života v antickém Sidónu, kde se příroda, náboženství, láska a osud prolínají. Začíná popisem města a rituálu k Astarté, následuje poetická scéna s dívkami, které napodobují býka – symbol kosmické jednoty. Vypravěč se zamilovává do Léukippy, jejíž krása je porovnávána s božstvím. Následují sen o hadovité ženě, která zasahuje do těla hrdiny, a zprávy o válce a smrti Charikleha, která ukazuje na nevyhnutelnost osudu. Zároveň se projevuje kritika manželství, ztráta rodinných vazeb a vnitřní boj mezi láskou a povinností. Přírodní metafory, jako jsou ptáci, stromy a voda, symbolizují živou sílu lásky, která překračuje lidské hranice. Kapitola tvoří základ pro celý příběh, kde se setkávají mytologie, etika, osud a tragická krása."},"c0002":{"cs":"Kapitola 2 díla „τὰ κατὰ Λευκίππην καὶ Κλειτοφῶντα“ představuje komplexní vyprávění o vášni, rituálu a osudu, které se projevuje prostřednictvím mytologických obrázků, symbolických aktů a emocionálních konfliktů. Hlavní hrdina se potýká s vnitřním bojem mezi strachem a touhou, když se připravuje na návštěvu ložnice dívky. Scény jsou naplněny hudbou, písněmi o růži a vínu, které odkazují na bohy Apollóna, Afrodité a Dionýsa. Ritualizované aktivity, jako je příprava krátkého výroku o vinné révě nebo oběť, symbolizují božský původ lásky a její spojení s přírodou. Intimní setkání, polibky a ztráta čistoty jsou prezentovány jako zázračné, přirozené a božsky inspirované zážitky. Příběh se rozvíjí přes útěk, náhlé přírodní zjevy, zázračné výskyty a mytologické příběhy, jako je unesení Ganyméda nebo zničení Semelé. Vše se soustředí na přirozenost lásky, její sílu přes strach a její přeměňující vliv na tělo i duši, přičemž se vrací k tématům osudu, prozřetelnosti a přirozeného řádu."},"c0003":{"cs":"Kapitola 3 představuje dramatický přechod od přírodní katastrofy k náboženskému a mytologickému zážitku. Po námořní bouři a ztroskotání lodi přeživší přicházejí do Pělousí v Egyptě, kde vstupují do chrámu boha Diosa. Zde se setkávají s uměleckými obrazy hrdinů – Andromedy, Prométhea, Herakleových a Perseových – symbolizujícími osud, boj a osvobození. Je zde detailní popis rituálu oběti, kdy je Léukippa připravována k oběti, její tělo rozdělené a zneužité. Hrdina se chystá k sebevraždě, ale po smrti se Léukippé tělo obnoví díky zásahu Meneláa, který se objevuje jako božský posel. Příběh se točí kolem osudu, božského zásahu, rituálů, smrti a obnovení, přičemž se vystřídají témata náboženského obřadu, tragédie, přátelství a překonání smrti."},"c0004":{"cs":"Kapitola začíná zprávou o rozhodnutí vojevůdce o návratu do vesnice kvůli přípravám nepřítele a zpoždění spojenců. Hlavní postava se setkává s Léukíppou, která sděluje sen, ve kterém ji bohyně Artemis varuje před smrtí a slibuje, že ji zachrání a zaručí její nevěstinu a budoucí sňatek s Kletofónem. Následně se objevuje popis zvířete z Nilu, které Egypťané nazývají koně, s neobvyklými a strašlivými vlastnostmi, včetně ohnivého dechu a zvířecího těla s koníčím tělem a vlčími zuby. Vojevůdce vysvětluje mechanismus pasti, kterou chytají toto zvíře, zároveň pozoruje Léukíppu, což vytváří napětí mezi pozorností k zvířeti a k ženě. Hlavní hrdina prožívá intenzivní duševní bolest z lásky a osudu, která se projevuje v jeho myšlenkách a rozhodnutích. Výsledkem je záchvat bláznivosti Léukíppy, kterou léčí pomocí zázračného léku, který vznikl z mýtického zdroje. Kapitola tedy spojuje tematické prvky osudu, lásky, božského zásahu a přírodního zázraku."},"c0005":{"cs":"Kapitola popisuje příjezd hrdiny do Alexandrie, kde je zasáhnut zážitkem z její nekonečné krásy a rozsáhlého rozložení města. Tento zážitek přechází v návštěvu svatyní a zjevení boha, označovaného jako Zeus nebo Serapis, spolu s ohnivým rituálem. Následuje vidění fresky zobrazující tragický příběh Philomély a Téréa, symbolizující násilí, ztrátu hlasu a zradu. Tento obraz se stává předzvěstí budoucího utrpení. Hrdina se potýká s vnitřním konfliktem, zároveň se objevují zprávy o smrti milované, útěku a návratu z mrtvého plavidla. Příběh se točí kolem osudu, lásky, násilí a náboženského zásahu, přičemž se vyskytují i symboly svatby, obětí a znovuzrození."},"c0006":{"cs":"Hlavní hrdina je léčen Melité, která mu pomáhá utéct z nebezpečí. Dává mu své oblečení, aby se přestrojil, a instruuje ho, jak se setkat s Klineiou a Satyrem, kteří jsou v domě. Při návratu se ukáže, že jeho záchranu zajišťuje strážce, kterému je nabídnuto dvojí odměna — závislá na tom, zda zůstane nebo uteče. Při setkání s Thersandrem a Sosthenem se objeví napětí, když Sosthenes unese Leukíppu, aby ji předal svému pánovi. Hlavní hrdina je překvapen a zatčen, ale Melitě se snaží způsobit, aby se jeho vztah s Leukíppou stal známým. Příběh se zaměřuje na lásku, osud, zradu a boj o svobodu."},"c0007":{"cs":"Po zprávě o smrti své milenky Lekípky se Thersandros rozhodne pro podvod, aby získal pravdu o jejím osudu. Přesvědčí vězně, aby se přiznal k vraždě, a využije to k přístupu do jejího prostoru. Přiznává se k vraždě, i když nebyl přímo viník, a ztrácí se v zoufalství. Při soudním jednání se objeví nové důkazy, které ukazují, že Lekípka je živa. V chrámu Artemidy se její setkání s otcem a milencem stává zázračným osvobozením od utrpení a náhody. Příběh ukazuje, jak náhoda, láska a osud mohou splynout v jediném okamžiku osvobození."},"c0008":{"cs":"Kapitola představuje řadu dramatických a rituálních scén, které se odehrávají v chrámu a kolem něj. Zahrnuje násilný střet mezi Thersandrem a hlavním hrdinou, kritiku zneužívání svatyně Artemidy, soudní procesy a osudové rozhodnutí. Hlavní postava vypráví o svém exilu, námořní katastrofě, lásce k Leukippé a zranění. Zároveň se objevuje mytologická příběh o bohu Pánovi a panně Syrinx, jejíž přeměna v hudební nástroj symbolizuje božskou spravedlnost. Syrinx slouží jako rituální prostředek k ověření pannosti. Kapitola zároveň kritizuje společenskou zkaženost, nevěru a zneužívání moci, přičemž se významně projevuje téma osudu, spravedlnosti a morálního osvobození."}}}