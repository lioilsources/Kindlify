:5,"kind":"orig"},{"term":"ἀστέρων","score":0.3,"count":6,"kind":"orig"},{"term":"Ἀφροδίτη","score":0.3,"count":11,"kind":"entity"},{"term":"Ἀφροδίτης","score":0.3,"count":14,"kind":"orig"},{"term":"Ἄρεως","score":0.3,"count":9,"kind":"orig"},{"term":"Ἄρης","score":0.3,"count":9,"kind":"entity"},{"term":"ἥλιος","score":0.3,"count":11,"kind":"entity"}]},"c0004":{"terms":[{"term":"astrologie","score":1.0,"count":34,"kind":"word"},{"term":"manželství","score":1.0,"count":3,"kind":"word"},{"term":"osud","score":1.0,"count":11,"kind":"word"},{"term":"planety","score":1.0,"count":10,"kind":"word"},{"term":"smrt","score":1.0,"count":5,"kind":"word"},{"term":"vztahy","score":1.0,"count":5,"kind":"word"},{"term":"věkové fáze","score":1.0,"count":1,"kind":"word"},{"term":"zvířetník","score":1.0,"count":2,"kind":"word"},{"term":"Měsíc","score":0.38,"count":13,"kind":"entity"},{"term":"Κρόνος","score":0.38,"count":13,"kind":"entity"},{"term":"Kronos","score":0.35,"count":12,"kind":"entity"},{"term":"Slunce","score":0.32,"count":11,"kind":"entity"},{"term":"Ἑρμοῦ","score":0.32,"count":11,"kind":"orig"},{"term":"Afrodita","score":0.3,"count":8,"kind":"entity"},{"term":"Ares","score":0.3,"count":9,"kind":"entity"},{"term":"Hermes","score":0.3,"count":10,"kind":"entity"},{"term":"Mars","score":0.3,"count":4,"kind":"entity"},{"term":"Ptolemaeus","score":0.3,"count":5,"kind":"entity"},{"term":"Venuše","score":0.3,"count":5,"kind":"word"},{"term":"Zeus","score":0.3,"count":8,"kind":"entity"},{"term":"cestování","score":0.3,"count":3,"kind":"word"},{"term":"charakter","score":0.3,"count":6,"kind":"word"},{"term":"harmonie","score":0.3,"count":3,"kind":"word"},{"term":"narození","score":0.3,"count":3,"kind":"word"},{"term":"planetární vliv","score":0.3,"count":10,"kind":"word"},{"term":"planetární vlivy","score":0.3,"count":6,"kind":"word"},{"term":"povolání","score":0.3,"count":3,"kind":"word"},{"term":"přátelství","score":0.3,"count":3,"kind":"word"},{"term":"symptomy","score":0.3,"count":3,"kind":"word"},{"term":"vliv planet","score":0.3,"count":5,"kind":"word"},{"term":"znamení","score":0.3,"count":4,"kind":"word"},{"term":"zvířeta","score":0.3,"count":3,"kind":"entity"},{"term":"zvířetní znamení","score":0.3,"count":4,"kind":"word"},{"term":"Δίας","score":0.3,"count":5,"kind":"entity"},{"term":"Ζεὺς","score":0.3,"count":5,"kind":"orig"},{"term":"Κρόνου","score":0.3,"count":9,"kind":"orig"},{"term":"ζῳδίοις","score":0.3,"count":3,"kind":"orig"},{"term":"πράξεις","score":0.3,"count":3,"kind":"orig"},{"term":"πράξεων","score":0.3,"count":3,"kind":"orig"},{"term":"σελήνη","score":0.3,"count":6,"kind":"entity"},{"term":"σελήνης","score":0.3,"count":5,"kind":"orig"},{"term":"συμβιώσεις","score":0.3,"count":3,"kind":"orig"},{"term":"ἀγαθοποιῶν","score":0.3,"count":3,"kind":"orig"},{"term":"Ἀφροδίτη","score":0.3,"count":10,"kind":"entity"},{"term":"Ἀφροδίτης","score":0.3,"count":9,"kind":"orig"},{"term":"Ἄρεως","score":0.3,"count":6,"kind":"orig"},{"term":"Ἄρης","score":0.3,"count":9,"kind":"entity"},{"term":"Ἑρμῆς","score":0.3,"count":5,"kind":"entity"},{"term":"ἡλίου","score":0.3,"count":5,"kind":"orig"},{"term":"ἥλιος","score":0.3,"count":6,"kind":"entity"}]}}},"summaries":{"root":{"cs":"Tetrabiblos je čtyřknižní dílo Claudia Ptolemaia, které představuje systematický a filozoficky motivovaný přehled astrologie jako vědy o vlivu nebeských těles na přírodu a lidský osud. Kniha 1 uvádí dva přístupy k astronomii a kritizuje nesoulad mezi astrologickými tradicemi. Kniha 2 analyzuje vliv nebeských těles na geografické a národní charakteristiky. Kniha 3 vysvětluje vliv planet na vývoj člověka od počátku těhotenství až po smrt, založený na genethliakální astrologii. Kniha 4 detailně popisuje vliv planet a zvířetníku na osud, povolání, manželství, zdraví a věkové fáze života. Dílo je považováno za základní text středověké a renesanční astrologie. Knihovna má překlad do češtiny."},"c0001":{"cs":"Kniha 1 Tetrabiblosu slouží jako úvodní filozofický a metodologický rámec pro celé dílo, kde Ptolemaios vysvětluje rozdíl mezi geometrickým popisem nebeských pohybů a jejich fyzikálními příčinami, a zdůrazňuje potřebu jejich oddělení kvůli nejistotě v přírodní filozofii. Zabývá se možností a užitečností předpovědí založených na astronomickém poznání, přičemž vysvětluje, jak síly nebeských těles prostřednictvím slunečního působení ovlivňují přírodní jevy, růst rostlin, chování živočichů a kvalitu těl. Popisuje systém zvířetníku jako harmonického celku rozděleného na dvanáct znamení, dvanáct domů a tři trojúhelníky, přičemž každé znamení je přiřazeno určité planetě, božstvu a přirozené vlastnosti. Kritizuje nesoulad mezi egyptským a chaldejským systémem, zpochybňuje logiku některých přiřazení a zdůrazňuje, že i přes omezení předvídání má astrologie hodnotu, pokud je používána s rozvahou a v souladu s filozofickým poznáním."},"c0002":{"cs":"Kapitola představuje systematickou astrologickou geografii, ve které Ptolemaios vysvětluje, jak poloha země vůči zvířetníku, klimatické pásy a planetární vlivy ovlivňují lidské charaktery, společenské zvyky a osudy. Svět je rozdělen na čtyři čtvrtiny podle geometrického uspořádání a přiřazovány konkrétním planetám a bohům. Každá oblast má specifické morální, kulturní a fyzické rysy, které jsou vysvětleny přirozenými a astrologickými principy. Zvláštní pozornost je věnována vlivu zeměpisných pásů na barvu kůže, tělesnou stavbu a chování, stejně jako významu zatmění, barev a atmosférických jevů jako předzvěstí událostí. Text ukazuje, jak astrologie slouží k pochopení přírodních a lidských dějin."},"c0003":{"cs":"Kniha 3 díla Ptolemaia je centrální částí jeho astrologického systému, která rozvíjí teorii genethliakální analýzy – tedy předpovědi osudu člověka podle jeho narození. Zabývá se vlivem planet a hvězd na lidskou přirozenost, charakter, zdraví a životní události, přičemž zdůrazňuje, že tyto vlivy nejsou náhodné, ale odpovídají přirozenému uspořádání vesmíru. Popisuje vývoj lidské bytosti od počátku v těle matky až po narození, kdy se tělo postupně přizpůsobuje své vnitřní přirozenosti. Metodika zahrnuje analýzu pozic planet v znameních, jejich vzájemných vztahů, vlivu na různé životní období a vztahy, včetně svatby, potomstva, přátelství a smrti. Zdůrazňuje přesnost výpočtů, význam časových cyklů a geometrických konfigurací, jako jsou konjunkce, kvadratury a opozice. Zároveň se zabývá vlivem zemských míst, klimatických podmínek a božských principů na tělesné a duševní charakteristiky člověka."},"c0004":{"cs":"Kapitola se věnuje komplexní astrologické teorii osudu, kde je osud člověka určován polohou Slunce, Měsíce a planet v zvířetníku, jejich vzájemnými konfiguracemi a vztahy k božským principům. Zabývá se vlivem planet na charakter, povolání, manželství, vztahy, počet a pohlaví dětí, zdraví a smrt. Analyzuje význam znamení, jejich pohlavního a přirozeného charakteru, vliv bohů (Zeus, Ares, Afrodita, Hermes, Kronos) na lidské činnosti a morálku. Zahrnuje i astrologické výpočty časových období, vývojové fáze života podle planetárních principů a způsoby smrti podle konfigurací. Text je strukturován jako systématická klasifikace lidských osudů podle astrologických zásad."}}}