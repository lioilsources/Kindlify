a","score":0.3,"count":2,"kind":"orig"},{"term":"příliv","score":0.3,"count":2,"kind":"word"},{"term":"rex","score":0.3,"count":8,"kind":"orig"},{"term":"souboj","score":0.3,"count":2,"kind":"word"},{"term":"vláda","score":0.3,"count":6,"kind":"word"},{"term":"vojenské tažení","score":0.3,"count":3,"kind":"word"}]},"c0008":{"terms":[{"term":"Alexandr Veliký","score":1.0,"count":40,"kind":"entity"},{"term":"konflikt","score":1.0,"count":1,"kind":"word"},{"term":"nástupnictví","score":1.0,"count":3,"kind":"word"},{"term":"politika","score":1.0,"count":1,"kind":"word"},{"term":"rozpad","score":1.0,"count":1,"kind":"word"},{"term":"smrt","score":1.0,"count":5,"kind":"word"},{"term":"smrt krále","score":1.0,"count":1,"kind":"word"},{"term":"vláda","score":1.0,"count":15,"kind":"word"},{"term":"vojsko","score":1.0,"count":3,"kind":"word"},{"term":"Meleager","score":0.46,"count":9,"kind":"orig"},{"term":"Perdicca","score":0.41,"count":11,"kind":"orig"},{"term":"Perdikka","score":0.38,"count":6,"kind":"entity"},{"term":"politická krize","score":0.32,"count":5,"kind":"word"},{"term":"Agathocles Samius","score":0.3,"count":2,"kind":"entity"},{"term":"Antipatros","score":0.3,"count":4,"kind":"entity"},{"term":"Arrhidaeus","score":0.3,"count":3,"kind":"entity"},{"term":"Asia","score":0.3,"count":4,"kind":"entity"},{"term":"Babylon","score":0.3,"count":5,"kind":"entity"},{"term":"Babylonem","score":0.3,"count":3,"kind":"orig"},{"term":"Chaldejci","score":0.3,"count":2,"kind":"entity"},{"term":"Cleopatra","score":0.3,"count":2,"kind":"orig"},{"term":"Cyro","score":0.3,"count":2,"kind":"entity"},{"term":"Epirus","score":0.3,"count":3,"kind":"entity"},{"term":"Harpal","score":0.3,"count":2,"kind":"entity"},{"term":"Hephaestionem","score":0.3,"count":3,"kind":"orig"},{"term":"Hephaistion","score":0.3,"count":4,"kind":"entity"},{"term":"Makedonie","score":0.3,"count":5,"kind":"entity"},{"term":"Makedonština","score":0.3,"count":4,"kind":"entity"},{"term":"Mediae","score":0.3,"count":2,"kind":"orig"},{"term":"Nearchus","score":0.3,"count":3,"kind":"entity"},{"term":"Orsin","score":0.3,"count":2,"kind":"entity"},{"term":"Orsines","score":0.3,"count":3,"kind":"orig"},{"term":"Perdiccae","score":0.3,"count":4,"kind":"orig"},{"term":"Perdiccam","score":0.3,"count":2,"kind":"orig"},{"term":"Perdikas","score":0.3,"count":5,"kind":"entity"},{"term":"Persarum","score":0.3,"count":5,"kind":"entity"},{"term":"Persové","score":0.3,"count":5,"kind":"entity"},{"term":"Pithon","score":0.3,"count":3,"kind":"orig"},{"term":"anulum","score":0.3,"count":3,"kind":"orig"},{"term":"diadema","score":0.3,"count":3,"kind":"orig"},{"term":"dědictví","score":0.3,"count":4,"kind":"word"},{"term":"exercitus","score":0.3,"count":6,"kind":"orig"},{"term":"falsis criminibus","score":0.3,"count":2,"kind":"orig"},{"term":"imperii","score":0.3,"count":3,"kind":"orig"},{"term":"imperium","score":0.3,"count":5,"kind":"orig"},{"term":"pohřeb","score":0.3,"count":4,"kind":"word"},{"term":"regnum","score":0.3,"count":8,"kind":"orig"},{"term":"rex","score":0.3,"count":6,"kind":"orig"},{"term":"vojáci","score":0.3,"count":6,"kind":"word"},{"term":"věrnost","score":0.3,"count":7,"kind":"word"}]}}},"summaries":{"root":{"cs":"Dílo je latinský překlad historie Alexandrůvých tažení od Curtia Ruffa, který zachycuje jeho vojenské úspěchy, politickou strategii, osudové zážitky a křehkost moci v rámci eposu o velkém králi. Obsahuje detailní popis tažení do Indie, obléhání měst, záhadných přírodních jevů, vnitřních konfliktů v armádě a smrti krále. Knihovna má překlad z řeckého originálu. Dílo je významným zdrojem o Alexandrově osobnosti, jeho vztazích k bohům a osudu, a o rozpadu říše po jeho smrti. Zaznamenává přechod od hrdinského eposu k tragédii politického rozpadu."},"c0001":{"cs":"Kniha 3 popisuje Alexandrovy vojenské a politické kroky během tažení proti Persii, začínající jeho příchodem do Gordionu, kde se setkává se slavným Gordickým uzlem, který podle orákula může rozvázat pouze ten, kdo ovládne Asii. Alexander uzel rozetne mečem, čímž symbolicky splní proroctví. Následuje jeho příprava na bitvu, rozdělení sil, příprava na přesun přes úzké průsmyky a konfrontace s perským vojskem, které je výrazně rozdílné v organizaci, výzbroji a morálce. Zároveň se objevují napětí kolem zdraví, zpráv o zradě a zážitky z náhlých smrtí a záchranných akcí."},"c0002":{"cs":"Kniha 4 představuje vrcholnou fázi Alexandrova tažení, kdy se jeho vojsko přesouvá z Blízkého východu do Egypta a dále k rozhodující bitvě u Arbely. Zahrnuje detailní popis obléhání Týru, včetně technických obtíží, námořních bitvy a zničení města po pádu. Dále sleduje cestu přes poušť, zázračnou oázu a návštěvu orákula Iovova Hammon, kde je Alexandr prohlášen za syna boha. Založení Alexandrie symbolizuje novou epochu. Významná je i konfrontace s Dáreem, rozhodnutí o osudu zajatců a morální výběr krále Abdalonyma. Konečně se připravuje na bitvu u Arbely, kde se projevuje Alexandrův vůdčí charakter, jeho náboženská víra a strategická genialita, která vede k vítězství nad Perskou říší."},"c0003":{"cs":"Kapitola 5 z historie Alexandrův tažení popisuje jeho postup po Asii po bitvě u Arbely, kdy Darius uprchl a Alexandr se vydal k bohatým městům jako Susa a Babylon. Zde je přivítán jako nový král, přijímá zlaté poklady a získává obrovské bohatství. Zároveň se zabývá jeho vojenskou organizací, zavedením nových systémů, oceněním statečnosti a zároveň ukazuje morální dekadenci v Babylonu, kde panuje rozpuštěnost a závislost na alkoholu. V dalších částech se objevuje napětí mezi vojáky, zradní plány proti Dáriovi, zničení Persepolis a následná ztráta naděje, kdy se vojáci snaží překonat přírodní překážky a bojové zátěže. Kapitola ukazuje jak vojenskou, tak i morální a politickou složitost Alexandrova tažení."},"c0004":{"cs":"Kniha 6 představuje klíčovou fázi v životě Alexandra Velikého, kdy se po jeho vítězství nad Persií objevuje politická a vojenská krize v Řecku. Zmíněn je odpor Lacedaemonců pod vedením krále Agise, který se snaží vzbouřit Řeky proti makedonskému panování, a jeho spojenectví s Memnonem a Antipatrem. Po bitvě u Corrhagu jsou Lacedaemonci poraženi, což ukončuje jejich odpor. Následně se Alexander přesouvá do Persie, kde začíná přijímat perské zvyky, oděv a rituály, což vede k napětí mezi ním a řeckými vojáky. Kniha popisuje jeho ztrátu disciplíny, závislosti na zábavách a vztah k zajatcům, včetně královny Amazonů Thalestris. Závěr knihy zachycuje vnitřní konflikty, jako je zradu Philotase a jeho mučení, což ukazuje klesání jednoty vojska a ztrátu řeckého ideálu. Kniha tedy ukazuje přechod od hrdinského eposu k tragédii a ztrátě ctnosti."},"c0005":{"cs":"Kniha 7 z historie Curtia Rufa se zabývá politickou a morální krizí v armádě Alexandrůvě po smrti jeho generálů, zejména Filotase a Parmeniona. Příběh sleduje napětí mezi loajalitou k králi a věrností přátelům, když se ukazuje, že i nejblíže stojící příbuzní byli obviněni z úkladu. Zároveň se objevuje záhadná zpráva o zradě, která vede k zatčení a vraždě Parmeniona, přičemž jeho synové jsou zadrženi jako zástupci. Text ukazuje, jak královská moc ovlivňuje lidské vztahy, jak válka způsobuje utrpení, strach a přeměnu osobností, a jak se vnitřní konflikty promítají do vojenského života a politického rozhodování."},"c0006":{"cs":"Kapitola popisuje vojenské rozdělení Alexandrůvho vojska před bitvou, kdy bylo rozděleno na tři části pod vedením Hephaestionu, Coenona a samotného Alexandra. Následuje zpráva o zradě některých barbarů, jejich odplatu a úspěšné zákeřné pasti, ve které byl zabit Attinas. Následuje bitva u Crateru, kde byli poraženi Massageti a Dahae, a následný návrat Alexandrův k Sogdianům. V Maracandě přijímá Alexandr dvě legace – jednu od Derdase, zástupce skytů na Bosporu, a druhou od Phrataphernese, který vládl v oblasti Chorasmiů. Skytové žádají o manželství s Alexandrovou dcerou, a v případě odmítnutí požadují, aby macedonské velmoci byly spojeny s jejich vůdci. Alexandr se poté vydává do oblasti nazývané Bazaira, kde je příroda bohatá na lesy, jezera a divoké zvíře, včetně zvláštního setkání s lvi, kterého Alexandr spolu s Lysimachem zabil."},"c0007":{"cs":"Kniha 9 pokračuje v popisu Alexandrova tažení do Indie, kde se král setkává s národními zvyky, přírodními překážkami a vojenskými výzvami. Zaznamenává se jeho oslava vítězství, rozdělení kořisti a založení měst. Významnou částí kapitoly je námořní výprava do neznámých mořských hlubin, kde se flotila potýká s přírodními záhadami, včetně náhlého návratu moře do řeky, chaosu na vodě a hrozivých příznaků, které připomínají božskou zlost. Král se snaží udržet morálku vojska, přestože vojáci vyčerpáni a zraněni odmítají pokračovat. Po zranění a téměř smrti se Alexandra zotavuje, což vzbuzuje obdiv. Konečně se vydává k oceánu, kde se setkává s neznámými zeměmi a národy, což ukončuje jeho tažení do východu."},"c0008":{"cs":"Kniha 10 zaznamenává poslední fáze Alexandrova velkého tažení a jeho smrt. Zahrnuje tresty za zločiny jeho vůdců, zprávy o záhadných ostrovech plných zlata, konflikty mezi vojenskými vůdci a ztrátu věrnosti vojska. Po smrti Hephaestionova a následné smrti Alexandra se rozpadá říše: vojsko se rozděluje, vzniká vzpoura, a generálové se shromažďují v Babylóně, aby určili nástupce. Přes rozdělení moci a politické intriky, jako je zradu Perdiky proti Meleagrovi, se ukazuje, že osud krále je konec jeho velkého dědictví a začátek nové éry války a rozpadu."}}}