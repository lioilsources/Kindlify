ity"},{"term":"incest","score":0.32,"count":1,"kind":"word"},{"term":"smrt","score":0.32,"count":1,"kind":"word"},{"term":"Ἀπόλλων","score":0.32,"count":1,"kind":"orig"},{"term":"Apollón","score":0.3,"count":1,"kind":"entity"},{"term":"Chór","score":0.3,"count":1,"kind":"entity"},{"term":"Théby","score":0.3,"count":1,"kind":"entity"},{"term":"vražda otce","score":0.3,"count":1,"kind":"word"}]},"c0015":{"terms":[{"term":"Antigona","score":1.0,"count":1,"kind":"word"},{"term":"Kithairón","score":1.0,"count":2,"kind":"entity"},{"term":"Kréón","score":1.0,"count":1,"kind":"entity"},{"term":"Oidipús","score":1.0,"count":5,"kind":"entity"},{"term":"děti","score":1.0,"count":3,"kind":"word"},{"term":"miasma","score":1.0,"count":1,"kind":"word"},{"term":"prokletí","score":1.0,"count":1,"kind":"word"},{"term":"vyhnanství","score":1.0,"count":1,"kind":"word"},{"term":"vina","score":0.67,"count":2,"kind":"word"},{"term":"ΟἸΔΊΠΟΥΣ","score":0.67,"count":5,"kind":"orig"},{"term":"ΚΡΈΩΝ","score":0.65,"count":3,"kind":"orig"},{"term":"Théby","score":0.51,"count":4,"kind":"entity"},{"term":"osud","score":0.51,"count":4,"kind":"word"},{"term":"Korint","score":0.43,"count":2,"kind":"entity"},{"term":"Kreón","score":0.43,"count":2,"kind":"entity"},{"term":"Polybos","score":0.43,"count":2,"kind":"entity"},{"term":"Chóros","score":0.33,"count":1,"kind":"entity"},{"term":"Sfingina hádanka","score":0.33,"count":1,"kind":"word"},{"term":"bůh","score":0.33,"count":1,"kind":"entity"},{"term":"děti Oidipúa","score":0.33,"count":1,"kind":"entity"},{"term":"identity","score":0.33,"count":1,"kind":"word"},{"term":"podsvětí","score":0.33,"count":1,"kind":"word"},{"term":"pohřeb","score":0.33,"count":1,"kind":"word"},{"term":"porada s bohy","score":0.33,"count":1,"kind":"word"},{"term":"pád","score":0.33,"count":1,"kind":"word"},{"term":"rodinná prokletí","score":0.33,"count":1,"kind":"word"},{"term":"rodná města","score":0.33,"count":1,"kind":"entity"},{"term":"rodné místo","score":0.33,"count":1,"kind":"word"},{"term":"sirotci","score":0.33,"count":1,"kind":"word"},{"term":"slitování","score":0.33,"count":1,"kind":"word"},{"term":"štěstí","score":0.33,"count":1,"kind":"word"},{"term":"Θήβαις","score":0.33,"count":1,"kind":"orig"},{"term":"Κιθαιρὼν","score":0.33,"count":1,"kind":"orig"},{"term":"Πόλυβε","score":0.33,"count":1,"kind":"orig"},{"term":"αἰνίγματʼ","score":0.33,"count":1,"kind":"orig"},{"term":"θεοῦ","score":0.33,"count":1,"kind":"orig"},{"term":"θνητὸν","score":0.33,"count":1,"kind":"orig"},{"term":"κάλλος κακῶν ὕπουλον","score":0.33,"count":1,"kind":"orig"},{"term":"καί μʼ ἐποικτίρας Κρέων","score":0.33,"count":1,"kind":"orig"},{"term":"κράτιστος","score":0.33,"count":1,"kind":"orig"},{"term":"νῦν γὰρ κακός τʼ ὢν","score":0.33,"count":1,"kind":"orig"},{"term":"ξύννευσον","score":0.33,"count":1,"kind":"orig"},{"term":"οἴκτισόν σφας","score":0.33,"count":1,"kind":"orig"},{"term":"οὐκ ἔστιν οὐδείς","score":0.33,"count":1,"kind":"orig"},{"term":"πίστιν","score":0.33,"count":1,"kind":"orig"},{"term":"πατήρ","score":0.33,"count":1,"kind":"orig"},{"term":"πατὴρ ἐφάνθην ἔνθεν αὐτὸς ἠρόθην","score":0.33,"count":1,"kind":"orig"},{"term":"συμφορᾶς","score":0.33,"count":1,"kind":"orig"},{"term":"τοιαῦτʼ ὀνειδη λαμβάνων","score":0.33,"count":1,"kind":"orig"},{"term":"τύχαις","score":0.33,"count":1,"kind":"orig"}]}}},"summaries":{"c0001":{"cs":"Král Oidipús se obrací k trpícímu lidu Théb, který přichází k oltářům s větvemi supplication a zpěvem. Město je postiženo morem, který způsobuje nemoc, vyprázdňuje domy a obohacuje Háda nářkem. Oidipús žádá vysvětlení jejich utrpení a projevuje hluboký soucit s jejich bolestí."},"c0002":{"cs":"Chorál vyjadřuje hluboký strach a zoufalství obyvatel Théb před morovou ranou, která postihla město – lidé umírají, pole neúrodná, ženy neporodí, a chorál prosí bohy o pomoc a uzdravení, vzývajíce Zeuse, Artemidu, Bakcha a další bohy jako ochránce a léčitele."},"c0003":{"cs":"Oidipús svolává obyvatele Théba, aby přinesli informace o vrahu krále Laiova, slibuje odměnu a hrozí trestem těm, kteří by mlčeli nebo chránili viníka. Vyhlašuje, že sám bude spolupracovat s božským příkazem a prokletím postihne vraha i jeho rodinu. Následně naléhá na slepého věštce Teiresiáa, aby prozradil pravdu o moru sužující město, zatímco sbor připomíná, že božský věštec je již přiveden. Teiresiás nejprve odmítá mluvit, ale pod tlakem naznačuje, že pravda je v Oidipúovi samotném."},"c0004":{"cs":"Chór zpívá o nejistotě výkladu delfského orákula, které předpovědělo Oidipusovi zločin, a tázá se, zda je skutečně viníkem osudu. Dále lamentuje nad tím, že spravedlnost není zřejmá, dokud nebudou potrestáni ti, kdo ji popírají, a vyjadřuje skepsi vůči možnosti nalézt pravdu ve světě, kde jsou moudří trestáni a zlo zůstává skryto."},"c0005":{"cs":"V této scéně dochází k ostré výměně názorů mezi Oidipem a Kreónem, kde král obviňuje svého švagra ze zrady a spiknutí za účelem sesazení z trůnu. Kreón odmítá obvinění, zdůrazňuje svou loajalitu a navrhuje, aby pravda byla zjištěna prostřednictvím věštby. Sbor vyjadřuje pochybnosti o důvěryhodnosti obvinění, zatímco napětí roste. Nakonec zasahuje Iokasté, která se snaží uklidnit rozhořčené muže a zabránit další eskalaci konfliktu."},"c0006":{"cs":"Chór žádá Oidipa, aby netrestal nevinného přítele bez viny, odkazuje na božskou spravedlnost a osud. Oidipús trvá na vyšetřování vraždy Laiose, zatímco napětí mezi ním, Chórem, Kreónem a Iokasté roste kolem tématu viny, trestu a božského záměru v Théby."},"c0007":{"cs":"Oidipús konfrontuje Iokasté s věštbou o vraždě otce a spánku s matkou, zatímco ona se snaží jej uklidnit tím, že zpochybňuje spolehlivost proroctví a popisuje údajnou smrt Laiose na rozcestí. Oidipús však pochybuje, zda muž, kterého zabil na křižovatce, nebyl právě Laios, což by znamenalo naplnění strašlivého osudu."},"c0008":{"cs":"Chór nejprve chválí věčného a neměnného boha, který nesmrtelně vládne nad lidskou pomíjivostí. Poté varuje, že hybris (pýcha) rodí tyrany, kteří překračují božské a mravní meze, a pokud lidé přestanou ctít svaté zákony a modlitby, bohové již nebudou chránit spravedlivý řád. Nakonec chór lamentuje nad ztrátou božského pořádku, zejména v souvislosti s osudem rodu Laiovy, a vyjadřuje strach, že bohové jako Zeus a Apollón již nebudou chránit svaté věci."},"c0009":{"cs":"Jokasta nejprve prosí bohy o úlevu od trápení Oidipa, poté přichází posel z Korintu s dotazem na Oidipovu polohu. Postupně se dozví, že Polybus je mrtev, což Oidipu přináší dočasnou úlevu, ale zároveň vyvolává otázky o jeho původu. Posel nakonec naznačuje, že Oidipus není Polybin syn, ale byl jako dítě nalezen a předán královské dvojici, což naznačuje jeho skutečný původ z thébské královské linie a hrozí naplnění děsivého proroctví."},"c0010":{"cs":"Chorální sbor se ptá, kdo je otcem Oidipa, zda bůh Pan, Loxias (Apollón) nebo jiná božská postava, a vyjadřuje naději, že Oidípous je miláčkem bohů, zatímco uctívá jeho roli jako vládce a ochránce Théby."},"c0011":{"cs":"Oidipus se vyptává pastýře a služebníka na původ dítěte, které mu bylo předáno k vychování. Postupně se odhaluje, že dítě pocházelo z rodu Laiovy a mělo být zabito, což naznačuje tragické odhalení Oidipova vlastního původu a osudu."},"c0012":{"cs":"Chór se zamýšlí nad pomíjivostí lidského štěstí a používá Oidipa jako příklad toho, jak i ten, kdo dosáhl vrcholu slávy a požehnání bohů, může být sražen do hlubin utrpení kvůli neznalému spáchání hrozného zločinu – vraždy otce a sňatku s matkou. Čas je zde ztvárněn jako neúprosný soudce, který odhaluje skrytou pravdu a vynáší rozsudek nad tím, co bylo dlouho skryto."},"c0013":{"cs":"Posel přináší zprávu o smrti Iokasty, která se po odhalení svého incestního vztahu s Oidipem oběsila. Popisuje její poslední činy a následnou scénu, kdy Oidipus, zasažený hrůzou ze své identity a skutků, v šílenství bodne své oči zlatými sponami z jejího roucha a touží po osvobození od vidění svého prokletí."},"c0014":{"cs":"Oidipús vyjadřuje hlubokou bolest kvůli své slepotě a osudu, viní Apollona ze svých útrap a prosí přátele, aby ho odvedli pryč, jelikož se cítí být prokletím pro své blízké i bohy. Sbor reaguje s soucitem a uznává jeho utrpení jako rovnocenné jeho duševnímu stavu."},"c0015":{"cs":"Oidipús, oslepený a zdrcený poznáním svého původu, prosí Kreóna o vyhnanství z Théb a o to, aby se ujal péče o jeho dcery, které jsou sirotky po jeho pádu. Lamentuje nad svým zločinem proti bohům a přírodnímu řádu, odmítá být pohřben ve městě za života a touží po smrti na hoře Kithairón, kde byli jeho rodiče pohřbeni. Kreón zdůrazňuje nutnost nejprve se poradit s božstvem o dalším postupu."}}}