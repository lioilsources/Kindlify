rd"},{"term":"Klytaimnestra","score":1.0,"count":1,"kind":"entity"},{"term":"Pelopidové","score":1.0,"count":1,"kind":"entity"},{"term":"Sbor","score":1.0,"count":3,"kind":"entity"},{"term":"pomsta","score":1.0,"count":2,"kind":"word"},{"term":"prokletí rodu","score":1.0,"count":1,"kind":"word"},{"term":"spravedlnost","score":1.0,"count":3,"kind":"word"},{"term":"vražda Agamemnóna","score":1.0,"count":1,"kind":"word"},{"term":"ΑἼΓΙΣΘΟΣ","score":1.0,"count":4,"kind":"orig"},{"term":"Aigisthos","score":0.87,"count":4,"kind":"entity"},{"term":"Argos","score":0.41,"count":3,"kind":"entity"},{"term":"vražda","score":0.39,"count":2,"kind":"word"},{"term":"Agamemnón","score":0.3,"count":3,"kind":"entity"},{"term":"Atreus","score":0.3,"count":1,"kind":"entity"},{"term":"Daimon","score":0.3,"count":1,"kind":"entity"},{"term":"Díkē","score":0.3,"count":1,"kind":"entity"},{"term":"Dómos","score":0.3,"count":1,"kind":"entity"},{"term":"Erinyes","score":0.3,"count":1,"kind":"entity"},{"term":"Orestes","score":0.3,"count":1,"kind":"entity"},{"term":"Orestés","score":0.3,"count":1,"kind":"entity"},{"term":"Thyestes","score":0.3,"count":1,"kind":"entity"},{"term":"hostina","score":0.3,"count":1,"kind":"word"},{"term":"hádka","score":0.3,"count":1,"kind":"word"},{"term":"kanibalismus","score":0.3,"count":1,"kind":"word"},{"term":"prokletí","score":0.3,"count":1,"kind":"word"},{"term":"pýcha","score":0.3,"count":1,"kind":"word"},{"term":"trest","score":0.3,"count":1,"kind":"word"},{"term":"vláda","score":0.3,"count":1,"kind":"word"},{"term":"výhrůžky","score":0.3,"count":1,"kind":"word"},{"term":"ΧΟΡΌΣ","score":0.3,"count":3,"kind":"orig"},{"term":"βροτῶν","score":0.3,"count":1,"kind":"orig"},{"term":"δίκη","score":0.3,"count":1,"kind":"orig"},{"term":"δίκην","score":0.3,"count":1,"kind":"orig"},{"term":"δαίμονος","score":0.3,"count":1,"kind":"orig"},{"term":"δικηφόρου","score":0.3,"count":1,"kind":"orig"},{"term":"δωμάτων","score":0.3,"count":1,"kind":"orig"},{"term":"θεοὺς","score":0.3,"count":1,"kind":"orig"},{"term":"κρατηθεὶς","score":0.3,"count":1,"kind":"orig"},{"term":"κρατοῦντε","score":0.3,"count":1,"kind":"orig"},{"term":"πατρῴας","score":0.3,"count":1,"kind":"orig"},{"term":"τυραννος","score":0.3,"count":1,"kind":"orig"},{"term":"τύραννος","score":0.3,"count":1,"kind":"orig"},{"term":"φέγγος","score":0.3,"count":1,"kind":"orig"},{"term":"φίλως","score":0.3,"count":1,"kind":"orig"},{"term":"φανῇ","score":0.3,"count":1,"kind":"orig"},{"term":"ἄξῃ","score":0.3,"count":1,"kind":"orig"},{"term":"Ἀργείων","score":0.3,"count":1,"kind":"orig"},{"term":"Ἐρινύων","score":0.3,"count":1,"kind":"orig"},{"term":"ἡμερώτερος","score":0.3,"count":1,"kind":"orig"},{"term":"ὈΡΈΣΤΗΝ","score":0.3,"count":1,"kind":"orig"}]}}},"summaries":{"c0001":{"cs":"Strážný hlídá královský palác v Argu, vyhlíží noční oblohu a čeká na signální oheň z Tróje, který by oznámil pád města a konec války. Vyčerpán bdělostí, touží po úlevě a naději na konec utrpení, zatímco připravuje se na radostnou zprávu."},"c0002":{"cs":"Chór velebí sílu řeckých válečníků a vzývá božskou přízeň pro výpravu proti Tróji, zároveň rozjímá o roli Zeuse jako nejvyššího boha, který vládne osudem a spravedlností. Zdůrazňuje, že lidská moudrost vzniká skrze utrpení a paměť, a že bolest může vést k prozření. Úryvek také naznačuje blížící se oběť Ifigenie jako nutný akt před plavbou, vyvolávající hluboký morální konflikt mezi povinností a láskou."},"c0003":{"cs":"Sbor vyjadřuje pochybnosti o zprávě o pádu Tróje, zatímco Klytaimnéstra ji obhajuje prostřednictvím podrobného popisu řetězce ohnivých signálů vyslaných z hory Ida přes Řecko do Argos, které považuje za nezvratné znamení bohů. Následně popisuje vítězství Řeků, osud trojských zajatců a modlí se k bohům za ochranu a milost."},"c0004":{"cs":"Chór v Agamemnónu lamentuje nad ztrátou ctihodnosti, válkou a zradou, přičemž zdůrazňuje, že bohové nesmějí být přehlíženi, že spravedlnost (Díkés) nakonec vykoná svůj trest přes Erinýje, a že válka přináší jen popel, prázdné domy a věčný smutek nad zničením rodinného a společenského řádu."},"c0005":{"cs":"Sbor přichází s pochodněmi a popisuje světlo jako příznivé znamení, které osvítí jejich mysli. Herald oznamuje, že přichází z Argu po deseti letech války, vítá zemi a slunce, žádá bohy o milost pro návrat vojska a chválí Agamemnóna jako vítěze, který srovnal Tróju se zemí a obnovil pořádek pod bohovo vůlí."},"c0006":{"cs":"Chór nejprve vzpomíná na Helenu jako příčinu trojské války pod vlivem božské vůle a osudu, poté popisuje výchovu muže lví silou a vděčnosti k rodičům. Dále se zaměřuje na spravedlnost (Díka), která proniká i do temných domovin, trestá hybris a bohům nepřátelské jednání, zejména v kontextu prokletí domu Atreovců po vraždě Agamemnóna. Zmíněny jsou také rituální prvky, osudová nutnost a následky pýchy před bohy."},"c0007":{"cs":"Chór se ptá, jak správně ocenit Agamemnóna jako vůdce a hrdinu, aniž by přeháněl nebo podceňoval jeho zásluhy. Agamemnón obhajuje své vítězství jako božsky schválené a spravedlivé, zdůrazňuje roli bohů v rozhodování o osudu měst a válečných výbojích. Zmiňuje se také o Odysseovi, společné radě města a bohů, a o rituálních obětech za vítězství."},"c0008":{"cs":"Chór lamentuje nad ztrátou života po trojské válce, zpochybňuje, zda bohové umožní návrat mrtvých, a vyjadřuje strach, že osud a božská vůle jsou nemilosrdné. Srdce a jazyk jsou přemoženy zármutkem, zatímco naděje slábne a utrpení přetrvává."},"c0009":{"cs":"Klytaimnéstra přikazuje Kassandře, aby vstoupila do domu a přijala své postavení jako otrokyně u domácího oltáře, zatímco sbor pozoruje její odmítavý postoj a naznačuje, že by měla poslechnout božskou vůli Kassandry jako prorokyně. Klytaimnéstra ji kritizuje za barbarský hlas a nedostatek rozumu, zatímco sbor vyjadřuje soucit s její utrpením způsobeným ztrátou domova a rozumu, předvídaje její budoucí zuřivost."},"c0010":{"cs":"Kassandra, trojská prorokyně, v extatickém lamentu volá po Apollovi a předvídá svou smrt i vraždu Agamemnona, popisuje hrůzy, které ji čekají, včetně kanibalismu a zrady. Sbor reaguje s rozpaky, pochybnostmi o božské spravedlnosti a strachem z nevysvětlitelných znamení, přičemž uznává její proroctví, ale nedokáže jí plně porozumět ani pomoci."},"c0011":{"cs":"Kassandra v extatickém proroctví popisuje své vidiny: vidí mrtvé děti, cítí božské utrpení a předpovídá svou smrt rukou Klytaimnéstry, ale také věští budoucí návrat Oresta, který pomstí Agamemnóna zabitím matky a jejího milence. Sbor pochybuje o jejím rozumu, ale její slova naznačují nevyhnutelný osud domu Atreovců."},"c0012":{"cs":"Sbor vyčítá Klytaimnéstre, že po návratu Agamemnóna z Tróje spáchala vraždu svého manžela a přivolala na sebe božský hněv skrze nečistý čin. Klytaimnéstra se brání tím, že Agamemnón obětoval jejich dceru Ifigénii bohyni Artemidě, což považuje za spravedlivou pomstu za tuto oběť. Konflikt se točí kolem otázky spravedlnosti, rituální čistoty a hranic mezi právem a pomstou."},"c0013":{"cs":"Klytaimnestra mluví o své přísaze učiněné na počest spravedlnosti své dcery, vyjadřuje neochvějnou vůli pomstít se za smrt Agamemnóna a zdůrazňuje své spojenectví s Aigisthosem, zatímco popisuje Kassandru jako prorockou zajatkyni, která plní roli věštkyně a společnice."},"c0014":{"cs":"Chór lamentuje nad ztrátou životů kvůli Heleně a Trojské válce, zatímco Klytaimnestra odmítá proklínat smrt a hledá smysl v pomstě a obnově. Následuje dialog plný zármutku, otázek po spravedlnosti a vině, odkazující na prokletí rodu Atreovců, roli božského soudu (zejména Dia) a nevyhnutelnosti osudu. Zaznívají témata truchlení, pomsty, věrnosti a božského zákona, který přesahuje lidské jednání."},"c0015":{"cs":"Aigisthos vypráví o tom, jak Atreus zabil Thyestovy syny a podával jim jejich maso na hostině, čímž vyvolal prokletí rodu Pelopidů. Tato zločinnost podle něj ospravedlňuje jeho vlastní roli při vraždě Agamemnóna jako akt spravedlnosti. Sbor jej však kritizuje za pýchu a neúctu k božské spravedlnosti, varuje před příchodem Oresta a pochybnostmi o morální oprávněnosti činu. Klytaimnestra nakonec vyzývá k jednotě ve vládě nad domem."}}}