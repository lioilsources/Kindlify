:28,"kind":"entity"},{"term":"Lavinie","score":1.0,"count":2,"kind":"word"},{"term":"Mars","score":1.0,"count":4,"kind":"entity"},{"term":"Pallant","score":1.0,"count":1,"kind":"entity"},{"term":"Turnus","score":1.0,"count":33,"kind":"entity"},{"term":"Venuše","score":1.0,"count":6,"kind":"entity"},{"term":"pomsta","score":1.0,"count":2,"kind":"word"},{"term":"souboj","score":1.0,"count":6,"kind":"word"},{"term":"boj","score":0.38,"count":16,"kind":"word"},{"term":"Latinus","score":0.37,"count":10,"kind":"entity"},{"term":"Aeneis","score":0.3,"count":5,"kind":"entity"},{"term":"Arcades","score":0.3,"count":2,"kind":"entity"},{"term":"Asilas","score":0.3,"count":3,"kind":"entity"},{"term":"Ausonii","score":0.3,"count":3,"kind":"entity"},{"term":"Dardanidé","score":0.3,"count":2,"kind":"entity"},{"term":"Dauni","score":0.3,"count":2,"kind":"entity"},{"term":"Iapyx","score":0.3,"count":2,"kind":"entity"},{"term":"Iuppiter","score":0.3,"count":5,"kind":"entity"},{"term":"Iuturna","score":0.3,"count":5,"kind":"entity"},{"term":"Iuturnam","score":0.3,"count":2,"kind":"orig"},{"term":"Juno","score":0.3,"count":6,"kind":"entity"},{"term":"Jupiter","score":0.3,"count":7,"kind":"entity"},{"term":"Juturna","score":0.3,"count":5,"kind":"entity"},{"term":"Latini","score":0.3,"count":10,"kind":"entity"},{"term":"Latinské město","score":0.3,"count":4,"kind":"entity"},{"term":"Lavinia","score":0.3,"count":8,"kind":"entity"},{"term":"Messapus","score":0.3,"count":6,"kind":"entity"},{"term":"Metisci","score":0.3,"count":2,"kind":"orig"},{"term":"Mnestheus","score":0.3,"count":5,"kind":"entity"},{"term":"Rutuli","score":0.3,"count":5,"kind":"entity"},{"term":"Rutulové","score":0.3,"count":7,"kind":"entity"},{"term":"Troes","score":0.3,"count":3,"kind":"entity"},{"term":"Trojani","score":0.3,"count":5,"kind":"word"},{"term":"Turnum","score":0.3,"count":2,"kind":"orig"},{"term":"bitva","score":0.3,"count":9,"kind":"word"},{"term":"bohové","score":0.3,"count":5,"kind":"word"},{"term":"božská pomoc","score":0.3,"count":4,"kind":"word"},{"term":"furiis","score":0.3,"count":2,"kind":"orig"},{"term":"kopí","score":0.3,"count":3,"kind":"word"},{"term":"láska","score":0.3,"count":3,"kind":"word"},{"term":"léčení","score":0.3,"count":2,"kind":"word"},{"term":"meč","score":0.3,"count":9,"kind":"word"},{"term":"mír","score":0.3,"count":4,"kind":"word"},{"term":"osud","score":0.3,"count":5,"kind":"word"},{"term":"pronásledování","score":0.3,"count":3,"kind":"word"},{"term":"přísaha","score":0.3,"count":2,"kind":"word"},{"term":"rituál","score":0.3,"count":4,"kind":"word"},{"term":"urbem","score":0.3,"count":2,"kind":"orig"},{"term":"válka","score":0.3,"count":7,"kind":"word"},{"term":"zkáza","score":0.3,"count":2,"kind":"word"}]}}},"summaries":{"c0001":{"cs":"Kniha 1 Aeneidy začíná invokací Muse a líčí Aeneův útěk z hořící Troje jako faktického uprchlíka vedeného osudem do Itálie, kde má založit nový národ. Junina zloba vůči Trojanům pramení z Paridova soudu a Ganymédovy pocty, což ji vede k vyvolání bouře proti Aeneově flotile. Díky zásahu Neptuna a Aeola jsou lodě zachráněny a Trojci přistávají v Libyi, kde nacházejí útočiště a začínají budovat nový život pod ochranou bohů."},"c0002":{"cs":"Aeneas vypráví o pádu Tróje po deseti letech obléhání, kdy Řekové použili lstivý dřevěný kůň s ukrytými válečníky. Navzdory varováním Laokoöna Trojané koně vtáhli do města. V noci Řekové vylezli, zapálili Tróju a zabíjeli obyvatele. Aeneas se snaží bránit město, vidí ducha Hektora, který ho vyzývá k útěku. Po smrti Priama a ztrátě ženy Creüsy se mu zjeví matka Venuše, která ho zachraňuje a posílá do exilu zakládat nový národ."},"c0003":{"cs":"Aeneas s trojskými uprchlíky opouští zničenou Troju a pluje po moři podle božských znamení. Během cesty prožívá ztrátu otce Anchisea, setkává se s proroctví (zejména přes Hélena a Sibylu), čelí nebezpečím jako harpyje či Charybda a nakonec spatří italské pobřeží, kde se připravuje na přistání a založení nové Troje."},"c0004":{"cs":"Kniha 4 Aeneidy líčí zamilovanost královny Dido do trojského hrdiny Aenea, její vnitřní boj mezi láskou a povinností vůči bohům a státu, zásah bohů (zejména Juny a Venuše) do jejich vztahu, Aeneovo božské poselství k odjezdu do Itálie, Didovu zoufalost a nakonec její sebevraždu na pohřební hranici po Aeneově odplutí."},"c0005":{"cs":"Kniha 5 Aeneidy líčí pohřební hry na Sicílii po smrti Anchise. Aeneas uctívá svého otce obřady, oběťmi a hrami: lodními závody (s vítězstvím Cloantha díky modlitbě Neptunu), během (kde Nisus padá poblíž cíle), boxem (Entellus vs. Dares) a lukostřelbou (vítěz Hippocoön). Mezi soutěžemi se střídají znamení (had u hrobu, duha od Juno), božské zásahy (Juno zapaluje lodě, Neptun pomáhá) a Aeneovo váhání o další cestě, nakonec posílené vzkazem otcova ducha a radou Nauta k odplutí do Itálie."},"c0006":{"cs":"Aeneas, vedený Sibylou, vstupuje do podsvětí přes jeskyni u Kymy, kde prochází branami smrti, setkává se s dušemi zemřelých, včetně svého otce Anchisea, který mu odhalí budoucnost Říma a jeho potomků, zatímco Aeneas prožívá setkání s duší Didony a padlými hrdiny Trojské války."},"c0007":{"cs":"Aeneas po pohřbu své chůvy Caiety pokračuje v plavbě k italským břehům, kde pozoruje Tiber a okolní krajinu. Dotazuje se bohyně Erato na historii Latia a připravuje se na jednání s králem Latinem. Ten prostřednictvím orákula Faunu dostává božské varování, že jeho dcera Lavinia se nesmí provdat za Latina, ale za cizince, jehož potomci budou vládnout světu. Mezitím Juno, rozzlobená na Trojany, posílá bohyni Allecto, aby vyvolala válku tím, že rozdmýchává zuřivost u královny Amaty a prince Turnuse, což vede k přípravě na boj i přes mírové úmysly Latinuse."},"c0008":{"cs":"Aeneas dorazí do Pallantea, kde je přivítán králem Evandrem. Po výměně darů a ujištění o společném původu se zúčastní slavnosti na počest Herkula, během níž dochází k znamení v podobě bílé prasnice. Následně obdrží od své matky Venuše zbroj vykovanou Vulkanem, která obsahuje vyobrazení budoucí slávy Říma."},"c0009":{"cs":"Nisus a Euryalus žádají o svolení k výpadu do nepřátelského tábora, aby prokázali svou statečnost. Po úspěšném začátku jsou však objeveni Rutuly a v následném boji padnou – Euryalus je zabit, Nisus se jej snaží pomstít a také umírá. Jejich obětavá smrt se stává symbolem přátelství a věrnosti."},"c0010":{"cs":"Na Olympu se shromažďují bohové pod vedením Jupitera, který řeší porušení svého zákazu války v Itálii a blížící se konflikt mezi Trojany a Latinskem. Mezitím zuří tvrdý boj na pobřeží: Aeneasovo vojsko je obklíčeno Rutuly, dochází k hrdinským činům, úmrtím mladých válečníků jako Pallant a Laus, božským zásahům a tragickým výstupům osudu a pomsty."},"c0011":{"cs":"Aeneas staví trofej ze zbroje Mezentia, uctívá padlé spolubojovníky a nařizuje pohřeb nezahalených těl jako nejvyšší poctu. Oplakává smrt Palla, syna Evandra, připravuje jeho pohřeb s vojenskými poctami a vyzývá své muže k přípravě na další boj proti Latinům, zatímco zdůrazňuje pietu, povinnost a osud."},"c0012":{"cs":"V knize 12 Aeneidy vyvrcholí válka mezi Trojany a Rutuly rozhodným soubojem mezi Aeneasem a Turnem. Po božské podpoře Venuše a Marsu, po chvíli váhání a Turnově prosbě o život, Aeneas nakonec zabije Turnu kopím do hrudi, spatřiv pás zabitého Pallanta na Turnově rameni – akt pomsty uzavírá válku a otevírá cestu k založení Říma."}}}