":"scientia","score":0.5,"count":5,"kind":"orig"},{"term":"pravda","score":0.48,"count":10,"kind":"word"},{"term":"božské poznání","score":0.4,"count":4,"kind":"word"},{"term":"budoucnost","score":0.4,"count":4,"kind":"word"},{"term":"libertas","score":0.4,"count":4,"kind":"orig"},{"term":"sensus","score":0.4,"count":4,"kind":"orig"},{"term":"poznání","score":0.39,"count":7,"kind":"word"},{"term":"ratio","score":0.39,"count":5,"kind":"orig"},{"term":"De consolatione philosophiae","score":0.34,"count":7,"kind":"entity"},{"term":"opinio","score":0.31,"count":4,"kind":"orig"},{"term":"příčina","score":0.31,"count":4,"kind":"word"},{"term":"svoboda vůle","score":0.31,"count":4,"kind":"word"},{"term":"arbitrii","score":0.3,"count":2,"kind":"orig"},{"term":"arbitrium","score":0.3,"count":2,"kind":"entity"},{"term":"casus","score":0.3,"count":2,"kind":"orig"},{"term":"cognoscit","score":0.3,"count":2,"kind":"orig"},{"term":"determinismus","score":0.3,"count":3,"kind":"word"},{"term":"diuinae","score":0.3,"count":2,"kind":"orig"},{"term":"exitus","score":0.3,"count":3,"kind":"orig"},{"term":"futura","score":0.3,"count":3,"kind":"orig"},{"term":"imaginatio","score":0.3,"count":3,"kind":"orig"},{"term":"liberum","score":0.3,"count":2,"kind":"orig"},{"term":"lidský rozum","score":0.3,"count":2,"kind":"word"},{"term":"necessitas","score":0.3,"count":3,"kind":"orig"},{"term":"necessitate","score":0.3,"count":2,"kind":"orig"},{"term":"necessitatis","score":0.3,"count":2,"kind":"orig"},{"term":"nihilo","score":0.3,"count":2,"kind":"orig"},{"term":"praesentia","score":0.3,"count":2,"kind":"orig"},{"term":"prospiciens","score":0.3,"count":2,"kind":"orig"},{"term":"prouidentia","score":0.3,"count":3,"kind":"orig"},{"term":"představa","score":0.3,"count":2,"kind":"entity"},{"term":"předvídání budoucnosti","score":0.3,"count":2,"kind":"word"},{"term":"předvědomost","score":0.3,"count":3,"kind":"word"},{"term":"předvědění","score":0.3,"count":2,"kind":"word"},{"term":"přítomnost","score":0.3,"count":2,"kind":"word"},{"term":"rozum","score":0.3,"count":4,"kind":"word"},{"term":"smyšly","score":0.3,"count":2,"kind":"word"},{"term":"spojení příčin","score":0.3,"count":2,"kind":"word"}]}}},"summaries":{"root":{"cs":"„De consolatione philosophiae“ je filozofická práce Boethia, napsaná během vězení a vyhnanství. Dílo má formu dialogu mezi autorem a personifikovanou Filosofií, která mu pomáhá překonat utrpení a ztrátu světských cílů. Kniha se skládá z pěti kapitol, které postupně rozvívají téma osudu, spravedlnosti, božské providence, svobodné vůle a skutečného štěstí. Boethius argumentuje, že pravé štěstí je v Bohu, který je jednotným zdrojem všeho dobrého. Významná je i analýza zla jako chyby, ne jako síly, a vysvětlení, že božské poznání neomezuje lidskou volbu. Knihovna má překlad do češtiny."},"c0001":{"cs":"První kniha De consolatione philosophiae začíná Boethiovim smutným příběhem – ztrátou slávy, světského vlivu a zdraví. V této krizi se mu zjeví Filosofie jako žena v neobyčejné podobě, která se mění mezi zemskou a nebeskou rovinou. Je oděna v roucho s řeckými písmeny Π a θ, symbolizujícími stupně poznání. Filosofie kritizuje světské písně, které ho jen utěšují, a začíná s ním rozhovor o podstatě člověka, světa a osudu. Zdůrazňuje, že jeho utrpení vychází z omylu – ztráty vědomí o svém skutečném já a o tom, že svět je řízen božskou rozumovou vůlí, nikoli náhodou. Tento rozhovor je základem celého díla – prvním krokem k osvobození z utrpení prostřednictvím filozofického poznání."},"c0002":{"cs":"Ve druhé knize Boethius přijímá výklad osudu, který se objevuje jako živá bytost, aby vysvětlila příčiny jeho utrpení. Osud zdůrazňuje, že lidské štěstí je dočasné a závislé na jeho milosti, nikoli na vlastních zásluhách. Všechny vnější úspěchy – bohatství, důstojnosti, rodinné štěstí – jsou ztratitelné a nezaručují trvalé štěstí. Pravá hodnota člověka spočívá v ctnosti, rozumu a vnitřní rovnováze, které neztrácejí při změnách osudu. Boethius se učí přijímat osud klidně, protože odpor proti němu je zbytečný a nesmyslný. Proměnlivost osudu je spravedlivá a součástí vyššího řádu, který udržuje harmonii ve vesmíru."},"c0003":{"cs":"Kniha 3 De consolatione philosophiae se zabývá přirozenou touhou lidí k dobrému a jejím zkreslením v důsledku lidského omylu. Boethius ukazuje, že všechny lidské cíle – bohatství, sláva, moc, užitky – jsou pouze falešnými formami touhy po dobrém, která je vnitřně vložena do lidské duše. Pravé štěstí (beatitudo) je dokonalý stav, který zahrnuje dostatečnost, sílu, slávu a úctu, a je jednotnou podstatou všeho dobrého. Tento stav nemůže být dosažen žádným vnějším cílem, protože je vnitřně dokonalý a nezávislý. Boethius argumentuje, že takové štěstí může existovat pouze v Bohu, který je zároveň nejvyšším dobrým, dokonalým a nezměnným. Všechny světské hodnoty jsou dočasné a zničitelné, zatímco božské dobré je věčné a neoddělitelné. Konečně se dospívá k závěru, že pravé štěstí je jednotné s božskou podstatou a že každý člověk, který se k ní přiblíží, se stává bohem v podstatě."},"c0004":{"cs":"Kniha 4 De consolatione philosophiae se zaměřuje na hlubokou filozofickou analýzu spravedlnosti, osudu a božské providence. Filozofie vysvětluje, že spravedlivost a dobré jednání jsou vždy odměněny, zatímco zlo a nečestnost jsou vždy trestány, i když se to na první pohled nezdá. Základem je myšlenka, že dobré a zlé jsou protiklady, a proto když dobrý člověk dosáhne svého cíle, zatímco zlý ne, musí být dobrý silnější. Všechny lidské činy závisí na vůli a schopnosti – bez vůle se nic nezačne, bez schopnosti je vůle marná. Zlo není skutečnou mocí, ale slabostí, protože jeho existence závisí na odchýlení od přirozeného uspořádání. Spravedlivost je vnitřní odměnou, zlo vnitřním trestem. Božský řád všechno uspořádává k dobrému, i když lidské poznání je omezené a svět se nám jeví jako zmatený. Příroda, osud a božská předvídavost jsou součástí jednotného, nehybného záměru, který vede k věčnému dobrému."},"c0005":{"cs":"Kapitola se zaměřuje na kritickou analýzu pojmu náhody (casus) a jejího místa v božském uspořádání vesmíru. Filozofka vysvětluje, že nic nevzniká z ničeho a že i náhodné události jsou výsledkem spojení příčin, které se setkaly bez úmyslu, jak ukazuje příklad nálezu zlata při orání. Následně se Boethius zabývá hlubší otázkou svobodné vůle v kontextu božské předvědomosti. Zdůrazňuje, že i když Bůh věčně vědí vše, co se stane, to neznamená, že by lidské jednání bylo nutné. Božské poznání je věčné a současné – vše je pro něj přítomno najednou – a proto nezpůsobuje, ale jen vidí. Svobodná vůle zůstává zachována, protože člověk může volit, i když jeho volba je již známa. Tím je zachována spravedlivost trestů a odměn, a lidská odpovědnost zůstává reálná."}}}