nd":"entity"},{"term":"Héra","score":0.54,"count":7,"kind":"entity"},{"term":"Ποσειδῶν","score":0.54,"count":7,"kind":"entity"},{"term":"Chiron","score":0.5,"count":4,"kind":"entity"},{"term":"Oedipus","score":0.5,"count":4,"kind":"entity"},{"term":"býk","score":0.5,"count":4,"kind":"word"},{"term":"Οἰδίπους","score":0.5,"count":4,"kind":"orig"},{"term":"Ἀλκμαίων","score":0.5,"count":4,"kind":"orig"},{"term":"Ἀμφιάραος","score":0.5,"count":4,"kind":"orig"},{"term":"Μίνως","score":0.48,"count":5,"kind":"orig"},{"term":"Θήβας","score":0.46,"count":6,"kind":"orig"},{"term":"Argos","score":0.38,"count":5,"kind":"entity"},{"term":"Artemis","score":0.38,"count":4,"kind":"entity"},{"term":"Daidalos","score":0.38,"count":3,"kind":"entity"},{"term":"Dionýsos","score":0.38,"count":4,"kind":"entity"},{"term":"Minós","score":0.38,"count":4,"kind":"entity"},{"term":"Parthenopaios","score":0.38,"count":3,"kind":"entity"},{"term":"Polynikés","score":0.38,"count":3,"kind":"entity"},{"term":"Poseidón","score":0.38,"count":5,"kind":"entity"},{"term":"Pélés","score":0.38,"count":3,"kind":"entity"},{"term":"přeměna","score":0.38,"count":3,"kind":"word"},{"term":"synové","score":0.38,"count":3,"kind":"word"},{"term":"věštba","score":0.38,"count":4,"kind":"word"},{"term":"Κάδμος","score":0.38,"count":4,"kind":"orig"},{"term":"Κέκροψ","score":0.38,"count":3,"kind":"orig"},{"term":"Τυνδάρεως","score":0.38,"count":3,"kind":"orig"},{"term":"θεὸς","score":0.38,"count":3,"kind":"orig"},{"term":"παῖδας","score":0.38,"count":3,"kind":"orig"},{"term":"Ἀμφίων","score":0.38,"count":3,"kind":"orig"},{"term":"Ἀπόλλων","score":0.38,"count":5,"kind":"orig"},{"term":"Ἀφροδίτης","score":0.38,"count":3,"kind":"orig"},{"term":"Ἐριχθόνιος","score":0.38,"count":3,"kind":"orig"},{"term":"ὅρμον","score":0.38,"count":3,"kind":"orig"},{"term":"Hermes","score":0.31,"count":4,"kind":"entity"},{"term":"Poseidon","score":0.31,"count":4,"kind":"entity"},{"term":"oběť","score":0.31,"count":4,"kind":"word"}]}}},"summaries":{"root":{"cs":"„Bibliothéka“ Apollodora je systematická sbírka řeckých mytů, která zahrnuje kosmologii od prvních bytostí až po vznik Olympských bohů, genealogie božských a lidských postav, hrdinské cykly, včetně dvanácti úkolů Hérakla, příběhů o Bellerofontovi, Oedipovi, sedmi proti Thébám a osudech Argu, Sparty a Troje. Obsahuje též proroctví, rituály, božské zásahy a osudové závěry. Dílo sloužilo jako průvodce mytologickým vědomím a bylo přeloženo do latiny, což umožnilo jeho šíření v středověku. Je klíčovým zdrojem starověké řecké mytologie."},"c0001":{"cs":"Kniha 1 Apollodora uvádí mytologický počátek vesmíru: z Chaosu vznikla Gaia, Uranos a další první bytosti, mezi nimiž se rodí Titáni, Kyklopi a Hekatoncheirové. Uranos je svržen Kronosem, který žije ve strachu a žere své děti. Rea zachrání Dia, který později svržené sourozence osvobodí a vede válku proti Titánům. Po vítězství se vláda rozdělí mezi bohy. Následuje rozsáhlá genealogie bohů, jejich potomků a personifikací – větrů, hvězd, nymf, bohyní. Zahrnuje i příběhy o Zeusově lásce, narození Apollóna a Artemis, zabití Pythóna, osudu Orfea, příběhu Persefóny, potopy Deukalióna, boje proti Gigantom a Typhónovi. Závěr se věnuje příběhům hrdinů jako Héraklés, Prométheus, Iáson a Argonauti, včetně jejich cesty za zlatým rounem."},"c0002":{"cs":"Kniha 2 řeckého mytologického díla obsahuje rozsáhlou genealogii a příběhy prvních králů Peloponésu, začínající Argem, potomkem Niobey a Dia. Zmiňuje se o jeho předcích, založení měst a osudu. Dále sleduje příběh Ió, která byla proměněna v býka bohem Zeusem a pronásledována Hérou, a její útěk do Egypta, kde porodila Épafos, z něhož pochází linie vedoucí k Danaovi. Příběh pokračuje příběhem synů Danaa a Egyptany, jejich konfliktu a útěku do Argosu. Následuje tragická osudná svatba dcer Danaa s Egyptany, kde všechny novomanželé jsou zavražděny kromě Hypermnestry. Příběh Bellerofonta, který je obviněn z nečestnosti a zabit, a příběh Persea, který zabil Medúzu, zachránil Andromédu a založil vládu v Sírifu. Největší část kapitoly je věnována Hérakleovým dvanácti úkolům – od zabití leva z Nemey přes boj s hydrou, získání zlatých jablek až po přivolení psa Kerbera z podsvětí. Kapitola ukazuje tematické osy jako osud, spravedlnost, božské zásahy, rituály, války a osvobození, včetně posledních dní Hérakleových potomků a jejich návratu do Peloponésu."},"c0003":{"cs":"Kniha 3 „Bibliothéky“ Apollodora je souhrnem mnoha klíčových mytologických příběhů, které tvoří jádro řecké hrdinské tradice. Zabývá se původem a osudem postav jako Minós, Dionýsos, Oedipus, sedmi hrdinů proti Thébám, Heraklés, Pélés, Achilés, a jejich rodinnými a politickými vztahy. Zahrnuje i příběhy o proroctví, obětech, válkách, národních zákonech, náboženských rituálech a osudech, které ovlivňují osudy jednotlivců i celých měst. Obsahuje také genealogické linie, včetně původu Athény, Sparty, Troje a Kretu, a ukazuje, jak božské zásahy, lidská hrdost a osudové předpovědi tvarují dějiny."}}}