},{"term":"coniunx","score":0.48,"count":3,"kind":"orig"},{"term":"Colchida","score":0.41,"count":3,"kind":"orig"},{"term":"amor","score":0.41,"count":3,"kind":"orig"},{"term":"touha","score":0.41,"count":3,"kind":"word"},{"term":"Circaeis","score":0.4,"count":2,"kind":"orig"},{"term":"Mavortis","score":0.4,"count":2,"kind":"orig"},{"term":"Orestes","score":0.4,"count":2,"kind":"orig"},{"term":"boj","score":0.4,"count":5,"kind":"word"},{"term":"hospes","score":0.4,"count":2,"kind":"orig"},{"term":"lucis","score":0.4,"count":2,"kind":"orig"},{"term":"odchod","score":0.4,"count":2,"kind":"word"},{"term":"pudor","score":0.4,"count":2,"kind":"orig"},{"term":"rodina","score":0.4,"count":2,"kind":"word"},{"term":"rozloučení","score":0.4,"count":2,"kind":"word"},{"term":"sororis","score":0.4,"count":2,"kind":"orig"},{"term":"spes","score":0.4,"count":2,"kind":"orig"},{"term":"supplex","score":0.4,"count":2,"kind":"orig"},{"term":"tauros","score":0.4,"count":2,"kind":"orig"},{"term":"vnitřní boj","score":0.4,"count":2,"kind":"word"},{"term":"zradu","score":0.4,"count":2,"kind":"word"},{"term":"Aesoniden","score":0.36,"count":3,"kind":"orig"},{"term":"Pelias","score":0.36,"count":3,"kind":"entity"},{"term":"Phrixus","score":0.36,"count":3,"kind":"entity"},{"term":"Iasona","score":0.32,"count":2,"kind":"orig"},{"term":"Jason","score":0.32,"count":4,"kind":"entity"},{"term":"návrat","score":0.32,"count":2,"kind":"word"},{"term":"prosba","score":0.32,"count":2,"kind":"word"},{"term":"přísaha","score":0.32,"count":3,"kind":"word"},{"term":"Hecate","score":0.3,"count":2,"kind":"orig"},{"term":"Mavors","score":0.3,"count":2,"kind":"orig"},{"term":"božská zásah","score":0.3,"count":2,"kind":"word"}]},"c0008":{"terms":[{"term":"Medea","score":1.0,"count":6,"kind":"orig"},{"term":"božský zásah","score":1.0,"count":2,"kind":"word"},{"term":"cesta","score":1.0,"count":4,"kind":"word"},{"term":"lásková touha","score":1.0,"count":1,"kind":"word"},{"term":"osud","score":1.0,"count":11,"kind":"word"},{"term":"rodinný konflikt","score":1.0,"count":2,"kind":"word"},{"term":"ztracený drak","score":1.0,"count":1,"kind":"word"},{"term":"útěk","score":1.0,"count":6,"kind":"word"},{"term":"puppem","score":0.69,"count":3,"kind":"orig"},{"term":"svatba","score":0.69,"count":3,"kind":"word"},{"term":"Aesonide","score":0.63,"count":4,"kind":"orig"},{"term":"Colchis","score":0.61,"count":5,"kind":"entity"},{"term":"sacra","score":0.56,"count":3,"kind":"orig"},{"term":"Argonauté","score":0.55,"count":6,"kind":"word"},{"term":"Absyrtus","score":0.47,"count":3,"kind":"orig"},{"term":"Danubii","score":0.46,"count":2,"kind":"entity"},{"term":"Peucen","score":0.46,"count":2,"kind":"entity"},{"term":"drak","score":0.46,"count":2,"kind":"entity"},{"term":"tempestatum","score":0.46,"count":2,"kind":"orig"},{"term":"virgine","score":0.46,"count":2,"kind":"orig"},{"term":"Aesonides","score":0.45,"count":5,"kind":"entity"},{"term":"Argonauts","score":0.37,"count":2,"kind":"entity"},{"term":"Haemonii","score":0.37,"count":2,"kind":"entity"},{"term":"Hister","score":0.37,"count":2,"kind":"entity"},{"term":"bellum","score":0.37,"count":2,"kind":"orig"},{"term":"matka","score":0.37,"count":2,"kind":"word"},{"term":"portus","score":0.37,"count":2,"kind":"orig"},{"term":"prosba","score":0.37,"count":2,"kind":"word"},{"term":"rates","score":0.37,"count":2,"kind":"orig"},{"term":"Jason","score":0.36,"count":4,"kind":"entity"},{"term":"Argo","score":0.33,"count":3,"kind":"entity"},{"term":"fugam","score":0.31,"count":2,"kind":"orig"},{"term":"příslib","score":0.31,"count":2,"kind":"word"},{"term":"venenis","score":0.31,"count":2,"kind":"orig"},{"term":"Achivi","score":0.3,"count":1,"kind":"entity"},{"term":"Aeetius","score":0.3,"count":1,"kind":"orig"},{"term":"Aetius","score":0.3,"count":1,"kind":"entity"},{"term":"Albano tyranno","score":0.3,"count":1,"kind":"entity"},{"term":"Aoniis","score":0.3,"count":1,"kind":"entity"},{"term":"Chaonio","score":0.3,"count":1,"kind":"entity"},{"term":"Colchides","score":0.3,"count":1,"kind":"orig"},{"term":"Cretheia proles","score":0.3,"count":1,"kind":"entity"},{"term":"Cupid","score":0.3,"count":1,"kind":"entity"},{"term":"Cyaneasque","score":0.3,"count":1,"kind":"orig"},{"term":"Cybele","score":0.3,"count":1,"kind":"entity"},{"term":"manželství","score":0.3,"count":2,"kind":"word"},{"term":"vellera","score":0.3,"count":2,"kind":"orig"},{"term":"věrnost","score":0.3,"count":2,"kind":"word"},{"term":"zlaté rouno","score":0.3,"count":2,"kind":"word"},{"term":"zoufalství","score":0.3,"count":2,"kind":"word"}]}}},"summaries":{"root":{"cs":"Argonautica je latinský hrdinský epos Valerius Flaccus, který vypráví o výpravě Jásona a Argonautů na cestu do Kolchidy za zlatým rounem. Dílo je rozděleno do osmi knih, každá z nich zachycuje jednu fázi cesty: od shromaždění hrdinů a stavby lodi Argo přes překonávání přírodních a božských překážek, bitvy, ztráty, proroctví a osudové rozhodnutí. Významně se objevují božské zásahy, rituály, oběti, modlitby a etické otázky týkající se osudu, spravedlnosti, lásky a věrnosti. Překlad do češtiny je součástí knihovní sbírky."},"c0001":{"cs":"Kniha 1 Argonautiky zachycuje začátek hrdinské výpravy za zlatým rounem, kdy se hrdinové shromažďují v Thespii pod vedením Jásona, syna Aesona. Připravují se na cestu, staví loď Argo, obětují bohům a přijímají božské znamení. Zároveň se objevují proroctví, jako je výzva Idmona a varování Neptuna, a vnitřní konflikty mezi hrdiny, jejich rodinami a králem Peliasem. Scény ukazují božské zásahy, jako je sestup Pallady a Juno, a napětí mezi osudem, strachem a odvahou. Cesta je předznamenána bouřemi, větry a božskými zákony, což vytváří atmosféru hrdinského eposu plnou osudu, božské vůle a překážek."},"c0002":{"cs":"Kniha 2 Argonautiky pokračuje v popisu plavby Argonautů po Středozemním moři, když se setkávají s přírodními i božskými překážkami. Při svém putování překonávají bouře, zemětřesení a zjevení zbytků obřů, kteří byli kdysi zničeni a proměněni v hory. Významný je výjev o boji Neptuna s Titanem Tyfóem, který je zatlačen do Sycilie a způsobuje zemětřesení. Na ostrově Lemnos se objevuje božský zásah Venuše, která způsobuje zmatek a touhu, a způsobuje tragické důsledky pro město. Příběh se soustředí na rituály, oběti, proroctví a osudové znamení, která ovlivňují cestu hrdinů. Zároveň se objevuje intenzivní scéna lásky mezi Hypsipyle a Jasonem, která je podporována bohem Amorem. Kniha ukazuje napětí mezi lidskou volbou a božským zásahem, když se hrdinové potýkají s osudem, strachem a povinností."},"c0003":{"cs":"Kniha 3 Argonautiky se zaměřuje na tragický osud krále Cyzika, který, zlákan závistí a touhou po bohatství, útočí na Argonauty. Božská vůle, zejména Jupiterra a Eriny, vedou k nevyhnutelnému střetu. Napjatá noční scéna, zvuky trubek a zjevení bohyně války Bellony vzbuzují strach. Bitva je popisována jako hrozivá a osudová, s mnoha smrtmi, včetně Hylase, mladého společníka Jasona. Po bitvě následuje hluboký smutek, pohřební rituály a základní otázky o osudu, smrti a posmrtném životě. Mopsus vysvětluje, že duše mrtvých musí projít zkouškami a zodpovídat za své činy. Argonauti se připravují na další cestu, přestože jsou zatíženi bolestí a nejistotou."},"c0004":{"cs":"Kniha 4 Argonautiky se zaměřuje na napětí a tragédii před bitvou mezi Argonauty a králem Amykem z Bebryků, známým svou krutostí a násilným režimem. Po výzvě k souboji se vynoří Pollux, syn Neptuna, jako osvoboditel, který porazí Amyka v rozhodujícím souboji. Vítězství znamená osvobození od násilí a zároveň ukazuje božský zásah, který podporuje spravedlnost. Po bitvě následuje oslava s obětmi, písněmi a obětováním bohům, kteří byli zavoláni k ochraně. Text zároveň zachycuje emocionální utrpení, osudové předzvěsti a výzvy k odvaze, které jsou typické pro hrdinský epos."},"c0005":{"cs":"Kniha 5 Argonautiky se soustředí na tragický okamžik smrti Idmona a Tiphysa, kteří zemřou během cesty. Jejich přátelé, včetně Mopsa, pláčou a modlí se k Apollonovi o záchranu. Jason se vydává do hrobu, kde se modlí a ztrácí v zoufalství. Přírodní síly reagují na jejich příchod – hory se rozpadají, řeky se odtrhávají, a na nebi se objeví ohnivý býk jako znamení. Argonauti přistávají na břehu Kolchidy, kde se setkávají s Medeou, která jim ukazuje cestu. Iuno a Pallas plánují božskou podporu, zatímco Aetés se připravuje na válku. Text spojuje rituál pohřbu, božské zásahy, osudové předzvěsti a přípravu na bitvu."},"c0006":{"cs":"Kniha 6 Argonautiky představuje vrcholnou bojovou scénu mezi Argonauty a vojskem Aetea, kdy se vynořuje napětí mezi hrdinským eposem a osudem. Zaznívá hlas boha Marsa, země a nebe se připravují na válku, zatímco božské síly, jako je Juno a Medea, ovlivňují průběh bitvy. Zároveň se objevují mytologické zjevení, magie, ztráty a tragické osudy bojovníků, včetně smrti Colaxese a zranění Iasona. Konec bitvy přináší zničení, ztrátu životů a osudové rozhodnutí, která ovlivní osud Argonautů a jejich cesty k zlatému rounu."},"c0007":{"cs":"Kapitola popisuje intenzivní duševní stav mladé ženy, která se v noci vrací k příběhu Argonautů a svému milenci Iasonovi. Její myšlenky jsou plné utrpení, strachu a ztráty, když se snaží pochopit, proč se její osud musí rozdělit od jeho cesty. Zároveň se objevuje její vnitřní konflikt mezi touhou po lásce a povinností před bohy a osudem. Božský zásah, zejména zásah Venuše a Circe, ovlivňuje její rozhodnutí, které se nakonec stává závěrem jejího utrpení – vzdát se milence, aby zachránila jeho osud. Scéna je plná symboliky, emocí a mytologického napětí."},"c0008":{"cs":"Kapitola 8 Argonautiky se soustředí na emocionální a božský zásah v okamžiku, kdy Medea, po zničení draka strážícího zlaté rouno, se ztrácí v úzkosti a pláče nad jeho osudem. Její modlitba k otci Aetovi a výčet ztráty způsobené jejím útěkem ukazují hluboký konflikt mezi rodinnou věrností a osobní touhou. Příběh pokračuje cestou přes řeku Hister, kde se Argonauti potýkají s novými přírodními překážkami a božskými výzvami. Konečně se připravují na nájezd Absyrtova vojska, což zvyšuje napětí a ukazuje, že jejich cesta je stále ohrožena. Tato kapitola je vrcholovým momentem vývoje Medeina osudu a jejího vztahu k Jasonovi."}}}