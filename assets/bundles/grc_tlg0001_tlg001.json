{"manifest":{"schemaVersion":"1.0","slug":"grc-tlg0001-tlg001","title":"Argonautika — Apollónios Rhodský","sourceLanguage":"grc","script":"greek","pipelineVersion":"pg-2+2af88a66","generatedAt":"2026-10-05T07:01:44Z","tree":{"id":"root","kind":"book","label":"Argonautika — Apollónios Rhodský","byteStart":0,"byteEnd":0,"children":[{"id":"c0001","kind":"chapter","label":"1 — Shromáždění hrdinů a příprava na výpravu Argonautů","byteStart":0,"byteEnd":0,"children":[]},{"id":"c0002","kind":"chapter","label":"2 — Souboje, rituály a mytické znamení na plavbě Argonautů","byteStart":0,"byteEnd":0,"children":[]},{"id":"c0003","kind":"chapter","label":"3 — Božská intrika a Medeiin osud","byteStart":0,"byteEnd":0,"children":[]},{"id":"c0004","kind":"chapter","label":"4 — Argonautové v Libyi a návrat do Řecka","byteStart":0,"byteEnd":0,"children":[]}]}},"words":{"nodes":{"root":{"terms":[{"term":"Argonautové","score":1.0,"count":70,"kind":"entity"},{"term":"Argonauti","score":0.89,"count":62,"kind":"entity"},{"term":"Argonautika","score":0.87,"count":61,"kind":"entity"},{"term":"Zeus","score":0.59,"count":41,"kind":"entity"},{"term":"plavba","score":0.57,"count":40,"kind":"word"},{"term":"Jason","score":0.53,"count":37,"kind":"entity"},{"term":"Medea","score":0.49,"count":24,"kind":"entity"},{"term":"Zlaté rouno","score":0.43,"count":30,"kind":"entity"},{"term":"Medeia","score":0.39,"count":19,"kind":"entity"},{"term":"Αἰήτης","score":0.31,"count":15,"kind":"orig"},{"term":"Aietes","score":0.3,"count":9,"kind":"entity"},{"term":"Aietos","score":0.3,"count":7,"kind":"entity"},{"term":"Aietés","score":0.3,"count":9,"kind":"entity"},{"term":"Amazónky","score":0.3,"count":6,"kind":"entity"},{"term":"Apollón","score":0.3,"count":19,"kind":"entity"},{"term":"Argo","score":0.3,"count":20,"kind":"entity"},{"term":"Argos","score":0.3,"count":11,"kind":"entity"},{"term":"Athéna","score":0.3,"count":15,"kind":"entity"},{"term":"Boreas","score":0.3,"count":8,"kind":"entity"},{"term":"Hekaté