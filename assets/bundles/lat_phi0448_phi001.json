nd":"orig"},{"term":"Commius","score":0.3,"count":5,"kind":"entity"},{"term":"Correo","score":0.3,"count":2,"kind":"orig"},{"term":"Correus","score":0.3,"count":4,"kind":"orig"},{"term":"Dumnaco","score":0.3,"count":2,"kind":"orig"},{"term":"Dumnacus","score":0.3,"count":3,"kind":"orig"},{"term":"Fabius","score":0.3,"count":3,"kind":"entity"},{"term":"Gaius Fabius","score":0.3,"count":5,"kind":"entity"},{"term":"Germáni","score":0.3,"count":7,"kind":"entity"},{"term":"Gálie","score":0.3,"count":5,"kind":"word"},{"term":"Julius Caesar","score":0.3,"count":8,"kind":"entity"},{"term":"Lucterius","score":0.3,"count":3,"kind":"orig"},{"term":"Marcus Antonius","score":0.3,"count":4,"kind":"entity"},{"term":"Pompeius","score":0.3,"count":3,"kind":"word"},{"term":"Trebonius","score":0.3,"count":3,"kind":"word"},{"term":"Vxellodunum","score":0.3,"count":3,"kind":"entity"},{"term":"bitva","score":0.3,"count":6,"kind":"word"},{"term":"frumenti","score":0.3,"count":3,"kind":"orig"},{"term":"galská válka","score":0.3,"count":6,"kind":"word"},{"term":"kořist","score":0.3,"count":3,"kind":"word"},{"term":"legio XIII","score":0.3,"count":3,"kind":"entity"},{"term":"legionem XIII","score":0.3,"count":3,"kind":"orig"},{"term":"legiones","score":0.3,"count":7,"kind":"orig"},{"term":"les","score":0.3,"count":3,"kind":"entity"},{"term":"obléhání","score":0.3,"count":5,"kind":"word"},{"term":"pronásledování","score":0.3,"count":5,"kind":"word"},{"term":"vojenská taktika","score":0.3,"count":3,"kind":"word"}]}}},"summaries":{"c0001":{"cs":"Caesar uvádí geografické a etnické rozdělení Galie na tři části, zdůrazňuje statečnost Belvů a plán Helvetiů na odchod z jejich území pod vedením Orgetorixe, který je později obviněn ze spiknutí a zemře. Přesto Helvetové pokračují v migraci, pálí svá sídla a snaží se projít římskou provincií, což Caesar zabraňuje opevněním a vyjednáváním. Následně se střetává s Helvetii v bitvě, vítězí a nařizuje návrat poražených kmenů. Poté se obrací k hrozbě Ariovista, germánského krále, který obsadil část Galie a vyžaduje podřízenost Haedů a dalších kmenů. Caesar se připravuje k vojenskému střetu, vyjednává, odmítá podvod a nakonec vítězí v bitvě u Vesontia, kde Ariovista poráží díky lepší taktice a disciplíně římských vojsk."},"c0002":{"cs":"Caesar zjišťuje spiknutí belgických kmenů proti Římu, vysílá průzkum a posily, poté táhne proti Belgům, získá poddajnost Remů, zmapuje sílu kmenů a vede rozhodnou bitvu proti Nerviům u řeky Sabis, kde po počátečním překvapení nakonec zvítězí díky taktické flexibilitě a morálce vojsk."},"c0003":{"cs":"Galové, přesvědčeni o své výhodě kvůli horskému terénu a slabosti římské legie, přepadnou římské jednotky v zimním táboře Octodurus. Po počátečním úspěchu jsou však odraženi díky statečnosti římských vojáků, výpadům a lepší organizaci obrany, což vede k jejich útěku a římskému vítězství."},"c0004":{"cs":"Usipetové a Tenkteři, germánské kmeny, překračují Rýn v zimě, protože jsou dlouhodobě tlačeni Sueby, kteří vedou neustálý válečný život, střídají se v boji a domácí práci, odmítají trvalé osídlení a zemědělství, žijí převážně z lovu a chovu dobytka, mají minimální oděv a silnou fyzickou odolnost, odmítají luxus jako víno a cizí koně, považují neobdělávanou půdu za známku síly."},"c0005":{"cs":"Caesar nařizuje stavbu lodí v Illyrii, postupuje proti Treverům a Dumnorixovi, poté se vydává do Británie, kde po počátečních úspěších čelí bouři a poškození flotily. V Galii mezitím vypukne povstání vedené Ambiorixem a Catuvolkem, které zasáhne zimní tábory a způsobí těžké ztráty římským jednotkám."},"c0006":{"cs":"Caesar očekává větší galské povstání a vysílá legáty pro nábor vojáků, zároveň žádá Pompeia o posily z Cisalpinské Gálie. Po porážce Indutiomara se šíří germánská vlivná činnost mezi galskými kmeny. Caesar zaznamenává přípravy války ze strany Nerviů, Aduatuků, Menapiů a jejich germánských spojenců, stejně jako neposlušnost Senonů a jejich komunikaci s Carnuty. Rozhodne se rychle zasáhnout proti Nerviům před zimou, porazí je, zabaví dobytek a lidi, zpustoší jejich území a donutí je k odevzdání rukojmí. Poté se stáhne do zimních táborů a přesune galickej koncil do Lutetie (Paříže), kde předpokládá, že Senoni, Carnuti a Treverové se neúčastnili kvůli své historické příslušnosti. Dále pokračuje tažení proti Senonům a Ambiorigovi, zajišťuje loajalitu Aeduů a připravuje se na přechod Rýna."},"c0007":{"cs":"Carnutes, po poradě v lesích, rozhodnou zahájit válku za svobodu Gálie, přísahou na vojenská znamení zavazují se k akci a útočí na Cenabum, kde zabíjejí římské obchodníky včetně Gai Fufia Citama; zpráva o činu se šíří hlasitým přenosem mezi vesnicemi až do Transalpské Gálie."},"c0008":{"cs":"Caesar, přinucen Balbovou výzvou, přijal úkol dokončit nedokončený komentář o válce galské, aby se vyhnul zdání lenosti a arogance, a zdůrazňuje vlastní neochotu a srovnává své dílo s předchozími komentáři, které považuje za méně dokonalé."}}}