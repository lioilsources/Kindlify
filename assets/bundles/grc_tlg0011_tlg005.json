ore":0.41,"count":2,"kind":"entity"},{"term":"Apollón","score":0.36,"count":1,"kind":"entity"},{"term":"hrob Agamemnona","score":0.36,"count":1,"kind":"entity"},{"term":"ἨΛΈΚΤΡΑ","score":0.34,"count":2,"kind":"orig"},{"term":"vražda","score":0.3,"count":1,"kind":"word"},{"term":"Αἴγισθος","score":0.3,"count":1,"kind":"orig"},{"term":"ὈΡΈΣΤΗΣ","score":0.3,"count":1,"kind":"orig"}]},"c0013":{"terms":[{"term":"Agamemnon","score":1.0,"count":2,"kind":"entity"},{"term":"Aigisthos","score":1.0,"count":3,"kind":"entity"},{"term":"Elektra","score":1.0,"count":2,"kind":"entity"},{"term":"Orestes","score":1.0,"count":3,"kind":"entity"},{"term":"brána","score":1.0,"count":1,"kind":"word"},{"term":"mrtvola","score":1.0,"count":1,"kind":"word"},{"term":"pomsta","score":1.0,"count":2,"kind":"word"},{"term":"pravda","score":1.0,"count":1,"kind":"word"},{"term":"Αἴγισθος","score":1.0,"count":3,"kind":"orig"},{"term":"Zeus","score":0.67,"count":2,"kind":"entity"},{"term":"smrt","score":0.67,"count":2,"kind":"word"},{"term":"vražda","score":0.67,"count":2,"kind":"word"},{"term":"Argos","score":0.58,"count":1,"kind":"entity"},{"term":"Fókida","score":0.58,"count":1,"kind":"entity"},{"term":"Mykené","score":0.58,"count":1,"kind":"entity"},{"term":"brány","score":0.58,"count":1,"kind":"word"},{"term":"rod Atreovců","score":0.58,"count":1,"kind":"entity"},{"term":"svoboda","score":0.58,"count":1,"kind":"word"},{"term":"Ζεῦ","score":0.58,"count":1,"kind":"orig"},{"term":"δίκην","score":0.58,"count":1,"kind":"orig"},{"term":"θάνῃς","score":0.58,"count":1,"kind":"orig"},{"term":"κτείνειν","score":0.58,"count":1,"kind":"orig"},{"term":"λελοιπόθʼ","score":0.58,"count":1,"kind":"orig"},{"term":"μὲν οὐ","score":0.58,"count":1,"kind":"orig"},{"term":"ξένοι","score":0.58,"count":1,"kind":"orig"},{"term":"οὐ λέγω","score":0.58,"count":1,"kind":"orig"},{"term":"πανοῦργον","score":0.58,"count":1,"kind":"orig"},{"term":"σπέρμʼ Ἀτρέως","score":0.58,"count":1,"kind":"orig"},{"term":"ἀγγεῖλαι","score":0.58,"count":1,"kind":"orig"},{"term":"ὈΡΈΣΤΗΣ","score":0.52,"count":2,"kind":"orig"},{"term":"zpráva","score":0.48,"count":1,"kind":"word"},{"term":"Φωκῆς","score":0.48,"count":1,"kind":"orig"},{"term":"βίον","score":0.48,"count":1,"kind":"orig"},{"term":"θρήνων","score":0.48,"count":1,"kind":"orig"},{"term":"πατέρα","score":0.48,"count":1,"kind":"orig"},{"term":"Ὀρέστην","score":0.48,"count":1,"kind":"orig"},{"term":"ΚΛΥΤΑΙΜΝΉΣΤΡΑ","score":0.42,"count":1,"kind":"orig"},{"term":"ἨΛΈΚΤΡΑ","score":0.4,"count":2,"kind":"orig"},{"term":"božská spravedlnost","score":0.33,"count":1,"kind":"word"},{"term":"Klytaimnestra","score":0.3,"count":1,"kind":"entity"},{"term":"Sbor","score":0.3,"count":1,"kind":"entity"}]}}},"summaries":{"c0001":{"cs":"V úvodní epizodě tragédie Élektra se Orestes vrací do Argu pod falešnou identitou a poradí se svým pedagogem o tom, jak splnit boží příkaz k pomstě za vraždu svého otce Agamemnona. Elektra, přítomna na scéně, vyjadřuje svůj žal a touhu po spravedlnosti, zatímco Orestes připravuje plán na vraždu Klytaimnéstry a Aigistha. Pedagog zdůrazňuje nutnost rituální očisty před činem podle Apollónova orákula."},"c0002":{"cs":"Elektra vyjadřuje hluboký zármutek nad smrtí svého otce Agamemnona, kterého zabila její matka Klytaimnéstra s Aigisthosem, a brání své pláč jako spravedlivou reakci. Sbor ji nejprve kritizuje kvůli nadměrnému truchlení, poté ji povzbuzuje vírou v Dia a čas jako léčivou sílu, zatímco připomíná osud rodiny a naději na návrat Oresta. Elektra zdůrazňuje svou osamělost, bezdětnost a nekonečný žal, zatímco sbor varuje před následky zoufalství a volá po rozumu."},"c0003":{"cs":"Elektra naléhá na pomstu za vraždu svého otce Agamemnona matkou Klytaimnéstrou a Aigisthosem, zatímco Chrysothemis varuje před následky násilí a doporučuje poslušnost a tichý život. Jejich spor odhaluje hluboký rozkol v pohledu na spravedlnost, povinnost a rodinnou věrnost."},"c0004":{"cs":"Chorus Sophoklovy Élektry v čtvrtém chóru vyjadřuje víru v nevyhnutelný příchod božské spravedlnosti prostřednictvím Erinýn, které stíhají vrahy Agamemnona. Odkazuje na rodovou kletbu Atridů a kontrastuje ji s dřívější hrdinskou slávou Pelopa, jejíž síla a činy kdysi požehnaly tuto zemi, zatímco nyní je dům pustošen násilím a zločinem."},"c0005":{"cs":"Elektra reaguje na zprávu o smrti svého bratra Oresta hlubokým zármutkem a cítí se opuštěná, nucená sloužit nepřátelům své rodiny. V hádce s matkou Klytaimnéstrou obhajuje své jednání jako nutnou reakci na matčiny zločiny a odvolává se na božskou spravedlnost, zatímco matka se brání a odkazuje na sílu času a osudu."},"c0006":{"cs":"V tomto chórovém úryvku Elektra vyjadřuje hluboký zármutek nad smrtí svého otce Agamemnona a pochybnosti o tom, zda jeho duše našla klid v podsvětí. Sbor reaguje pokusy o útěchu, ale Elektra zůstává v zoufalství, zdrcená pocitem, že otec nenachází pokoj a že její rodina je stižena prokletím."},"c0007":{"cs":"Elektra a Chrysothemis rozebírají znamení, která by mohla naznačovat přítomnost Oresta a božskou podporu pro pomstu. Chrysothemis popisuje vidění svatého pramene a květin u otcova hrobu, zatímco Elektra zůstává skeptická a ptá se na zdroj naděje. Nalezne však vlasovou část na hrobu, kterou považuje za důkaz Orestaovy přítomnosti a vykonané pomsty. Diskuse se stočí k otázce, zda mají jednat proti matce Klytaimnéstře a Aigisthovi, přičemž Elektra naléhá na akci a Chrysothemis vyjadřuje strach, ale nakonec naznačuje ochotu pomoci, pokud se připojí k plánu."},"c0008":{"cs":"Chór se ptá, proč lidé nejednají spravedlivě i přes znamení od bohů jako Zeus a Themis, a lamentuje nad osudem Elektry, která oplakává svého otce Agamemnona a čeká na pomstu, zatímco božská spravedlnost zůstává nejasná."},"c0009":{"cs":"Elektra vyjadřuje hluboký zármutek nad ztrátou bratra Oresta a žádá o jeho pozůstatky, aby mohla provést pohřební rituál. Orestes, přestrojený za cizince, jí předává údajné ostatky a postupně ji přesvědčuje o své živé identii pomocí důkazů, jako je otcův pečeť, což vede k jejich emocionálnímu setkání a uznání."},"c0010":{"cs":"Elektra vítá svého bratra Oresta po dlouhém odloučení s hlubokou úlevou a emocionální intenzitou, zatímco Orestes ji napomíná k opatrnosti kvůli nebezpečí odhalení nepřáteli v domě. Jejich dialog osciluje mezi radostí ze setkání a strachem z prozrazení jejich plánu pomsty."},"c0011":{"cs":"Elektra nejprve Oresta nepoznává, domnívá se, že je cizinec. Po výměně slov o jejich otci Agamemnonovi a jeho smrti, vzpomínkách na minulost a Oresteho náznaku, že byl v Fókidě pod její péčí, jej konečně poznává. Vybuchne v radostném výkřiku, objímá ho a děkuje bohům za jeho návrat, zatímco Pedagog napomáhá jejich plánu vstoupit do paláce nepozorováni."},"c0012":{"cs":"Sbor popisuje příchod vraha Aigistha do paláce jako nebezpečného vlka v noci, zatímco Elektra připravuje oběť u hrobu Agamemnona a varuje před jeho příchodem. Klytaimnéstra se zmateně ptá na dění v domě, Elektra slyší vnitřní hlas a připravuje se na konfrontaci. Sbor lamentuje nad osudem rodu a volá po spravedlnosti, zatímco Orestes se připravuje k činu."},"c0013":{"cs":"Aigisthos se ptá na osud fókských cizinců, kteří měli oznámit Orestovu smrt; Elektra potvrzuje, že jsou uvnitř a přinesli důkaz. Aigisthos nařizuje otevřít brány, aby všichni viděli mrtvé tělo toho, kdo měl přinést naději. Orestes se objevuje, konfrontuje Aigisthoa s jeho vinou, odmítá jeho výmluvy a připravuje se na jeho zabití. Elektra naléhá na rychlou akci, zatímco sbor komentuje osud rodu Atreovců a jejich utrpení v boji za svobodu."}}}