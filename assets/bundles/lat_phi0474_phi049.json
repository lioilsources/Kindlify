ore":0.3,"count":4,"kind":"orig"},{"term":"beatus","score":0.3,"count":7,"kind":"orig"},{"term":"blaženost","score":0.3,"count":8,"kind":"word"},{"term":"bohatství","score":0.3,"count":7,"kind":"word"},{"term":"bolest","score":0.3,"count":9,"kind":"word"},{"term":"bona","score":0.3,"count":5,"kind":"orig"},{"term":"bonorum","score":0.3,"count":3,"kind":"orig"},{"term":"divitias","score":0.3,"count":3,"kind":"orig"},{"term":"dobro","score":0.3,"count":12,"kind":"word"},{"term":"duše","score":0.3,"count":8,"kind":"word"},{"term":"exil","score":0.3,"count":3,"kind":"word"},{"term":"filosofie","score":0.3,"count":14,"kind":"word"},{"term":"natura","score":0.3,"count":6,"kind":"orig"},{"term":"philosophi","score":0.3,"count":6,"kind":"orig"},{"term":"poznání","score":0.3,"count":4,"kind":"word"},{"term":"rozkoš","score":0.3,"count":5,"kind":"word"},{"term":"skromnost","score":0.3,"count":4,"kind":"word"},{"term":"stoicismus","score":0.3,"count":9,"kind":"word"},{"term":"strach","score":0.3,"count":8,"kind":"word"},{"term":"utrpení","score":0.3,"count":7,"kind":"word"},{"term":"virtus","score":0.3,"count":10,"kind":"orig"},{"term":"virtutem","score":0.3,"count":5,"kind":"orig"},{"term":"voluptatem","score":0.3,"count":5,"kind":"orig"},{"term":"zdraví","score":0.3,"count":4,"kind":"word"},{"term":"šťastný život","score":0.3,"count":9,"kind":"word"}]},"c0007":{"terms":[{"term":"Cicero","score":1.0,"count":1,"kind":"entity"},{"term":"Tuskulské hovory","score":1.0,"count":1,"kind":"entity"},{"term":"contractio","score":1.0,"count":1,"kind":"orig"},{"term":"conturbatio","score":1.0,"count":1,"kind":"orig"},{"term":"conveniens","score":1.0,"count":1,"kind":"orig"},{"term":"deus mens soluta et libera","score":1.0,"count":1,"kind":"entity"},{"term":"filosofické pojmy","score":1.0,"count":1,"kind":"word"},{"term":"filozofické pojmy","score":1.0,"count":1,"kind":"word"},{"term":"hesla","score":1.0,"count":1,"kind":"word"},{"term":"in contrarias partes disserere","score":1.0,"count":1,"kind":"orig"},{"term":"index","score":1.0,"count":1,"kind":"word"},{"term":"mytologie","score":1.0,"count":1,"kind":"word"},{"term":"místa","score":1.0,"count":1,"kind":"word"},{"term":"odkazy","score":1.0,"count":1,"kind":"word"},{"term":"osoby","score":1.0,"count":1,"kind":"word"},{"term":"rejstřík","score":1.0,"count":1,"kind":"word"},{"term":"sunh/qeia","score":1.0,"count":1,"kind":"orig"},{"term":"contentio","score":0.8,"count":1,"kind":"orig"},{"term":"contentus","score":0.8,"count":1,"kind":"orig"},{"term":"contractiuncula","score":0.8,"count":1,"kind":"orig"},{"term":"cupiditas","score":0.8,"count":1,"kind":"orig"},{"term":"latinská terminologie","score":0.8,"count":1,"kind":"word"}]}}},"summaries":{"root":{"cs":"Tusculánské hovory jsou Ciceronovým filosofickým dílem z období před rokem 44 př. n. l., složeným z pěti knih (plus předmluva), které systematicky zkoumají podmínky šťastného a ctnostného života. Cicero v nich argumentuje, že pravé štěstí nezávisí na vnějších okolnostech ani smyslovém požitku, ale na vnitřní ctnosti, rozumu a správném soudění. Zabývá se překonáním strachu ze smrti, léčením duševních poruch prostřednictvím filozofie, roli rozumu při zvládání bolesti a tvrzením, že moudrý člověk může být šťasten i bez smyslů (jako zrak či sluch) díky vnitřním rozkoším ducha. Dílo navazuje na jeho spisy O konci dobra a zla a O povaze bohů a mělo významný vliv jak v antickém, tak středověkém filozofickém a vzdělávacím kontextu, včetně mnoha rukopisných tradic a redakčních variant."},"c0001":{"cs":"V předmluvě k Tusculánským hovorům Cicero sám potvrzuje autorství a vydání těchto pěti knih, které považuje za nezbytné pro šťastný život. První kniha řeší překonání smrti, druhá snášením bolesti, třetí utišováním trápení, čtvrtá zvládání dalších duševních rozrušení a pátá pojednává o tom, že ctnost sama o sobě stačí k blaženému životu – tím osvětluje celou filosofii. Tyto spisy navazují na jeho dřívější práce O konci dobra a zla a předcházejí pracím O povaze bohů, což vyplývá z jeho korespondence s Attikem z roku 45 př. n. l., kde žádá o Dichaearhovy texty o nesmrtelnosti duše. Ačkoli přesné dokončení není známé, předmluva naznačuje, že spisy byly hotové před rokem 44 př. n. l., kdy Cicero Attikovi píše, že první Tusculánská hovory ho potěšily. Dále popisuje, jak byly spisy přijímány erudovanými Římany a později křesťanskými autory jako Lactantius a Augustin, zatímco v raném středověci upadly v zapomnění, aby je znovuobjevili humanisticky orientovaní učenci. Text se také zabývá podrobnou filologickou analýzou rukopisné tradice: popisuje různé kodexy (G, K, R, V, H), jejich fyzickou podobu, opravy provedené různými korektory (G2, V1, Vc apod.), varianty v psaní, interpunkci, dělení textu na části a redakční postupy, včetně diskuzí o archetypu X a možné druhé tradici Y. Zmiňuje se také o kritických zásadách při sestavování vydání, kdy se preferuje konsensus rukopisů, ale s opatrností při přijímání jedinečných oprav vzdělaných jednotlivců, pokud jsou odůvodněné."},"c0002":{"cs":"V první knize Tuskulských hovorů Cicero rozvíjí filozofickou úvahu o smrti, jejím významu a vztahu k lidské duši. Argumentuje, že smrt není zlem, protože zemřelí již neexistují a nemohou být nešťastní, protože neštěstí předpokládá existenci. Zdůrazňuje nesmrtelnost duše, její pohyb směrem k nebi podle své povahy a její přirozenou věčnost. Kritizuje strach z posmrtného života a mylné představy o trestech v podsvětí. Filozofie je pro něj zdroj osvobození od strachu, touhy a smutku – jejím nejplodnějším ovocem. Zároveň obhajuje přirozenost smrti jako přechodu k lepšímu stavu, podobně jako Sókratův příklad."},"c0003":{"cs":"Cicero obhajuje hodnotu filozofického vzdělávání i pro osoby zapojené do veřejného života, jako je Brutus, a tvrdí, že i omezené poznání filosofie může přinést útěchu od strachu ze smrti, zvláště když člověk uzná, že smrt sama o sobě není děsivá. Filosofie podle něj medituje duši, odstraňuje marné starosti, osvobozuje od touhy a zahání strach. Tato síla však není rovnoměrná u všech – záleží na přirozenosti jednotlivce. Pravá fortitude není v tom, že člověk nezná bolest, ale že ji snáší s rozumem a ctností, aniž by podléhal nářekům. Cicero kritizuje ty, kteří hlásají moudrost, ale nežijí podle ní, a považuje takový rozpor za hanebnější než chybu řemeslníka. Dále rozebírá povahu bolesti (dolor) jakožto nejvyššího zla, odmítá epikurejský a stoický pohled, že bolest není zlo, a argumentuje, že skutečné zlo leží v morální nečestnosti (turpitudo), nikoli v fyzickém utrpení. Ctnost (virtus) se projevuje právě v tom, že člověk neustoupí před bolestí, pokud je v souladu s čestností, důstojností a slávou. Zdůrazňuje také rozdíl mezi laborare (pracovat) a dolere (trpět), přičemž zvyk na práci může zmírnit vnímání bolesti. Skutečná statečnost a vytrvalost v utrpení nejsou dány fyzickou odolností, ale racionálním a moudrým přístupem vycházejícím z vnitřní ctnosti a rozumu."},"c0004":{"cs":"Cicero v knize 3 Tuskulských hovorů kritizuje nerovnováhu v péči o tělo a duši: zatímco lékařství je rozvinuto a božsky ctěno, léčení duše je zanedbáváno, i když duše je podstatnější. Ukazuje, že lidé soudí o duši pomocí nemocné duše samotné, což vede k chybám. Duševní nemoci jako strach, touha, smutek či hněv jsou těžší než tělesné neduhy a vznikají z názoru na zlo (bonum/malum), nikoli z přirozené příčiny. Filosofie je pravá léčba duše, protože působí zevnitř – na rozdíl od vnějších léků – a vede k zdraví prostřednictvím ctnosti, rozumu a umírněnosti. Cicero rozlišuje čtyři druhy duševních poruch podle toho, zda pocházejí z názoru na dobro nebo zlo a zda se týkají přítomnosti nebo budoucnosti. Zdůrazňuje, že moudrý člověk (sapiens) není postižen duševní nemocí, protože jeho rozum je neporušený a jeho vůle pevná. Pravá blaženost není v tělesném potěšení, ale v ctnosti, absenci bolesti a vnitřním klidu. Zmíněny jsou také kritiky epikurejského pojetí štěstí a diskuze o tom, že utrpení často plyne z chybného úsudku, nikoli ze samotné události, a že pravá útěcha spočívá v přehodnocení názorů, nikoli ve vnějších okolnostech."},"c0005":{"cs":"Cicero v této kapitole zkoumá vliv řecké filozofie, zejména pythagorejského učení, na římské vzdělání a společenský řád. Zdůrazňuje, že i když římské instituce byly původně založeny na božském právu a vojenské organizaci, později se rozvinuly díky přijetí řecké moudrosti. Spekuluje o tom, že král Numa mohl být považován za pythagorejského žáka kvůli své moudrosti. Popisuje starověké zvyky, jako byly písně na ctnosti při hostinách, a ukazuje, že tyto tradice byly zakotveny v zákoně a měly morální význam. Zároveň diskutuje o příčinách lidských trpkostí – aegritudine, metu, laetitii a libido –, které vznikají z nesprávných názorů a volních rozhodnutí. Filozofie, zejména stoická, nabízí cestu k osvobození těchto trpkostí prostřednictvím logiky a rozumu."},"c0006":{"cs":"Cicero zkoumá, zda může být moudrý člověk šťasten i bez smyslů, jako je zrak nebo sluch, a argumentuje, že skutečné štěstí pochází z vnitřních rozkoší ducha, nikoli ze smyslového vnímání. Uvádí příklady slepých filozofů jako Epikura, Diodota Stoika a Demokrita, kteří dosáhli moudrosti a klidu i bez zraku, protože jejich rozum a úvahy byly dostatečné pro blaho. Rozlišuje mezi smyslovými potěšením (která závisí na orgánech) a duševními rozkošemi (které jsou přístupné i bez smyslů, např. prostřednictvím úvahy, paměti nebo filozofické kontemplace). Zmiňuje, že i hluchí mohou najít potěšení ve vnitřním mluvení nebo v představách, a že skuteční mudrci jsou šťastni díky ctnosti a rozumu, nikoli díky vnějšímu štěstí nebo smyslovému požitku. Závěrem konstatuje, že moudrý člověk je šťasten stále, protože jeho blaho nezávisí na náhodných vnějších okolnostech, ale na vnitřní harmonii duše. Tato úvaha je součástí širší diskuse v knize 5 Tusculánských hovorů, kde Cicero s přáteli zkoumá podstatu štěstí, ctnosti, moudrosti a jejich vztahu k vnějšímu utrpení, bohatství, slávě či tělesným nedostatkům. Opakovaně zdůrazňuje, že pravé blaho (beata vita) není závislé na vnějších statcích, ale na ctnosti, rozumu a vnitřním klidu duše, které zůstávají nedotčeny i v případě utrpení, chudoby, nemoci či vyhnanství. Kritizuje názory, které spojují štěstí s tělesným požitkem, bohatstvím nebo slávou, a naopak vyzdvihuje filozofický život, sebevlastnost a nezávislost na vnějších okolnostech jako cestu k skutečnému štěstí. Diskuse se dotýká také rolí řeči, přátelství, filozofické tradice a příklady moudrých mužů z minulosti, kteří dosáhli blaženosti prostřednictvím rozumu a ctnosti, nikoli smyslů nebo vnějšího štěstí."},"c0007":{"cs":"Kapitola představuje věcný rejstřík (index) z Ciceronových Tuskulských hovorů, abecedně uspořádaný a obsahující odkazy na konkrétní stránky, oddíly nebo verše. Zahrnuje jména osob (např. Sókratés, Scipio, Iulius Caesar), míst (např. Karthago, Lacedaemon), mytologických postav (např. Iphigenie, Médéa), děl (např. Euripides, Platónovy dialogy) a filozofických pojmů (např. voluntas, voluptas, iudicium, apatheia). Rejstřík slouží jako nástroj pro orientaci v textu a uvádí související koncepty, jako jsou ctnost, smrt, duše, emoce, rozum a jejich vztah k různým filozofickým školám. Je doplněn o odkazy na kritická vydání, jako je vydání u B. G. Teubnera."}}}