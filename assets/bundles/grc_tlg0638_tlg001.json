:3,"kind":"orig"},{"term":"βασιλεύς","score":0.3,"count":5,"kind":"orig"},{"term":"βασιλεῖ","score":0.3,"count":3,"kind":"orig"},{"term":"νοῦν","score":0.3,"count":3,"kind":"orig"},{"term":"ἀποθνήσκειν","score":0.3,"count":3,"kind":"orig"},{"term":"ἀπολογίαν","score":0.3,"count":3,"kind":"orig"}]},"c0008":{"terms":[{"term":"duše","score":1.0,"count":8,"kind":"word"},{"term":"filozofická obrana","score":1.0,"count":1,"kind":"word"},{"term":"moudrost","score":1.0,"count":18,"kind":"word"},{"term":"osud","score":1.0,"count":9,"kind":"word"},{"term":"soudní proces","score":1.0,"count":2,"kind":"word"},{"term":"smrt","score":0.83,"count":10,"kind":"word"},{"term":"Apollónios z Tyany","score":0.78,"count":14,"kind":"entity"},{"term":"filozofie","score":0.78,"count":14,"kind":"word"},{"term":"Ἀπολλώνιος","score":0.67,"count":12,"kind":"orig"},{"term":"βασιλεῦ","score":0.6,"count":9,"kind":"orig"},{"term":"pravda","score":0.54,"count":9,"kind":"word"},{"term":"vláda","score":0.5,"count":9,"kind":"word"},{"term":"ψυχῆς","score":0.5,"count":6,"kind":"orig"},{"term":"Efes","score":0.48,"count":5,"kind":"entity"},{"term":"δίκη","score":0.48,"count":5,"kind":"orig"},{"term":"τύραννος","score":0.45,"count":4,"kind":"orig"},{"term":"spravedlnost","score":0.44,"count":8,"kind":"word"},{"term":"Trofónios","score":0.42,"count":3,"kind":"entity"},{"term":"král","score":0.42,"count":7,"kind":"entity"},{"term":"δικαστηρίῳ","score":0.42,"count":3,"kind":"orig"},{"term":"σῶμα","score":0.42,"count":5,"kind":"orig"},{"term":"věštba","score":0.4,"count":6,"kind":"word"},{"term":"Apollónios z Tyané","score":0.39,"count":7,"kind":"entity"},{"term":"vědomí","score":0.39,"count":7,"kind":"word"},{"term":"γόης","score":0.34,"count":3,"kind":"orig"},{"term":"rituál","score":0.33,"count":6,"kind":"word"},{"term":"Δία","score":0.33,"count":4,"kind":"orig"},{"term":"Δημήτριος","score":0.33,"count":4,"kind":"orig"},{"term":"λόγος","score":0.33,"count":4,"kind":"orig"},{"term":"Ἀπολλώνιον","score":0.33,"count":6,"kind":"orig"},{"term":"Aulida","score":0.3,"count":2,"kind":"entity"},{"term":"Panathenaia","score":0.3,"count":2,"kind":"entity"},{"term":"Peloponnés","score":0.3,"count":2,"kind":"entity"},{"term":"božská pověst","score":0.3,"count":2,"kind":"word"},{"term":"neznášitelnost","score":0.3,"count":2,"kind":"word"},{"term":"nezávislost","score":0.3,"count":3,"kind":"word"},{"term":"prorocké poznání","score":0.3,"count":2,"kind":"word"},{"term":"soudní řeč","score":0.3,"count":2,"kind":"word"},{"term":"tyrán","score":0.3,"count":2,"kind":"entity"},{"term":"čaroděj","score":0.3,"count":2,"kind":"word"},{"term":"Αὐλίδα","score":0.3,"count":2,"kind":"orig"},{"term":"Δίας","score":0.3,"count":4,"kind":"entity"},{"term":"Μοίραι","score":0.3,"count":2,"kind":"orig"},{"term":"Οὐεσπασιανὸς","score":0.3,"count":2,"kind":"orig"},{"term":"Παναθηναίοις","score":0.3,"count":2,"kind":"orig"},{"term":"Τροφώνιον","score":0.3,"count":2,"kind":"orig"},{"term":"αἷμα","score":0.3,"count":4,"kind":"orig"},{"term":"γηλόφῳ","score":0.3,"count":2,"kind":"orig"},{"term":"δίκῃ","score":0.3,"count":2,"kind":"orig"},{"term":"ζῷα","score":0.3,"count":2,"kind":"orig"}]}}},"summaries":{"root":{"cs":"Dílo je životopisným a filozofickým eposem o Apollóniovi z Týany, který cestuje z Týany přes Indie, Babylon, Řím a Aethiopii. Obsahuje příběhy o náboženských zjeveních, filozofických dialogech, rituálech, proroctví a odporu proti tyraniím. Zdůrazňuje vnitřní svobodu, spravedlnost, moudrost a nezničitelnost duše. Je založeno na starořeckém originálu, knihovna má překlad. Dílo slouží jako etická a metafyzická reflexe o lidském životě, vztahu člověka k bohu a osudu."},"c0001":{"cs":"První kniha díla popisuje cestu Apollónia z Týany do Babylonu, kde se setkává s různými lidmi, náboženskými tradicemi a mágovými. Po návštěvě Eretrejců, přeživších exilu z Euboeje, získává od satrapa potraviny a setkává se s mágovými, kteří se mu zdají být záhadní. V Babylonu je přijat s úctou, ale odmítá představit se jako národní zástupce a nechce přijmout královské dary. Vysvětluje, že jeho cíl je neziskový a založený na filozofii. Žádá o ochranu Eretrejců a jejich půdy, což král souhlasí. Apollónios pokračuje dál, přičemž se setkává s mágovými, kteří se mu zdají být mimořádní. Všechny události jsou zaznamenány jako důkaz jeho moudrosti, nezávislosti a vnitřní síly."},"c0002":{"cs":"Kapitola představuje detailní popis cesty Apollónia z Tyané přes Kavkáz a Indie, kde se střetává s mýty o božských postavách, jako je Prométheus, Heraklés a Dionýsos, a s přírodními zjeveními, jako je strom syrového kouře nebo zázračný parda. Zahrnuje setkání s Indiány, rituály, oběti a věštby, včetně významu vína, spánku a snů. Filozofické dialogy se zabývají moudrostí, spravedlností, vlastnictvím, přirozeností zvířat a významem umění. Apollónios se projevuje jako moudrý vůdce, který překonává strach, odmítá luxus a udržuje vnitřní jednotu, přičemž jeho cesta je jak fyzická, tak duchovní. Zároveň se objevují kritiky opilosti, zneužívání moci a závislosti na materiálu, a zdůrazňuje se, že pravá pravda a spravedlnost jsou výsledkem čisté duše a morálního života."},"c0003":{"cs":"Kniha 3 Philostrata zachycuje Apollóniovo setkání s indickými moudrými muži, jejich náboženské a filozofické tradice, zvláštní způsob života bráchmanů žijících v harmonii s přírodou a bez majetku, a jejich rituály spojené s věštěním, oběťmi a modlitbami. Popisuje zázračné přírodní jevy – modré studny, nekonečné víno, zlaté draky, fénix, zázračné rostliny a zvířata – a mýtické bytosti, které symbolizují přírodní a duchovní síly. Zároveň se zabývá kosmologií, metafyzikou, osudem, spravedlností a vnitřním poznáním, kde Apollónios vystupuje jako moudrý učitel, který předává tajemství o bytí, duši a jednotě s bohem Sluncem. Dialogy s králem a moudrými muži ilustrují význam ctnosti, nezávislosti a pravé moudrosti nad královskou mocí."},"c0004":{"cs":"Kapitola popisuje Apollóniova významného působení v Římě za vlády Nérona, kdy se stává centrem filozofického a náboženského zájmu. Předpovídá přírodní katastrofy, jako je zatmění slunce, a jeho slova se potvrzují v reálu. Zázračně uzdravuje dívku, která se zdála být mrtvá, což připomíná vzkříšení Alkestis. Vystupuje proti morálnímu rozpadu, kritizuje zábavy a zneužívání vědy, a přestože je pronásledován, zůstává klidný a odvážný. Jeho přítomnost je považována za božské světlo, které prozrazuje pravdu. Zároveň se zabývá tématy smrti, odpovědnosti, věrnosti a vztahu mezi bohy a lidmi, přičemž vysvětluje, že pravda pochází z moudrosti, ne z mágie. Je přijímán i vysokými osobami, i když se vystavuje nebezpečí."},"c0005":{"cs":"Kniha 5 se soustředí na vztah mezi Apollóniem z Tyané a králem, který se stává jeho učitelem a prorokem. Apollónios vysvětluje základy spravedlivého vládnutí, kritizuje tyranské chování Nérona, Galby a Otho, a předpovídá jejich pád jako důsledek morálního zhroutení. Zároveň se zabývá přírodními zjevy, jako je tok Okeánu nebo erupce Etny, a jejich mytologickým výkladem. Významná je i jeho kritika zneužívání svatyní, obětí a umění pro komerční účely. Apollónios odmítá politickou moc, i když je vyzýván k účasti, a zdůrazňuje, že pravá spravedlnost vychází z vnitřní ctnosti a filozofického života."},"c0006":{"cs":"Kniha 6 představuje rozsáhlou cestu Apollónia z Tyané do Aethiopie a Egypta, kde se setkává s různými lidmi, zvířaty, přírodními úkazy a místními náboženskými praktikami. Zaznamenává jeho setkání s moudrými Gymny, kteří žijí v náboženském a filozofickém sebeovládání, a s místními obyvateli, kteří se věnují rituálům, obětování a věštění. Apollónios kritizuje povrchní náboženství, zbytečné oběti a nesmyslné způsoby chování, zatímco zastává hodnoty spravedlnosti, čistoty, vnitřního poznání a vědomého života. Jeho přítomnost má zázračný a osvobozující vliv, ačkoli se vyhýbá zjevným zázrakům. Kniha prokazuje, že pravá moudrost je vnitřní, spočívá v poznání pravdy a v souladu s přírodou a božstvím."},"c0007":{"cs":"Kapitola se soustředí na odpor filozofů proti tyraniím, především skrze příběhy Apollónia z Týanu, Platóna, Zénóna z Eleje a jiných, kteří se postavili proti násilnému vládnutí. Zdůrazňuje, že filozofická pravda a morální odvaha jsou vyzkoušeny právě v době tyranie. Apollónios se vystavuje nebezpečí, odmítá se podřídit císaři, a přestože je obviněn z čarodějnictví a zradných činů, zachovává klid a vnitřní svobodu. Kritizuje zneužívání moci, násilí a nezákonné soudní procesy, a vysvětluje, že pravá moudrost spočívá v přijetí osudu, věrnosti pravdě a odvaze i před smrtí. Zároveň se zabývá tématy vztahu mezi rozumem a poznáním, vnitřním zrcadlem duše, náboženskou čistotou a významem filozofického života jako způsobu osvobození od tělesných a společenských věznic."},"c0008":{"cs":"Kapitola 8 zachycuje soudní proces Apollónia z Tyany, který je obviněn z čarodějnictví a vlivu na lidi. Apollónios se brání nejen proti obviněním, ale vede hlubokou filozofickou diskusi o spravedlnosti, moudrosti, vztahu mezi člověkem a bohem a o přirozenosti duše. Jeho obrana je založena na etice, vnitřní čistotě a přesvědčení o nezničitelnosti duše. Proces se proměňuje v metaforu vnitřního soudního jednání duše, kde se ukazuje, že pravá moudrost spočívá v odmítnutí násilí, obětí a politického vlivu. Apollónios se vyhýbá povrchnímu způsobu řeči a upřesňuje, že pravá filozofie je v souladu s božským řádem vesmíru. Kapitola zároveň obsahuje refleze o osudu, smrti, přírodních zákonech a významu prorockého poznání, což vše vystihuje jeho unikátní postavení mezi lidmi a bohy."}}}